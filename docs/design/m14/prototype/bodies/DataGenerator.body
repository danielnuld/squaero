Generar datos
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Generar datos · clientes — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="clientes" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <header style="height: 56px; flex: none; display: flex; align-items: center; gap: 16px; padding: 0 24px; border-bottom: 1px solid var(--border)">
        <div style="min-width: 0">
          <h1 style="margin: 0; font-size: var(--fs-lg); font-weight: 600">Generar datos · clientes</h1>
          <div style="font-size: var(--fs-sm); color: var(--text-dim)">Inserta filas de prueba en la tabla · Ventas</div>
        </div>
        <span style="flex: 1"></span>
        <ol aria-label="Pasos del asistente" style="list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 10px; font-size: var(--fs-md)"><li aria-current="step" style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; background: var(--accent); color: var(--accent-fg)">1</span><span style="color: var(--text); font-weight: 600">Configurar</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; border: 1px solid var(--border-strong); color: var(--text-dim)">2</span><span style="color: var(--text-dim)">Resultado</span></li></ol>
      </header>
      <div style="flex: 1; min-height: 0; overflow: auto; padding: 18px 32px; display: flex; flex-direction: column; gap: 16px">
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <label for="nrows" style="padding-top: 5px; color: var(--text-dim)">Número de filas</label>
            <div style="max-width: 360px"><input id="nrows" class="field" value="10" style="width: 120px; font-variant-numeric: tabular-nums"><div class="help" style="margin-top: 4px">Hasta 10000 filas por tanda, en una transacción.</div></div>
          </div>
        <section style="display: flex; flex-direction: column; gap: 8px">
          <h2 class="lbl" style="margin: 0; font-size: var(--fs-sm)">Estrategia por columna</h2>
          <div role="table" aria-label="Estrategia por columna" style="border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden">
          <div role="row" style="display: grid; grid-template-columns: 140px 120px 210px 1fr; align-items: center; height: 30px; padding: 0 12px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm); font-weight: 600"><span>Columna</span><span>Tipo</span><span>Estrategia</span><span>Parámetros</span></div>
          <div role="row" style="display: grid; grid-template-columns: 140px 120px 210px 1fr; align-items: center; height: 34px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="st0" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">id</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--warn)"><circle cx="7.5" cy="15.5" r="4.5"></circle><path d="m10.7 12.3 9.3-9.3"></path><path d="m16 7 3 3"></path></svg></label>
            <span style="font-size: var(--fs-xs); color: var(--text-dim)">integer · pk</span>
            <select id="st0" class="field" style="width: 196px"><option selected="selected">Omitir · la genera la BD</option><option>Secuencia desde MAX+1</option><option>Número aleatorio</option><option>Texto</option><option>Fecha</option><option>Lista de valores</option><option>Booleano</option><option>Valor fijo</option><option>NULL</option><option>Omitir columna</option></select>
            <span style="display: flex; align-items: center; gap: 12px"><span class="help">Autoincremental: la BD asigna 13, 14, 15…</span></span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 140px 120px 210px 1fr; align-items: center; height: 34px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="st1" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">nombre</span></label>
            <span style="font-size: var(--fs-xs); color: var(--text-dim)">text</span>
            <select id="st1" class="field" style="width: 196px"><option>Omitir · la genera la BD</option><option>Secuencia desde MAX+1</option><option>Número aleatorio</option><option selected="selected">Texto</option><option>Fecha</option><option>Lista de valores</option><option>Booleano</option><option>Valor fijo</option><option>NULL</option><option>Omitir columna</option></select>
            <span style="display: flex; align-items: center; gap: 12px"><label style="display: flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: var(--fs-sm)">plantilla<input class="field" type="text" value="nombre completo" style="width: 190px; height: 26px; font-size: var(--fs-sm)"></label></span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 140px 120px 210px 1fr; align-items: center; height: 34px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="st2" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">email</span></label>
            <span style="font-size: var(--fs-xs); color: var(--text-dim)">text</span>
            <select id="st2" class="field" style="width: 196px"><option>Omitir · la genera la BD</option><option>Secuencia desde MAX+1</option><option>Número aleatorio</option><option selected="selected">Texto</option><option>Fecha</option><option>Lista de valores</option><option>Booleano</option><option>Valor fijo</option><option>NULL</option><option>Omitir columna</option></select>
            <span style="display: flex; align-items: center; gap: 12px"><label style="display: flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: var(--fs-sm)">plantilla<input class="field" type="text" value="correo electrónico" style="width: 190px; height: 26px; font-size: var(--fs-sm)"></label></span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 140px 120px 210px 1fr; align-items: center; height: 34px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="st3" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">ciudad</span></label>
            <span style="font-size: var(--fs-xs); color: var(--text-dim)">text</span>
            <select id="st3" class="field" style="width: 196px"><option>Omitir · la genera la BD</option><option>Secuencia desde MAX+1</option><option>Número aleatorio</option><option>Texto</option><option>Fecha</option><option selected="selected">Lista de valores</option><option>Booleano</option><option>Valor fijo</option><option>NULL</option><option>Omitir columna</option></select>
            <span style="display: flex; align-items: center; gap: 12px"><label style="display: flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: var(--fs-sm)">valores<input class="field" type="text" value="Hermosillo, Nogales, Guaymas" style="width: 190px; height: 26px; font-size: var(--fs-sm)"></label></span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 140px 120px 210px 1fr; align-items: center; height: 34px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="st4" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">saldo</span></label>
            <span style="font-size: var(--fs-xs); color: var(--text-dim)">numeric(10,2)</span>
            <select id="st4" class="field" style="width: 196px"><option>Omitir · la genera la BD</option><option>Secuencia desde MAX+1</option><option selected="selected">Número aleatorio</option><option>Texto</option><option>Fecha</option><option>Lista de valores</option><option>Booleano</option><option>Valor fijo</option><option>NULL</option><option>Omitir columna</option></select>
            <span style="display: flex; align-items: center; gap: 12px"><label style="display: flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: var(--fs-sm)">mín<input class="field" type="number" value="0" style="width: 68px; height: 26px; font-size: var(--fs-sm); font-family: var(--font-mono)"></label><label style="display: flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: var(--fs-sm)">máx<input class="field" type="number" value="1000" style="width: 68px; height: 26px; font-size: var(--fs-sm); font-family: var(--font-mono)"></label><label style="display: flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: var(--fs-sm)">decimales<input class="field" type="number" value="2" style="width: 68px; height: 26px; font-size: var(--fs-sm); font-family: var(--font-mono)"></label></span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 140px 120px 210px 1fr; align-items: center; height: 34px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="st5" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">activo</span></label>
            <span style="font-size: var(--fs-xs); color: var(--text-dim)">boolean</span>
            <select id="st5" class="field" style="width: 196px"><option>Omitir · la genera la BD</option><option>Secuencia desde MAX+1</option><option>Número aleatorio</option><option>Texto</option><option>Fecha</option><option>Lista de valores</option><option selected="selected">Booleano</option><option>Valor fijo</option><option>NULL</option><option>Omitir columna</option></select>
            <span style="display: flex; align-items: center; gap: 12px"><span class="help">true o false al azar</span></span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 140px 120px 210px 1fr; align-items: center; height: 34px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="st6" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">alta</span></label>
            <span style="font-size: var(--fs-xs); color: var(--text-dim)">date</span>
            <select id="st6" class="field" style="width: 196px"><option>Omitir · la genera la BD</option><option>Secuencia desde MAX+1</option><option>Número aleatorio</option><option>Texto</option><option selected="selected">Fecha</option><option>Lista de valores</option><option>Booleano</option><option>Valor fijo</option><option>NULL</option><option>Omitir columna</option></select>
            <span style="display: flex; align-items: center; gap: 12px"><label style="display: flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: var(--fs-sm)">desde<input class="field" type="date" value="2025-10-18" style="width: 130px; height: 26px; font-size: var(--fs-sm); font-family: var(--font-mono)"></label><label style="display: flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: var(--fs-sm)">hasta<input class="field" type="date" value="2026-10-18" style="width: 130px; height: 26px; font-size: var(--fs-sm); font-family: var(--font-mono)"></label></span>
          </div>
          </div>
        </section>
        <section style="display: flex; flex-direction: column; gap: 8px">
          <div style="display: flex; align-items: center; gap: 8px"><h2 class="lbl" style="margin: 0; font-size: var(--fs-sm)">Vista previa</h2><span class="help">4 de 10 filas · id previsto, lo asigna la BD</span><span style="flex: 1"></span><a href="#" class="btn btn-ghost" style="height: 26px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg>Otra muestra</a></div>
          <div style="height: 160px; flex: none; border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden"><dc-import name="Grid" theme="{{theme}}" columns="{{gcols}}" rows="{{grows}}" label="Vista previa de los datos generados" height="100%" hint-size="100%,100%"></dc-import></div>
        </section>
      </div>
      <footer style="height: 52px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 24px; border-top: 1px solid var(--border); background: var(--surface)">
        
        
        <span style="flex: 1"></span>
        <span class="dlg-actions"><a href="DataGrid.dc.html" class="btn btn-primary">Generar 10 filas</a><a href="DataGrid.dc.html" class="btn">Cancelar</a></span>
      </footer>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="Generar · clientes" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b',
      os: this.props.os ?? 'windows',
      noLine: 0,
      tabs: [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true}, {"label": "clientes", "kind": "table", "href": "DataGrid.dc.html"}, {"label": "Generar · clientes", "kind": "tool", "active": true, "href": "#", "color": "#2f7dd6"}],
      gcols: [{"name": "id", "type": "integer", "kind": "num", "w": "64px", "key": true}, {"name": "nombre", "type": "text", "kind": "text", "w": "140px", "key": false}, {"name": "email", "type": "text", "kind": "text", "w": "190px", "key": false}, {"name": "ciudad", "type": "text", "kind": "text", "w": "130px", "key": false}, {"name": "saldo", "type": "numeric(10,2)", "kind": "num", "w": "110px", "key": false}, {"name": "activo", "type": "boolean", "kind": "bool", "w": "76px", "key": false}, {"name": "alta", "type": "date", "kind": "date", "w": "1fr", "key": false}],
      grows: [[13, "Beta Ipsum", "beta.ipsum@correo.mx", "Nogales", "24.99", "true", "2026-03-25"], [14, "Nova Rivas", "nova.rivas@correo.mx", "Hermosillo", "248.07", "true", "2026-08-24"], [15, "Amet Orión", "amet.orion@correo.mx", "Guaymas", "889.59", "false", "2026-01-18"], [16, "Umbra Soto", "umbra.soto@correo.mx", "Hermosillo", "151.37", "false", "2025-11-04"]],
    };
  }
}
