Usuarios y permisos
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Usuarios y permisos — Producción (MySQL) — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="db" selected="" conn-name="Producción (MySQL)" conn-color="#c4302b" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>

      <div role="toolbar" aria-label="Acciones de usuarios" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <button type="button" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Nuevo usuario</button>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <button type="button" class="btn btn-ghost" aria-pressed="false">Solo superusuarios</button>
        <button type="button" class="btn btn-ghost" aria-pressed="true" style="background: var(--accent-soft); color: var(--accent-text)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Ocultar cuentas del sistema</button>
        <span style="flex: 1"></span>
        <button type="button" class="btn btn-icon" aria-label="Refrescar (F5)" title="Refrescar (F5)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></button>
        <button type="button" class="btn btn-ghost" aria-haspopup="menu" title="Cambiar contraseña, bloquear cuenta, copiar GRANT…">Más<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></button>
      </div>

      <div style="flex: 1; min-height: 0; display: flex">
        <nav aria-label="Usuarios" style="width: 280px; flex: none; display: flex; flex-direction: column; border-right: 1px solid var(--border); background: var(--surface)">
          <label style="margin: 10px; position: relative; display: block">
            <span style="position: absolute; left: -9999px">Buscar usuario</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position: absolute; left: 9px; top: 7px; color: var(--text-dim)"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <input class="field" placeholder="Buscar usuario" style="width: 100%; padding-left: 28px; font-size: var(--fs-sm)">
          </label>
          <div style="flex: 1; min-height: 0; overflow: hidden; padding: 0 6px">
            <sc-for list="{{users}}" as="u" hint-placeholder-count="6">
              <a href="#" aria-current="{{u.current}}" style="{{u.style}}">
                <span style="{{u.avatar}}">{{u.initial}}</span>
                <span style="flex: 1; min-width: 0">
                  <span style="display: block; font-weight: 600">{{u.name}}</span>
                  <span class="mono" style="display: block; font-size: var(--fs-xs); color: var(--text-dim)">@{{u.host}}</span>
                </span>
                <sc-for list="{{u.chips}}" as="c" hint-placeholder-count="1"><span class="chip" title="Privilegio administrativo" style="height: 20px; padding: 0 6px; font-size: var(--fs-xs); background: var(--warn-soft); color: var(--warn)">{{c}}</span></sc-for>
              </a>
            </sc-for>
          </div>
          <div style="height: 32px; display: flex; align-items: center; padding: 0 12px; border-top: 1px solid var(--border); font-size: var(--fs-sm); color: var(--text-dim)">6 usuarios · 3 de sistema ocultos</div>
        </nav>

        <section aria-label="Permisos de app_ventas@%" style="flex: 1; min-width: 0; display: flex; flex-direction: column; overflow: hidden">
          <header style="height: 64px; flex: none; display: flex; align-items: center; gap: 12px; padding: 0 20px; border-bottom: 1px solid var(--border)">
            <span style="width: 36px; height: 36px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-text); display: flex; align-items: center; justify-content: center; font-weight: 600">A</span>
            <span style="flex: 1; min-width: 0">
              <span style="display: block; font-size: var(--fs-lg); font-weight: 600">app_ventas<span class="mono" style="font-weight: 400; color: var(--text-dim)">@%</span></span>
              <span style="display: block; font-size: var(--fs-sm); color: var(--text-dim)">Cualquier host · autenticación caching_sha2_password</span>
            </span>
            <button type="button" class="btn btn-ghost" aria-haspopup="dialog" title="Pide escribir app_ventas@% para confirmar DROP USER en Producción" style="color: var(--danger)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg>Eliminar usuario…</button>
          </header>

          <div style="flex: 1; min-height: 0; padding: 14px 20px 0; display: flex; flex-direction: column; gap: 18px; overflow: hidden">
            <div style="display: flex; flex-direction: column; gap: 8px">
              <div style="display: flex; align-items: center; gap: 8px"><span class="lbl">Permisos actuales</span><span style="flex: 1"></span><button type="button" style="min-height: 24px; padding: 0; border: 0; background: none; color: var(--accent-text); font-size: var(--fs-sm)">Ver sentencias GRANT</button></div>
              <div style="border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden; font-size: var(--fs-sm)">
                <sc-for list="{{grants}}" as="g" hint-placeholder-count="3">
                  <div style="{{g.style}}">
                    <span class="mono" style="width: 170px; flex: none; color: var(--text)">{{g.scope}}</span>
                    <span style="flex: 1; display: flex; flex-wrap: wrap; gap: 4px">
                      <sc-for list="{{g.privs}}" as="p" hint-placeholder-count="3"><span class="chip mono" style="height: 20px; font-weight: 500; background: var(--chrome-2); color: var(--text)">{{p}}</span></sc-for>
                    </span>
                  </div>
                </sc-for>
              </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px">
              <span class="lbl">Otorgar o revocar</span>
              <div style="display: grid; grid-template-columns: 120px 1fr; gap: 12px 16px; align-items: center; font-size: var(--fs-md)">
                <span style="color: var(--text-dim); align-self: start; padding-top: 4px">Permisos</span>
                <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px 10px">
                  <sc-for list="{{privs}}" as="p" hint-placeholder-count="10">
                    <label style="display: flex; align-items: center; gap: 6px; font-size: var(--fs-sm)"><input type="checkbox" checked="{{p.on}}" style="accent-color: var(--accent); margin: 0"><span class="mono">{{p.name}}</span></label>
                  </sc-for>
                </div>
                <span style="color: var(--text-dim)">Se aplica a</span>
                <span class="seg" role="radiogroup" aria-label="Ámbito del permiso" style="justify-self: start"><span role="radio" aria-checked="false" tabindex="-1">Todo el servidor</span><span role="radio" aria-checked="false" tabindex="-1">Una base de datos</span><span role="radio" aria-checked="true" tabindex="0" class="on">Una tabla</span><span role="radio" aria-checked="false" tabindex="-1">Una columna</span></span>
                <span style="color: var(--text-dim)">Objeto</span>
                <span style="display: flex; align-items: center; gap: 6px">
                  <span class="field" style="width: 150px; display: flex; align-items: center; gap: 6px"><span style="flex: 1">ventas</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span>
                  <span style="color: var(--text-dim)">.</span>
                  <span class="field" style="width: 170px; display: flex; align-items: center; gap: 6px"><span style="flex: 1">pedidos</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span>
                </span>
                <span style="color: var(--text-dim)">SQL</span>
                <div class="mono" style="padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--surface); font-size: var(--fs-sm)"><span style="color: var(--syntax-keyword)">GRANT</span> SELECT, UPDATE <span style="color: var(--syntax-keyword)">ON</span> `ventas`.`pedidos` <span style="color: var(--syntax-keyword)">TO</span> <span style="color: var(--syntax-string)">'app_ventas'</span>@<span style="color: var(--syntax-string)">'%'</span>;</div>
              </div>
            </div>
          </div>

          <div style="height: 52px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 20px; border-top: 1px solid var(--border); background: var(--surface)">
            <span class="help">UPDATE ya lo tiene por <span class="mono">ventas.*</span>; solo se añade SELECT redundante. Revocar pide confirmación.</span>
            <span style="flex: 1"></span>
            <button type="button" class="btn" title="Pide confirmación: REVOKE SELECT, UPDATE ON ventas.pedidos FROM app_ventas@%" style="color: var(--danger)">Revocar 2 permisos…</button>
            <button type="button" class="btn btn-primary">Otorgar 2 permisos a app_ventas</button>
          </div>
        </section>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Producción (MySQL)" db="ventas" color="#c4302b" info="6 usuarios · 3 de sistema ocultos · MySQL 8.0" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const U = [['app_ventas', '%', [], true], ['admin', 'localhost', ['SUPER', 'GRANT']], ['backup', 'localhost', []], ['etl', '10.0.4.%', []], ['reportes', '10.0.3.%', []], ['soporte', '%', ['GRANT']]];
    const users = U.map(([name, host, chips, on]) => ({ name, host, chips, initial: name[0].toUpperCase(), current: on ? 'true' : 'false',
      avatar: `width: 28px; height: 28px; flex: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; background: ${on ? 'var(--accent-soft)' : 'var(--chrome-2)'}; color: ${on ? 'var(--accent-text)' : 'var(--text-dim)'}`,
      style: `height: 46px; box-sizing: border-box; display: flex; align-items: center; gap: 10px; padding: 0 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: ${on ? 'var(--sel)' : 'transparent'}; ${on ? 'box-shadow: inset 2px 0 0 var(--accent);' : ''}` }));
    const G = [['*.*', ['USAGE']], ['ventas.*', ['SELECT', 'INSERT', 'UPDATE', 'DELETE']], ['ventas.ventas_por_ciudad', ['SHOW VIEW']]];
    const grants = G.map(([scope, privs], i) => ({ scope, privs,
      style: `min-height: 36px; display: flex; align-items: center; gap: 12px; padding: 6px 12px; box-sizing: border-box; ${i ? 'border-top: 1px solid var(--border);' : ''}` }));
    const on = ['SELECT', 'UPDATE'];
    const privs = ['SELECT', 'INSERT', 'UPDATE', 'DELETE', 'CREATE', 'DROP', 'ALTER', 'INDEX', 'TRIGGER', 'ALL'].map((name) => ({ name, on: on.includes(name) }));
    return {
      theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows',
      tabs: [{ label: 'Consulta 1', kind: 'query', href: 'EditorResult.dc.html', color: '#c4302b' }, { label: 'Usuarios y permisos', kind: 'tool', active: true, href: 'UsersGrants.dc.html', color: '#c4302b' }],
      users, grants, privs
    };
  }
}
