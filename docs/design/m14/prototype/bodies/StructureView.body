Estructura · clientes
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="clientes — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="clientes" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Acciones de la estructura" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <span class="seg" role="tablist" aria-label="Vista del objeto">
          <a href="DataGrid.dc.html" role="tab" aria-selected="false">Datos</a>
          <a href="StructureView.dc.html" role="tab" aria-selected="true" class="on">Estructura</a>
          <a href="IndexManager.dc.html" role="tab" aria-selected="false">Índices</a>
          <a href="DdlView.dc.html" role="tab" aria-selected="false">DDL</a>
        </span>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <a href="TableDesigner.dc.html" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>Modificar tabla</a>
        <a href="TableDesigner.dc.html" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Columna</a>
        <a href="DdlView.dc.html" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>Copiar DDL</a>
        <span style="flex: 1"></span>
        <a href="#" class="btn btn-icon" aria-label="Refrescar (F5)" title="Refrescar (F5)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></a>
        <a href="TreeContextMenu.dc.html" class="btn btn-icon" aria-label="Más acciones: eliminar tabla, vaciar, renombrar" aria-haspopup="menu" title="Más acciones"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
      </div>
      <div style="flex: 1; min-height: 0; overflow: auto; padding: 14px 20px 20px; display: flex; flex-direction: column; gap: 14px">
        <div class="help">Tabla · Ventas › main · 7 columnas · 12 filas · 2 índices · referenciada por 1 tabla</div>
          <details open="open" style="display: flex; flex-direction: column">
            <summary style="height: 28px; display: flex; align-items: center; gap: 8px; cursor: default; list-style: none"><span style="display: flex; color: var(--text-dim)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span><h2 style="margin: 0; font-size: var(--fs-md); font-weight: 600">Columnas</h2><span class="num help">7</span><span style="flex: 1"></span></summary>
            <div style="margin-top: 6px"><div role="table" aria-label="Columnas de clientes" style="border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden"><div role="row" style="display: grid; grid-template-columns: 28px 150px 140px 96px 130px 1fr; align-items: center; gap: 0 12px; padding: 0 12px; height: 30px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm); font-weight: 600"><span role="columnheader">#</span><span role="columnheader">Columna</span><span role="columnheader">Tipo</span><span role="columnheader">Admite NULL</span><span role="columnheader">Por defecto</span><span role="columnheader">Clave / índice</span></div><div role="row" style="display: grid; grid-template-columns: 28px 150px 140px 96px 130px 1fr; align-items: center; gap: 0 12px; padding: 0 12px; min-height: 28px; "><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm); color: var(--text-dim)">1</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm); font-weight: 600">id</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">INTEGER</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span aria-label="no" style="color: var(--text-dim)">—</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span aria-label="no" style="color: var(--text-dim)">—</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span style="display: inline-flex; align-items: center; gap: 4px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--warn)"><circle cx="7.5" cy="15.5" r="4.5"></circle><path d="m10.7 12.3 9.3-9.3"></path><path d="m16 7 3 3"></path></svg>Clave primaria · autoincremental</span></span></div><div role="row" style="display: grid; grid-template-columns: 28px 150px 140px 96px 130px 1fr; align-items: center; gap: 0 12px; padding: 0 12px; min-height: 28px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent); background: var(--zebra);"><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm); color: var(--text-dim)">2</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm); font-weight: 600">nombre</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">TEXT</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span aria-label="no" style="color: var(--text-dim)">—</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span aria-label="no" style="color: var(--text-dim)">—</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"></span></div><div role="row" style="display: grid; grid-template-columns: 28px 150px 140px 96px 130px 1fr; align-items: center; gap: 0 12px; padding: 0 12px; min-height: 28px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent); "><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm); color: var(--text-dim)">3</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm); font-weight: 600">email</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">TEXT</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span role="img" aria-label="sí" style="display: flex; color: var(--text)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span aria-label="no" style="color: var(--text-dim)">—</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">Única · ux_clientes_email</span></div><div role="row" style="display: grid; grid-template-columns: 28px 150px 140px 96px 130px 1fr; align-items: center; gap: 0 12px; padding: 0 12px; min-height: 28px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent); background: var(--zebra);"><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm); color: var(--text-dim)">4</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm); font-weight: 600">ciudad</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">TEXT</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap