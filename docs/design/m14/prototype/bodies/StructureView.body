" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"></span></div><div role="row" style="display: grid; grid-template-columns: 28px 150px 140px 96px 130px 1fr; align-items: center; gap: 0 12px; padding: 0 12px; min-height: 28px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent); background: var(--zebra);"><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm); color: var(--text-dim)">6</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm); font-weight: 600">activo</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">BOOLEAN</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span aria-label="no" style="color: var(--text-dim)">—</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">TRUE</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"></span></div><div role="row" style="display: grid; grid-template-columns: 28px 150px 140px 96px 130px 1fr; align-items: center; gap: 0 12px; padding: 0 12px; min-height: 28px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent); "><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm); color: var(--text-dim)">7</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm); font-weight: 600">alta</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">DATE</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span role="img" aria-label="sí" style="display: flex; color: var(--text)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">date('now')</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"></span></div></div></div>
          </details>
        <div style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px 20px; align-items: start">
          <details open="open" style="display: flex; flex-direction: column">
            <summary style="height: 28px; display: flex; align-items: center; gap: 8px; cursor: default; list-style: none"><span style="display: flex; color: var(--text-dim)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span><h2 style="margin: 0; font-size: var(--fs-md); font-weight: 600">Índices</h2><span class="num help">2</span><span style="flex: 1"></span><a href="IndexManager.dc.html" style="font-size: var(--fs-sm)">Gestionar índices</a></summary>
            <div style="margin-top: 6px"><div role="table" aria-label="Índices de clientes" style="border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden"><div role="row" style="display: grid; grid-template-columns: 1fr 110px 50px; align-items: center; gap: 0 12px; padding: 0 12px; height: 30px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm); font-weight: 600"><span role="columnheader">Nombre</span><span role="columnheader">Columnas</span><span role="columnheader">Único</span></div><div role="row" style="display: grid; grid-template-columns: 1fr 110px 50px; align-items: center; gap: 0 12px; padding: 0 12px; min-height: 28px; "><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">ux_clientes_email</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">email</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span role="img" aria-label="sí" style="display: flex; color: var(--text)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span></span></div><div role="row" style="display: grid; grid-template-columns: 1fr 110px 50px; align-items: center; gap: 0 12px; padding: 0 12px; min-height: 28px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent); background: var(--zebra);"><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">ix_clientes_ciudad</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">ciudad</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span aria-label="no" style="color: var(--text-dim)">—</span></span></div></div></div>
          </details>
          <details open="open" style="display: flex; flex-direction: column">
            <summary style="height: 28px; display: flex; align-items: center; gap: 8px; cursor: default; list-style: none"><span style="display: flex; color: var(--text-dim)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span><h2 style="margin: 0; font-size: var(--fs-md); font-weight: 600">Referenciada por</h2><span class="num help">1</span><span style="flex: 1"></span></summary>
            <div style="margin-top: 6px"><div role="table" aria-label="Tablas que referencian clientes" style="border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden"><div role="row" style="display: grid; grid-template-columns: 1fr 90px 80px; align-items: center; gap: 0 12px; padding: 0 12px; height: 30px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm); font-weight: 600"><span role="columnheader">Desde</span><span role="columnheader">Hacia</span><span role="columnheader">Al borrar</span></div><div role="row" style="display: grid; grid-template-columns: 1fr 90px 80px; align-items: center; gap: 0 12px; padding: 0 12px; min-height: 28px; "><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><a href="DataGrid.dc.html" class="mono" style="font-size: var(--fs-sm)">pedidos.cliente_id</a></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">clientes.id</span></span><span role="cell" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span style="color: var(--text-dim)">Sin acción</span></span></div></div></div>
          </details>
          <details open="open" style="display: flex; flex-direction: column">
            <summary style="height: 28px; display: flex; align-items: center; gap: 8px; cursor: default; list-style: none"><span style="display: flex; color: var(--text-dim)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span><h2 style="margin: 0; font-size: var(--fs-md); font-weight: 600">Claves foráneas</h2><span class="num help">0</span><span style="flex: 1"></span></summary>
            <div style="margin-top: 6px"><div style="min-height: 34px; display: flex; align-items: center; gap: 8px; padding: 0 12px; border: 1px dashed var(--border); border-radius: var(--r-md); font-size: var(--fs-sm); color: var(--text-dim)">Ninguna: clientes no referencia otras tablas.</div></div>
          </details>
          <details open="open" style="display: flex; flex-direction: column">
            <summary style="height: 28px; display: flex; align-items: center; gap: 8px; cursor: default; list-style: none"><span style="display: flex; color: var(--text-dim)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span><h2 style="margin: 0; font-size: var(--fs-md); font-weight: 600">Triggers</h2><span class="num help">0</span><span style="flex: 1"></span></summary>
            <div style="margin-top: 6px"><div style="min-height: 34px; display: flex; align-items: center; gap: 8px; padding: 0 12px; border: 1px dashed var(--border); border-radius: var(--r-md); font-size: var(--fs-sm); color: var(--text-dim)">Ninguno en esta tabla.<span style="flex: 1"></span><a href="Triggers.dc.html">Nuevo trigger…</a></div></div>
          </details>
        </div>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="clientes · 7 columnas · 2 índices" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b',
      os: this.props.os ?? 'windows',
      noLine: 0,
      tabs: [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true}, {"label": "clientes", "kind": "table", "active": true, "href": "StructureView.dc.html"}],
    };
  }
}
