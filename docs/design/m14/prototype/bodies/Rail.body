Selector del panel lateral
<nav class="th th-{{theme}}" aria-label="Panel lateral" style="width: 64px; height: {{height}}; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 4px 0 8px; background: var(--chrome)">
  <div role="tablist" aria-orientation="vertical" aria-label="Paneles" style="display: flex; flex-direction: column; gap: 2px">
    <sc-for list="{{top}}" as="it" hint-placeholder-count="4">
      <a href="{{it.href}}" role="tab" aria-selected="{{it.selected}}" title="{{it.title}}" style="{{it.style}}">
        <span style="{{it.mark}}"></span>
        <sc-if value="{{it.i.explorer}}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path></svg></sc-if>
        <sc-if value="{{it.i.history}}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l3 2"></path></svg></sc-if>
        <sc-if value="{{it.i.snippets}}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg></sc-if>
        <sc-if value="{{it.i.search}}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path><path d="M8 11h6"></path></svg></sc-if>
        <span style="font-size: 11px; line-height: 1.1">{{it.label}}</span>
      </a>
    </sc-for>
  </div>
  <span style="flex: 1"></span>
  <sc-for list="{{bottom}}" as="it" hint-placeholder-count="2">
    <a href="{{it.href}}" title="{{it.title}}" style="{{it.style}}">
      <span style="{{it.mark}}"></span>
      <sc-if value="{{it.i.plug}}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 2v6M15 2v6"></path><path d="M6 8h12v4a6 6 0 0 1-12 0z"></path><path d="M12 18v4"></path></svg></sc-if>
      <sc-if value="{{it.i.settings}}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path></svg></sc-if>
      <span style="font-size: 11px; line-height: 1.1">{{it.label}}</span>
    </a>
  </sc-for>
</nav>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"active":{"editor":"enum","options":["explorer","history","snippets","search","plug","settings",""],"default":"explorer"},"height":{"editor":"text","default":"738px"},"$preview":{"width":64,"height":738}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const active = this.props.active ?? 'explorer';
    const mk = ([k, label, title, href]) => {
      const on = k === active;
      const i = {}; i[k] = true;
      return { label, title, i, href, selected: on ? 'true' : 'false',
        mark: `position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px; border-radius: 0 3px 3px 0; background: ${on ? 'var(--accent)' : 'transparent'}`,
        style: `position: relative; width: 60px; height: 52px; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; border-radius: var(--r-md); text-decoration: none; color: ${on ? 'var(--text)' : 'var(--text-dim)'}; background: ${on ? 'var(--hover)' : 'transparent'}; font-weight: ${on ? 600 : 400}` };
    };
    const top = [
      ['explorer', 'Objetos', 'Explorador de objetos (Ctrl+Mayús+E)', 'DataGrid.dc.html'],
      ['history', 'Historial', 'Historial de consultas (Ctrl+Mayús+H)', 'HistoryPanel.dc.html'],
      ['snippets', 'Snippets', 'Snippets guardados (Ctrl+Mayús+J)', 'SnippetsPanel.dc.html'],
      ['search', 'Datos', 'Buscar en los datos (Ctrl+Mayús+F)', 'DataSearch.dc.html']].map(mk);
    const bottom = [['plug', 'Conexiones', 'Gestionar conexiones', 'ConnectionManager.dc.html'], ['settings', 'Ajustes', 'Ajustes (Ctrl+,)', 'SettingsGeneral.dc.html']].map(mk);
    return { theme: this.props.theme ?? 'b', height: this.props.height ?? '738px', top, bottom };
  }
}
