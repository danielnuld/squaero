Respaldo y restauración
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Respaldo — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>

      <div role="toolbar" aria-label="Tipo de operación" style="height: 44px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 14px; border-bottom: 1px solid var(--border)">
        <span class="seg" role="tablist" aria-label="Operación">
          <span role="tab" aria-selected="true" tabindex="0" class="on" style="gap: 6px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="5" rx="1"></rect><path d="M4 9v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9"></path><path d="M10 13h4"></path></svg>Respaldar</span>
          <span role="tab" aria-selected="false" tabindex="-1" style="gap: 6px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>DDL a una carpeta</span>
          <span role="tab" aria-selected="false" tabindex="-1" style="gap: 6px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg>Restaurar</span>
        </span>
        <span style="flex: 1"></span>
        <span style="font-size: var(--fs-sm); color: var(--text-dim)">Último respaldo: hoy, 09:02 · ventas_2026-10-18.sql</span>
      </div>

      <nav aria-label="Pasos" style="height: 48px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 24px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-md)">
        <span style="display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--accent-text)" aria-current="step"><span style="width: 22px; height: 22px; border-radius: 50%; background: var(--accent); color: var(--accent-fg); display: flex; align-items: center; justify-content: center; font-size: var(--fs-xs)">1</span>Qué respaldar</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-faint)"><path d="m9 6 6 6-6 6"></path></svg>
        <span style="display: flex; align-items: center; gap: 8px; color: var(--text-dim)"><span style="width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; border: 1px solid var(--border-strong); display: flex; align-items: center; justify-content: center; font-size: var(--fs-xs)">2</span>Destino</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-faint)"><path d="m9 6 6 6-6 6"></path></svg>
        <span style="display: flex; align-items: center; gap: 8px; color: var(--text-dim)"><span style="width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; border: 1px solid var(--border-strong); display: flex; align-items: center; justify-content: center; font-size: var(--fs-xs)">3</span>Revisar y respaldar</span>
      </nav>

      <div style="flex: 1; min-height: 0; display: flex; gap: 32px; padding: 24px; overflow: hidden">
        <form aria-label="Qué respaldar" style="flex: 1; min-width: 0; max-width: 560px; display: grid; grid-template-columns: 160px 1fr; gap: 24px 16px; align-content: start">
          <span style="color: var(--text-dim); padding-top: 4px">Base de datos</span>
          <div style="display: flex; flex-direction: column; gap: 4px">
            <span style="display: flex; align-items: center; gap: 8px; height: 28px; font-weight: 600"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--obj-database)"><ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path></svg>main<span style="font-weight: 400; color: var(--text-dim)">· Ventas (SQLite)</span></span>
            <span class="help">Para respaldar otra base, cámbiala en el explorador.</span>
          </div>

          <span style="color: var(--text-dim)">Contenido</span>
          <div style="display: flex; flex-direction: column; gap: 8px">
            <label style="display: flex; align-items: center; gap: 8px"><input type="checkbox" checked="checked" style="accent-color: var(--accent); margin: 0">Estructura<span class="help">CREATE TABLE, vistas, índices y triggers</span></label>
            <label style="display: flex; align-items: center; gap: 8px"><input type="checkbox" checked="checked" style="accent-color: var(--accent); margin: 0">Datos<span class="help">una sentencia INSERT por fila</span></label>
          </div>

          <span style="color: var(--text-dim); padding-top: 8px">Objetos</span>
          <div style="max-width: 360px; border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden">
            <div style="height: 36px; display: flex; align-items: center; gap: 10px; padding: 0 12px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm)">
              <input type="checkbox" checked="checked" aria-label="Seleccionar todos" style="accent-color: var(--accent); margin: 0">
              <span style="flex: 1; color: var(--text-dim)">5 de 5 seleccionados</span>
              <button type="button" style="min-height: 24px; padding: 0; border: 0; background: none; color: var(--accent-text); font-size: var(--fs-sm)">Ninguno</button>
            </div>
            <sc-for list="{{objs}}" as="o" hint-placeholder-count="5">
              <label style="height: 32px; display: flex; align-items: center; gap: 10px; padding: 0 12px; border-top: 1px solid var(--border)">
                <input type="checkbox" checked="checked" style="accent-color: var(--accent); margin: 0">
                <span style="{{o.icon}}">
                  <sc-if value="{{o.isView}}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg></sc-if>
                  <sc-if value="{{o.isTable}}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg></sc-if>
                </span>
                <span style="flex: 1">{{o.name}}</span>
                <span class="num" style="font-size: var(--fs-xs); color: var(--text-dim)">{{o.sub}}</span>
              </label>
            </sc-for>
          </div>
        </form>

        <aside aria-label="Resumen" style="width: 260px; flex: none; align-self: start; padding: 16px; border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--surface); display: flex; flex-direction: column; gap: 10px; font-size: var(--fs-sm)">
          <span style="font-weight: 600; font-size: var(--fs-md)">Resumen</span>
          <dl style="margin: 0; display: grid; grid-template-columns: 1fr auto; gap: 6px 10px">
            <dt style="color: var(--text-dim)">Objetos</dt><dd class="num" style="margin: 0">4 tablas · 1 vista</dd>
            <dt style="color: var(--text-dim)">Contenido</dt><dd style="margin: 0">Estructura y datos</dd>
            <dt style="color: var(--text-dim)">Filas</dt><dd class="num" style="margin: 0">48</dd>
            <dt style="color: var(--text-dim)">Formato</dt><dd style="margin: 0">Archivo .sql</dd>
          </dl>
          <span class="help" style="line-height: 1.45">El archivo se puede restaurar desde la pestaña Restaurar (pide confirmación con la conexión y la base de destino) o con cualquier cliente SQL.</span>
        </aside>
      </div>

      <div style="height: 52px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 20px; border-top: 1px solid var(--border); background: var(--surface)">
        <button type="button" class="btn" disabled="disabled" aria-disabled="true" style="opacity: .45">Atrás</button>
        <span style="flex: 1"></span>
        <a href="BackupProgress.dc.html" class="btn btn-primary">Siguiente<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg></a>
        <a href="DataGrid.dc.html" class="btn">Cancelar</a>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" color="#2f7dd6" info="Respaldo · 5 objetos seleccionados · 48 filas" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const objs = [['clientes', '12 filas'], ['detalle_pedido', '20 filas'], ['pedidos', '8 filas'], ['productos', '8 filas'], ['ventas_por_ciudad', 'vista', true]]
      .map(([name, sub, v]) => ({ name, sub, isView: !!v, isTable: !v, icon: `display: flex; color: ${v ? 'var(--obj-view)' : 'var(--obj-table)'}` }));
    return {
      theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows',
      tabs: [{ label: 'Consulta 1', kind: 'query', href: 'EditorResult.dc.html', color: '#2f7dd6' }, { label: 'Respaldo · main', kind: 'tool', active: true, href: 'BackupRestore.dc.html', color: '#2f7dd6' }],
      objs
    };
  }
}
