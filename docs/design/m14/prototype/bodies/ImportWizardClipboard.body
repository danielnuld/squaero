Importar · portapapeles
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Importar · clientes — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="clientes" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <header style="height: 56px; flex: none; display: flex; align-items: center; gap: 16px; padding: 0 24px; border-bottom: 1px solid var(--border)">
        <div style="min-width: 0">
          <h1 style="margin: 0; font-size: var(--fs-lg); font-weight: 600">Importar a clientes</h1>
          <div style="font-size: var(--fs-sm); color: var(--text-dim)">Asistente de importación · Ventas</div>
        </div>
        <span style="flex: 1"></span>
        <ol aria-label="Pasos del asistente" style="list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 10px; font-size: var(--fs-md)"><li aria-current="step" style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; background: var(--accent); color: var(--accent-fg)">1</span><span style="color: var(--text); font-weight: 600">Origen</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; border: 1px solid var(--border-strong); color: var(--text-dim)">2</span><span style="color: var(--text-dim)">Columnas</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; border: 1px solid var(--border-strong); color: var(--text-dim)">3</span><span style="color: var(--text-dim)">Importar</span></li></ol>
      </header>
      <div style="flex: 1; min-height: 0; overflow: auto; padding: 24px 32px; display: flex; flex-direction: column; gap: 24px">
        <section style="display: flex; flex-direction: column; gap: 12px">
          <div style="display: flex; align-items: baseline; gap: 8px"><h2 class="lbl" style="margin: 0; font-size: var(--fs-sm)">Origen</h2></div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <span style="padding-top: 5px; color: var(--text-dim)">Tabla destino</span>
            <div style="max-width: 360px"><div style="min-height: 28px; display: flex; align-items: center; gap: 8px"><span aria-hidden="true" style="width: 8px; height: 8px; flex: none; border-radius: 50%; background: #2f7dd6"></span><span style="display: flex; color: var(--obj-table)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg></span><span style="font-weight: 600">clientes</span><span style="color: var(--text-dim)">· Ventas · main · 7 columnas</span></div></div>
          </div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <span style="padding-top: 5px; color: var(--text-dim)">Origen de los datos</span>
            <div style="max-width: 360px"><span class="seg" role="radiogroup" aria-label="Origen de los datos"><a href="ImportWizard.dc.html" role="radio" aria-checked="false">Archivo</a><a href="ImportWizardClipboard.dc.html" role="radio" aria-checked="true" class="on">Portapapeles</a></span></div>
          </div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <span style="padding-top: 5px; color: var(--text-dim)"><label for="paste">Filas pegadas</label></span>
            <div><textarea id="paste" class="field is-focus" spellcheck="false" style="width: 100%; max-width: 640px; height: 96px; box-sizing: border-box; padding: 8px 10px; resize: none; font-family: var(--font-mono); font-size: var(--fs-sm); line-height: 20px">nombre,email,ciudad,saldo,activo,alta
Laura Méndez,lmendez@correo.mx,Hermosillo,450.00,1,2025-07-01
Pedro Ochoa,pochoa@correo.mx,Nogales,1200.50,0,2025-07-03</textarea><div class="help" style="margin-top: 4px">TSV copiado de una hoja de cálculo, o CSV. La primera fila son los encabezados. Formato detectado: CSV, separador coma.</div></div>
          </div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <span style="padding-top: 5px; color: var(--text-dim)">Valores vacíos</span>
            <div style="max-width: 360px"><label style="display: flex; align-items: center; gap: 8px; min-height: 28px"><input type="checkbox" checked="checked" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0">Las celdas vacías son NULL</label></div>
          </div>
        </section>
        <section style="display: flex; flex-direction: column; gap: 8px; max-width: 840px">
          <div style="display: flex; align-items: baseline; gap: 8px"><h2 class="lbl" style="margin: 0; font-size: var(--fs-sm)">Vista previa</h2><span class="help">de lo pegado · 2 filas · 6 columnas</span></div>
          <div style="height: 124px; flex: none; border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden"><dc-import name="Grid" theme="{{theme}}" columns="{{pcols}}" rows="{{prows}}" label="Vista previa de lo pegado" height="100%" hint-size="100%,100%"></dc-import></div>
        </section>
      </div>
      <footer style="height: 52px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 24px; border-top: 1px solid var(--border); background: var(--surface)">
        <button type="button" class="btn" disabled="disabled" style="opacity: .45">Atrás</button>
        
        <span style="flex: 1"></span>
        <span class="dlg-actions"><a href="ImportWizardMapping.dc.html" class="btn btn-primary">Siguiente</a><a href="DataGrid.dc.html" class="btn">Cancelar</a></span>
      </footer>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="Importar · clientes" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b',
      os: this.props.os ?? 'windows',
      noLine: 0,
      tabs: [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true}, {"label": "clientes", "kind": "table", "href": "DataGrid.dc.html"}, {"label": "Importar · clientes", "kind": "tool", "active": true, "href": "#", "color": "#2f7dd6"}],
      pcols: [{"name": "nombre", "type": "texto", "kind": "text", "w": "130px"}, {"name": "email", "type": "texto", "kind": "text", "w": "180px"}, {"name": "ciudad", "type": "texto", "kind": "text", "w": "120px"}, {"name": "saldo", "type": "número", "kind": "num", "w": "90px"}, {"name": "activo", "type": "número", "kind": "num", "w": "70px"}, {"name": "alta", "type": "fecha", "kind": "date", "w": "1fr"}],
      prows: [["Laura Méndez", "lmendez@correo.mx", "Hermosillo", "450.00", 1, "2025-07-01"], ["Pedro Ochoa", "pochoa@correo.mx", "Nogales", "1200.50", 0, "2025-07-03"]],
    };
  }
}
