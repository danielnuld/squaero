Explorador de objetos
<aside class="th th-{{theme}}" aria-label="Explorador" style="width: 248px; height: {{height}}; box-sizing: border-box; display: flex; flex-direction: column; background: var(--chrome); overflow: hidden">
  <div style="height: 36px; flex: none; display: flex; align-items: center; padding: 0 6px 0 12px">
    <span style="flex: 1; font-size: var(--fs-md); font-weight: 600">Explorador</span>
    <a href="ConnectionSearch.dc.html" class="btn btn-icon" aria-label="Conectar (Ctrl+Mayús+K)" title="Conectar (Ctrl+Mayús+K)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></a>
    <a href="TreeDbContextMenu.dc.html" class="btn btn-icon" aria-label="Más acciones del explorador"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
  </div>

  <sc-if value="{{none}}" hint-placeholder-val="{{ false }}">
    <div style="margin: 4px 10px; padding: 16px 14px; border: 1px dashed var(--border-strong); border-radius: var(--r-md); display: flex; flex-direction: column; gap: 10px; font-size: var(--fs-sm); color: var(--text-dim)">
      <span style="color: var(--text); font-weight: 600; font-size: var(--fs-md)">Sin conexión</span>
      <span>Conéctate a una base de datos para ver sus esquemas, tablas y rutinas.</span>
      <a href="ConnectionSearch.dc.html" class="btn btn-primary" style="align-self: flex-start">Conectar…</a>
    </div>
    <div class="lbl" style="padding: 14px 12px 6px">Guardadas</div>
    <sc-for list="{{saved}}" as="s" hint-placeholder-count="3">
      <a href="DataGrid.dc.html" style="height: 36px; display: flex; align-items: center; gap: 10px; margin: 0 6px; padding: 0 8px; border-radius: var(--r-sm); color: var(--text); text-decoration: none">
        <span style="{{s.bar}}"></span>
        <span style="{{s.badge}}">{{s.mono}}</span>
        <span style="flex: 1; min-width: 0"><span style="display: block">{{s.name}}</span><span style="display: block; font-size: var(--fs-xs); color: var(--text-dim)">{{s.sub}}</span></span>
      </a>
    </sc-for>
  </sc-if>

  <sc-if value="{{connected}}" hint-placeholder-val="{{ true }}">
    <label style="margin: 0 8px 6px; position: relative; display: block">
      <span style="position: absolute; left: -9999px">Filtrar objetos</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position: absolute; left: 9px; top: 7px; color: var(--text-dim)"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <input class="{{filterClass}}" value="{{filter}}" placeholder="Filtrar objetos" style="width: 100%; height: 28px; box-sizing: border-box; padding: 0 30px 0 28px; font-size: var(--fs-sm)">
      <sc-if value="{{hasFilter}}"><a href="DataGrid.dc.html" aria-label="Limpiar filtro" style="position: absolute; right: 2px; top: 2px; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--text-dim)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg></a></sc-if>
    </label>
    <sc-if value="{{hasFilter}}"><div class="help" style="padding: 0 14px 4px">{{matchNote}}</div></sc-if>
    <div role="tree" aria-label="Conexiones y objetos" style="flex: 1; min-height: 0; overflow: hidden; padding: 2px 6px">
      <div role="treeitem" aria-expanded="true" aria-level="1" style="{{conn.style}}">
        <span style="{{conn.bar}}"></span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m6 9 6 6 6-6"></path></svg>
        <span style="{{conn.badge}}">{{conn.mono}}</span>
        <span style="flex: 1; min-width: 0; overflow: hidden">
          <span style="display: flex; align-items: center; gap: 5px; font-weight: 600; white-space: nowrap">{{conn.name}}<sc-if value="{{safe}}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Solo lectura" style="color: var(--text-dim)"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg></sc-if></span>
          <span style="display: flex; align-items: center; gap: 5px; font-size: var(--fs-xs); color: var(--text-dim); white-space: nowrap"><span style="{{conn.dot}}"></span>{{conn.status}}</span>
        </span>
        <sc-if value="{{tx}}"><span class="chip" title="Transacción abierta" style="height: 18px; background: var(--warn-soft); color: var(--warn)">TX</span></sc-if>
        <sc-if value="{{lost}}"><a href="DataGrid.dc.html" class="btn" style="height: 24px; padding: 0 8px; font-size: var(--fs-xs)">Reconectar</a></sc-if>
        <sc-if value="{{online}}">
          <a href="#" class="btn btn-icon" aria-label="Refrescar (F5)" title="Refrescar (F5)" style="width: 24px; height: 24px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></a>
          <a href="Welcome.dc.html" class="btn btn-icon" aria-label="Desconectar {{conn.name}}" title="Desconectar" style="width: 24px; height: 24px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 13h16z"></path><path d="M4 18h16"></path></svg></a>
        </sc-if>
      </div>
      <sc-if value="{{loading}}">
        <sc-for list="{{skeleton}}" as="sk" hint-placeholder-count="6">
          <div aria-hidden="true" style="height: var(--h-row); display: flex; align-items: center; gap: 8px; padding-left: {{sk.pad}}"><span style="width: 14px; height: 14px; border-radius: 3px; background: var(--hover)"></span><span style="{{sk.bar}}"></span></div>
        </sc-for>
        <div role="status" class="help" style="padding: 6px 12px">Cargando objetos…</div>
      </sc-if>
      <sc-if value="{{showRows}}">
        <sc-for list="{{rows}}" as="r" hint-placeholder-count="10">
          <a href="{{r.href}}" role="treeitem" aria-level="{{r.level}}" aria-expanded="{{r.expanded}}" aria-selected="{{r.selected}}" style="{{r.style}}">
            <span style="width: 14px; display: flex; justify-content: center; color: var(--text-dim)">
              <sc-if value="{{r.open}}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></sc-if>
              <sc-if value="{{r.closed}}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg></sc-if>
            </span>
            <span style="{{r.iconStyle}}">
              <sc-if value="{{r.k.database}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path></svg></sc-if>
              <sc-if value="{{r.k.schema}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4z"></path><path d="M4 9h16M9 9v11"></path></svg></sc-if>
              <sc-if value="{{r.k.folder}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg></sc-if>
              <sc-if value="{{r.k.table}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg></sc-if>
              <sc-if value="{{r.k.view}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg></sc-if>
              <sc-if value="{{r.k.trigger}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"></path></svg></sc-if>
              <sc-if value="{{r.k.column}}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="3" width="8" height="18" rx="1"></rect></svg></sc-if>
              <sc-if value="{{r.k.key}}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="4.5"></circle><path d="m10.7 12.3 9.3-9.3"></path><path d="m16 7 3 3"></path></svg></sc-if>
              <sc-if value="{{r.k.fk}}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"></path><path d="M8 7h9v9"></path></svg></sc-if>
            </span>
            <span style="{{r.labelStyle}}">{{r.label}}</span>
            <span class="num" style="font-size: var(--fs-xs); color: var(--text-dim); white-space: nowrap">{{r.meta}}</span>
          </a>
        </sc-for>
      </sc-if>
      <sc-if value="{{second}}">
        <div role="treeitem" aria-expanded="false" aria-level="1" style="{{conn2.style}}">
          <span style="{{conn2.bar}}"></span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg>
          <span style="{{conn2.badge}}">PG</span>
          <span style="flex: 1; min-width: 0">
            <span style="display: flex; align-items: center; gap: 5px; font-weight: 600">Producción<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Solo lectura" style="color: var(--text-dim)"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg></span>
            <span style="display: flex; align-items: center; gap: 5px; font-size: var(--fs-xs); color: var(--text-dim)"><span style="width: 6px; height: 6px; border-radius: 50%; background: var(--ok)"></span>PostgreSQL · ventas</span>
          </span>
        </div>
      </sc-if>
    </div>
  </sc-if>
</aside>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"state":{"editor":"enum","options":["none","connected","loading","lost"],"default":"connected"},"tree":{"editor":"enum","options":["db","tables","expanded","columns"],"default":"tables"},"selected":{"editor":"text","default":"clientes"},"filter":{"editor":"text","default":""},"connName":{"editor":"text","default":"Ventas"},"connColor":{"editor":"color","default":"#2f7dd6"},"safe":{"editor":"boolean","default":false},"tx":{"editor":"boolean","default":false},"second":{"editor":"boolean","default":true},"height":{"editor":"text","default":"738px"},"$preview":{"width":248,"height":738}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const p = this.props;
    const state = p.state ?? 'connected';
    const tree = p.tree ?? 'tables';
    const sel = p.selected ?? 'clientes';
    const filter = (p.filter ?? '').toLowerCase();
    const name = p.connName ?? 'Ventas';
    const eng = /MySQL/.test(name) ? { mono: 'MY', engine: 'MySQL', db: 'ventas', schema: '', color: '#c4302b' }
      : /PostgreSQL|Producción/.test(name) ? { mono: 'PG', engine: 'PostgreSQL', db: 'ventas', schema: 'public', color: '#c4302b' }
      : { mono: 'SQ', engine: 'SQLite', db: 'main', schema: '', color: '#2f7dd6' };
    const color = p.connColor ?? eng.color;
    const badge = (c) => `width: 22px; height: 22px; flex: none; border-radius: var(--r-sm); background: color-mix(in srgb, ${c} 16%, transparent); color: ${c}; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 10px; font-weight: 600`;
    const lost = state === 'lost';
    const loading = state === 'loading';
    const connRow = (c) => `position: relative; min-height: 40px; box-sizing: border-box; display: flex; align-items: center; gap: 6px; padding: 4px 4px 4px 10px; margin-bottom: 2px; border-radius: var(--r-sm); background: var(--chrome-2); font-size: var(--fs-md)`;
    const conn = {
      name: name.replace(/ \(.*\)$/, ''), mono: eng.mono, badge: badge(color), style: connRow(),
      bar: `position: absolute; left: 0; top: 6px; bottom: 6px; width: 3px; border-radius: 0 3px 3px 0; background: ${color}`,
      dot: `width: 6px; height: 6px; border-radius: 50%; background: ${lost ? 'var(--danger)' : loading ? 'var(--warn)' : 'var(--ok)'}`,
      status: lost ? 'Desconectada' : loading ? 'Conectando…' : `${eng.engine} · ${eng.db}`
    };
    const conn2 = { style: connRow() + '; margin-top: 6px', badge: badge('#c4302b'), bar: 'position: absolute; left: 0; top: 6px; bottom: 6px; width: 3px; border-radius: 0 3px 3px 0; background: #c4302b' };
    const colors = { database: 'var(--obj-database)', schema: 'var(--text-dim)', folder: 'var(--text-dim)', table: 'var(--obj-table)', view: 'var(--obj-view)', trigger: 'var(--obj-trigger)', column: 'var(--text-dim)', key: 'var(--warn)', fk: 'var(--obj-table)' };
    const row = (depth, label, kind, opts = {}) => {
      const on = label === sel;
      const k = {}; k[kind] = true;
      return { label, k, meta: opts.meta ?? '', level: String(depth + 2), expanded: opts.caret === 'open' ? 'true' : opts.caret === 'closed' ? 'false' : '', selected: on ? 'true' : 'false',
        open: opts.caret === 'open', closed: opts.caret === 'closed',
        href: opts.href ?? (kind === 'table' ? 'DataGrid.dc.html' : kind === 'view' ? 'ViewData.dc.html' : '#'),
        iconStyle: `display: flex; color: ${colors[kind]}`,
        labelStyle: `flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; ${opts.strong ? 'font-weight: 600;' : ''} ${kind === 'column' || kind === 'key' || kind === 'fk' ? 'font-size: var(--fs-sm);' : ''}`,
        style: `height: var(--h-row); box-sizing: border-box; display: flex; align-items: center; gap: 6px; padding: 0 6px 0 ${depth * 16 + 2}px; border-radius: var(--r-sm); text-decoration: none; font-size: var(--fs-md); color: ${on ? 'var(--accent-text)' : 'var(--text)'}; background: ${on ? 'var(--sel)' : 'transparent'}; font-weight: ${on ? 600 : 400}` };
    };
    const d0 = eng.schema ? 1 : 0;
    let rows = [row(0, eng.db, 'database', { caret: tree === 'db' ? 'closed' : 'open', strong: true, meta: 'activa' })];
    if (eng.schema && tree !== 'db') rows.push(row(1, eng.schema, 'schema', { caret: 'open' }));
    if (tree !== 'db') {
      rows.push(row(1 + d0, 'Tablas', 'folder', { caret: 'open', meta: '4' }));
      if (tree === 'columns') {
        rows.push(row(2 + d0, 'clientes', 'table', { caret: 'open', meta: '12 filas' }),
          row(3 + d0, 'id', 'key', { meta: 'integer' }), row(3 + d0, 'nombre', 'column', { meta: 'text' }), row(3 + d0, 'email', 'column', { meta: 'text' }),
          row(3 + d0, 'ciudad', 'column', { meta: 'text' }), row(3 + d0, 'saldo', 'column', { meta: 'numeric(10,2)' }), row(3 + d0, 'activo', 'column', { meta: 'boolean' }),
          row(3 + d0, 'alta', 'column', { meta: 'date' }), row(2 + d0, 'detalle_pedido', 'table', { caret: 'closed', meta: '20' }), row(2 + d0, 'pedidos', 'table', { caret: 'closed', meta: '8' }));
      } else {
        rows.push(row(2 + d0, 'clientes', 'table', { caret: 'closed', meta: '12' }), row(2 + d0, 'detalle_pedido', 'table', { caret: 'closed', meta: '20' }),
          row(2 + d0, 'pedidos', 'table', { caret: 'closed', meta: '8' }), row(2 + d0, 'productos', 'table', { caret: 'closed', meta: '8' }));
      }
      if (tree === 'expanded') rows.push(row(1 + d0, 'Vistas', 'folder', { caret: 'open', meta: '1' }), row(2 + d0, 'ventas_por_ciudad', 'view'), row(1 + d0, 'Triggers', 'folder', { caret: 'open', meta: '1' }), row(2 + d0, 'trg_pedidos_total', 'trigger', { href: 'Triggers.dc.html' }));
      else rows.push(row(1 + d0, 'Vistas', 'folder', { caret: 'closed', meta: '1' }), row(1 + d0, 'Triggers', 'folder', { caret: 'closed', meta: '1' }));
    }
    let matchNote = '';
    if (filter) {
      const leaves = rows.filter((r) => r.k.table || r.k.view || r.k.trigger);
      const hits = leaves.filter((r) => r.label.toLowerCase().includes(filter));
      const kept = []; let folder = null;
      rows.forEach((r) => {
        if (r.k.database || r.k.schema) { kept.push(r); return; }
        if (r.k.folder) { folder = r; return; }
        if ((r.k.table || r.k.view || r.k.trigger) && r.label.toLowerCase().includes(filter)) {
          if (folder) { kept.push(Object.assign({}, folder, { open: true, closed: false })); folder = null; }
          kept.push(r);
        }
      });
      rows = kept;
      matchNote = `${hits.length} de ${leaves.length} objetos coinciden`;
    }
    const saved = [['Ventas', 'SQLite · ventas.db', '#2f7dd6', 'SQ'], ['Ventas copia', 'SQLite · ventas_copia.db', '#2e9e52', 'SQ'], ['Producción', 'PostgreSQL · solo lectura', '#c4302b', 'PG']]
      .map(([n, sub, c, m]) => ({ name: n, sub, mono: m, badge: badge(c), bar: `width: 3px; align-self: stretch; margin: 6px 0; border-radius: 2px; background: ${c}` }));
    const skeleton = [0, 1, 1, 2, 2, 2].map((d, i) => ({ pad: `${d * 16 + 8}px`, bar: `height: 10px; width: ${[90, 70, 110, 80, 120, 95][i]}px; border-radius: 4px; background: var(--hover)` }));
    return {
      theme: p.theme ?? 'b', height: p.height ?? '738px', none: state === 'none', connected: state !== 'none',
      lost, loading, online: !lost && !loading, showRows: !loading && !lost, skeleton,
      conn, conn2, second: (p.second ?? true) && !/Producción/.test(name),
      safe: !!p.safe, tx: !!p.tx, filter: p.filter ?? '', hasFilter: !!filter, matchNote, filterClass: filter ? 'field is-focus' : 'field', rows, saved
    };
  }
}
