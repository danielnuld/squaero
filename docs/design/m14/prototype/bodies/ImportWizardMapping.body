Importar · columnas
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Importar · clientes — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="clientes" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <header style="height: 56px; flex: none; display: flex; align-items: center; gap: 16px; padding: 0 24px; border-bottom: 1px solid var(--border)">
        <div style="min-width: 0">
          <h1 style="margin: 0; font-size: var(--fs-lg); font-weight: 600">Importar a clientes</h1>
          <div style="font-size: var(--fs-sm); color: var(--text-dim)">Desde clientes_julio.csv · 4812 filas</div>
        </div>
        <span style="flex: 1"></span>
        <ol aria-label="Pasos del asistente" style="list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 10px; font-size: var(--fs-md)"><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; background: var(--accent-soft); color: var(--accent-text)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span style="position: absolute; left: -9999px">Hecho:</span></span><span style="color: var(--text-dim)">Origen</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li aria-current="step" style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; background: var(--accent); color: var(--accent-fg)">2</span><span style="color: var(--text); font-weight: 600">Columnas</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; border: 1px solid var(--border-strong); color: var(--text-dim)">3</span><span style="color: var(--text-dim)">Importar</span></li></ol>
      </header>
      <div style="flex: 1; min-height: 0; overflow: auto; padding: 20px 32px; display: flex; flex-direction: column; gap: 20px">
        <section style="display: flex; flex-direction: column; gap: 8px; max-width: 880px">
          <div style="display: flex; align-items: baseline; gap: 8px"><h2 class="lbl" style="margin: 0; font-size: var(--fs-sm)">Mapeo de columnas</h2><span class="help">6 de 7 columnas asignadas · id se omite: es autoincremental</span><span style="flex: 1"></span><a href="#" style="font-size: var(--fs-sm)">Asignar por nombre</a></div>
          <div role="table" aria-label="Mapeo de columnas" style="border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden">
          <div role="row" style="display: grid; grid-template-columns: 210px 28px 260px 1fr; align-items: center; height: 30px; padding: 0 12px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm); font-weight: 600">
            <span role="columnheader">Columna destino</span><span></span><span role="columnheader">Columna de origen</span><span role="columnheader">Ejemplo (fila 1)</span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 210px 28px 260px 1fr; align-items: center; height: 36px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="map0" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">id</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--warn)"><circle cx="7.5" cy="15.5" r="4.5"></circle><path d="m10.7 12.3 9.3-9.3"></path><path d="m16 7 3 3"></path></svg><span style="font-size: var(--fs-xs); color: var(--text-dim)">integer</span></label>
            <span aria-hidden="true" style="color: var(--text-dim)">←</span>
            <select id="map0" class="field" style="width: 240px"><option selected="selected">Omitir · la genera la BD</option><option>nombre</option><option>email</option><option>ciudad</option><option>saldo</option><option>activo</option><option>alta</option></select>
            <span style="color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="help">Autoincremental: la asigna la BD</span></span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 210px 28px 260px 1fr; align-items: center; height: 36px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="map1" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">nombre</span><span style="font-size: var(--fs-xs); color: var(--text-dim)">text</span></label>
            <span aria-hidden="true" style="color: var(--text-dim)">←</span>
            <select id="map1" class="field" style="width: 240px"><option>Omitir</option><option selected="selected">nombre</option><option>email</option><option>ciudad</option><option>saldo</option><option>activo</option><option>alta</option></select>
            <span style="color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">Laura Méndez</span></span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 210px 28px 260px 1fr; align-items: center; height: 36px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="map2" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">email</span><span style="font-size: var(--fs-xs); color: var(--text-dim)">text</span></label>
            <span aria-hidden="true" style="color: var(--text-dim)">←</span>
            <select id="map2" class="field" style="width: 240px"><option>Omitir</option><option>nombre</option><option selected="selected">email</option><option>ciudad</option><option>saldo</option><option>activo</option><option>alta</option></select>
            <span style="color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">lmendez@correo.mx</span></span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 210px 28px 260px 1fr; align-items: center; height: 36px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="map3" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">ciudad</span><span style="font-size: var(--fs-xs); color: var(--text-dim)">text</span></label>
            <span aria-hidden="true" style="color: var(--text-dim)">←</span>
            <select id="map3" class="field" style="width: 240px"><option>Omitir</option><option>nombre</option><option>email</option><option selected="selected">ciudad</option><option>saldo</option><option>activo</option><option>alta</option></select>
            <span style="color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">Hermosillo</span></span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 210px 28px 260px 1fr; align-items: center; height: 36px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="map4" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">saldo</span><span style="font-size: var(--fs-xs); color: var(--text-dim)">numeric(10,2)</span></label>
            <span aria-hidden="true" style="color: var(--text-dim)">←</span>
            <select id="map4" class="field" style="width: 240px"><option>Omitir</option><option>nombre</option><option>email</option><option>ciudad</option><option selected="selected">saldo</option><option>activo</option><option>alta</option></select>
            <span style="color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">450.00</span></span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 210px 28px 260px 1fr; align-items: center; height: 36px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="map5" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">activo</span><span style="font-size: var(--fs-xs); color: var(--text-dim)">boolean</span></label>
            <span aria-hidden="true" style="color: var(--text-dim)">←</span>
            <select id="map5" class="field" style="width: 240px"><option>Omitir</option><option>nombre</option><option>email</option><option>ciudad</option><option>saldo</option><option selected="selected">activo</option><option>alta</option></select>
            <span style="color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">1 → true</span></span>
          </div>
          <div role="row" style="display: grid; grid-template-columns: 210px 28px 260px 1fr; align-items: center; height: 36px; padding: 0 12px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent)">
            <label for="map6" style="display: flex; align-items: center; gap: 6px"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">alta</span><span style="font-size: var(--fs-xs); color: var(--text-dim)">date</span></label>
            <span aria-hidden="true" style="color: var(--text-dim)">←</span>
            <select id="map6" class="field" style="width: 240px"><option>Omitir</option><option>nombre</option><option>email</option><option>ciudad</option><option>saldo</option><option>activo</option><option selected="selected">alta</option></select>
            <span style="color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><span class="mono" style="font-size: var(--fs-sm)">2025-07-01</span></span>
          </div>
          </div>
        </section>
        <section style="display: flex; flex-direction: column; gap: 12px">
          <div style="display: flex; align-items: baseline; gap: 8px"><h2 class="lbl" style="margin: 0; font-size: var(--fs-sm)">Opciones</h2></div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <span style="padding-top: 5px; color: var(--text-dim)">Si una fila falla</span>
            <div style="max-width: 360px"><div role="radiogroup" aria-label="Si una fila falla" style="display: flex; flex-direction: column; gap: 2px"><label style="display: flex; align-items: center; gap: 8px; min-height: 28px"><input type="radio" name="fail" checked="checked" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0">Omitirla e importar el resto</label><label style="display: flex; align-items: center; gap: 8px; min-height: 28px"><input type="radio" name="fail" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0">Abortar todo (no se importa nada)</label></div></div>
          </div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <span style="padding-top: 5px; color: var(--text-dim)">Transacción</span>
            <div style="max-width: 360px"><div style="min-height: 28px; display: flex; align-items: center; gap: 8px"><span>Todo en una transacción</span></div><div class="help" style="margin-top: 4px">Si cancelas la importación, no se guarda ninguna fila.</div></div>
          </div>
        </section>
      </div>
      <footer style="height: 52px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 24px; border-top: 1px solid var(--border); background: var(--surface)">
        <a href="ImportWizard.dc.html" class="btn">Atrás</a>
        
        <span style="flex: 1"></span>
        <span class="dlg-actions"><a href="ImportProgress.dc.html" class="btn btn-primary">Importar 4812 filas</a><a href="DataGrid.dc.html" class="btn">Cancelar</a></span>
      </footer>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="Importar · clientes · 4812 filas" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b',
      os: this.props.os ?? 'windows',
      noLine: 0,
      tabs: [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true}, {"label": "clientes", "kind": "table", "href": "DataGrid.dc.html"}, {"label": "Importar · clientes", "kind": "tool", "active": true, "href": "#", "color": "#2f7dd6"}],
    };
  }
}
