Ajustes · Acerca de
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Ajustes — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="settings" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="SettingsNav" theme="{{theme}}" active="about" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>

      <div style="flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column; align-items: center; padding: 72px 32px 24px">
        <span aria-hidden="true" style="width: 76px; height: 76px; border-radius: calc(var(--r-lg) * 1.6); background: var(--accent); color: var(--accent-fg); display: flex; align-items: center; justify-content: center; position: relative; box-shadow: var(--shadow-lg)">
          <span style="position: absolute; inset: 10px; border-radius: var(--r-md); border: 1.5px solid color-mix(in srgb, var(--accent-fg) 35%, transparent)"></span>
          <span style="font-size: 40px; font-weight: 700; line-height: 1">S</span>
        </span>
        <h1 style="margin: 20px 0 0; font-size: 30px; font-weight: 600; letter-spacing: -0.01em">Squaero</h1>
        <p style="margin: 6px 0 0; font-size: var(--fs-lg); color: var(--text-dim)">Ligero, local y libre.</p>
        <div style="margin-top: 16px; display: flex; align-items: center; gap: 10px">
          <span class="chip num" style="background: var(--accent-soft); color: var(--accent-text)">Versión 0.39.0</span>
          <sc-if value="{{idle}}" hint-placeholder-val="{{ true }}"><button class="btn" onClick="{{check}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg>Buscar actualizaciones</button></sc-if>
          <sc-if value="{{checked}}" hint-placeholder-val="{{ false }}"><span role="status" aria-live="polite" style="display: flex; align-items: center; gap: 6px; font-size: var(--fs-sm); color: var(--ok)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Tienes la versión más reciente.</span></sc-if>
        </div>

        <dl style="margin: 36px 0 0; width: 380px; display: grid; grid-template-columns: 1fr auto; border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; font-size: var(--fs-md)">
          <sc-for list="{{facts}}" as="f" hint-placeholder-count="3">
            <dt style="{{f.dt}}">{{f.k}}</dt>
            <dd class="num mono" style="{{f.dd}}">{{f.v}}</dd>
          </sc-for>
        </dl>

        <button class="btn btn-ghost" style="margin-top: 10px">Copiar la información para un informe de error</button>
        <nav aria-label="Enlaces" style="margin-top: 22px; display: flex; gap: 22px; font-size: var(--fs-md)">
          <a href="#">Repositorio</a>
          <a href="#">Notas de la versión</a>
          <a href="#">Licencias de terceros</a>
          <a href="#">Informar de un problema</a>
        </nav>
        <span style="flex: 1"></span>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const os = this.props.os ?? 'windows';
    const F = [['Versión de la app', '0.39.0'], ['Versión del núcleo (libdbcore)', '0.39.0'], ['Protocolo IPC', '8'], ['Sistema', { windows: 'Windows 11 · x64', macos: 'macOS 15 · arm64', linux: 'Ubuntu 24.04 · GNOME' }[os]]];
    const facts = F.map(([k, v], i) => {
      const line = i < F.length - 1 ? 'border-bottom: 1px solid var(--border);' : '';
      return { k, v, dt: `margin: 0; padding: 10px 14px; color: var(--text-dim); ${line}`, dd: `margin: 0; padding: 10px 14px; text-align: right; ${line}` };
    });
    const checked = !!this.state.checked;
    return {
      os, theme: this.props.theme ?? 'b', facts, checked, idle: !checked, check: () => this.setState({ checked: true }),
      tabs: [{ label: 'Consulta 1', kind: 'query', href: 'EditorResult.dc.html', dirty: true, color: '#2f7dd6' }, { label: 'Ajustes', kind: 'settings', active: true, href: 'SettingsAbout.dc.html' }]
    };
  }
}
