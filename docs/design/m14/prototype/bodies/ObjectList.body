Objetos · main
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Objetos · main — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="main" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Acciones de la lista de objetos" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <a href="NewTableDesigner.dc.html" class="btn btn-primary"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Nueva tabla</a>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <span class="seg" role="tablist" aria-label="Tipo de objeto"><a href="#" role="tab" aria-selected="true" class="on">Todos <span class="num" style="margin-left: 6px">6</span></a><a href="#" role="tab" aria-selected="false"><span aria-hidden="true" style="width: 6px; height: 6px; border-radius: 2px; background: var(--obj-table); margin-right: 6px"></span>Tablas <span class="num" style="margin-left: 6px">4</span></a><a href="#" role="tab" aria-selected="false"><span aria-hidden="true" style="width: 6px; height: 6px; border-radius: 2px; background: var(--obj-view); margin-right: 6px"></span>Vistas <span class="num" style="margin-left: 6px">1</span></a><a href="#" role="tab" aria-selected="false"><span aria-hidden="true" style="width: 6px; height: 6px; border-radius: 2px; background: var(--obj-trigger); margin-right: 6px"></span>Triggers <span class="num" style="margin-left: 6px">1</span></a></span>
        <label style="position: relative; margin-left: 6px"><span style="position: absolute; left: -9999px">Filtrar por nombre</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position: absolute; left: 9px; top: 7px; color: var(--text-dim)"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg><input class="field" placeholder="Filtrar por nombre" style="width: 200px; padding-left: 28px; font-size: var(--fs-sm)"></label>
        <span style="flex: 1"></span>
        <a href="#" class="btn btn-icon" aria-label="Refrescar (F5)" title="Refrescar (F5)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></a>
        <a href="TreeContextMenu.dc.html" class="btn btn-icon" aria-label="Más acciones" aria-haspopup="menu" title="Más acciones"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
      </div>
      <div style="flex: 1; min-height: 0">
        <dc-import name="Grid" theme="{{theme}}" columns="{{cols}}" rows="{{rows}}" selected="{{sel}}" label="Objetos de main" height="100%" hint-size="100%,100%"></dc-import>
      </div>
      <div style="height: 34px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 12px; border-top: 1px solid var(--border); font-size: var(--fs-sm); color: var(--text-dim)">
        <span>6 objetos · 4 tablas · 1 vista · 1 trigger</span><span style="flex: 1"></span><span class="help">Intro o doble clic abre los datos · <span class="kbd">F12</span> abre la estructura</span>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="6 objetos" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b',
      os: this.props.os ?? 'windows',
      noLine: 0,
      tabs: [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true}, {"label": "Objetos · main", "kind": "tool", "active": true, "color": "#2f7dd6"}],
      cols: [{"name": "nombre", "type": "text", "kind": "text", "w": "200px", "sort": "↑"}, {"name": "tipo", "type": "text", "kind": "text", "w": "90px"}, {"name": "filas", "type": "integer", "kind": "num", "w": "80px"}, {"name": "columnas", "type": "integer", "kind": "num", "w": "90px"}, {"name": "índices", "type": "integer", "kind": "num", "w": "80px"}, {"name": "definición", "type": "text", "kind": "text", "w": "1fr"}],
      rows: [["clientes", "Tabla", 12, 7, 2, "id INTEGER PRIMARY KEY, nombre TEXT NOT NULL, …"], ["detalle_pedido", "Tabla", 20, 5, 1, "pedido_id → pedidos, producto_id → productos"], ["pedidos", "Tabla", 8, 5, 1, "cliente_id → clientes"], ["productos", "Tabla", 8, 4, 1, "id INTEGER PRIMARY KEY, nombre TEXT, precio …"], ["trg_pedidos_total", "Trigger", null, null, null, "AFTER INSERT ON detalle_pedido"], ["ventas_por_ciudad", "Vista", null, 3, null, "SELECT c.ciudad, COUNT(p.id) AS pedidos, SUM(p.total) …"]],
      sel: {"r": 0, "c": 0},
    };
  }
}
