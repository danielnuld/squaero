Modificar · clientes
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Modificar · clientes — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="clientes" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Acciones del diseñador" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <span style="display: flex; align-items: center; gap: 8px; padding: 0 6px"><span style="display: flex; color: var(--obj-table)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg></span><b style="font-weight: 600">Modificar · clientes</b><span class="help">Ventas · main</span></span>
        <span style="flex: 1"></span>
        <span class="dlg-actions"><a href="StructureView.dc.html" class="btn btn-primary">Aplicar 1 cambio</a><a href="StructureView.dc.html" class="btn">Descartar</a></span>
      </div>
      <div style="flex: 1; min-height: 0; display: flex">
        <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 16px; padding: 16px 20px; overflow: hidden">
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: center">
            <label for="tname" style="color: var(--text-dim)">Nombre de la tabla</label>
            <input id="tname" class="{{nameClass}}" value="{{tname}}" style="width: 280px; font-family: var(--font-mono); font-size: var(--fs-sm)">
          </div>
          <div role="table" aria-label="Columnas" style="border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden; font-size: var(--fs-md)">
            <div role="row" style="display: grid; grid-template-columns: 32px 1fr 1.25fr 48px 40px 44px 1.15fr 36px; align-items: center; height: 30px; padding: 0 6px; gap: 6px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm); font-weight: 600">
              <span></span><span role="columnheader">Columna</span><span role="columnheader">Tipo</span><span role="columnheader" style="text-align: center" title="Admite NULL">NULL</span><span role="columnheader" style="text-align: center" title="Clave primaria">PK</span><span role="columnheader" style="text-align: center" title="Autoincremental">Auto</span><span role="columnheader">Por defecto</span><span></span>
            </div>
            <sc-for list="{{cols}}" as="c" hint-placeholder-count="6">
              <div role="row" style="{{c.style}}">
                <span style="font-size: var(--fs-xs); color: var(--text-dim); text-align: center" class="num">{{c.n}}</span>
                <input class="{{c.cls}}" value="{{c.name}}" aria-label="Nombre de la columna {{c.n}}" style="width: 100%; height: 26px; font-family: var(--font-mono); font-size: var(--fs-sm)">
                <input class="field" list="tipos" value="{{c.type}}" aria-label="Tipo de la columna {{c.n}}" style="width: 100%; height: 26px; font-family: var(--font-mono); font-size: var(--fs-sm)">
                <span style="display: flex; justify-content: center"><input type="checkbox" checked="{{c.nul}}" aria-label="Admite NULL la columna {{c.n}}" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0"></span>
                <span style="display: flex; justify-content: center"><input type="checkbox" checked="{{c.pk}}" aria-label="Clave primaria en la columna {{c.n}}" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0"></span>
                <span style="display: flex; justify-content: center"><input type="checkbox" checked="{{c.ai}}" aria-label="Autoincremental en la columna {{c.n}}" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0"></span>
                <input class="field" value="{{c.def}}" aria-label="Valor por defecto de la columna {{c.n}}" style="width: 100%; height: 26px; font-family: var(--font-mono); font-size: var(--fs-sm)">
                <a href="#" class="btn btn-icon" aria-label="Quitar la columna {{c.name}}" title="Quitar columna" style="width: 28px; height: 28px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg></a>
              </div>
            </sc-for>
            <a href="#" style="height: 36px; display: flex; align-items: center; gap: 8px; padding: 0 12px; color: var(--accent-text); text-decoration: none; font-size: var(--fs-md)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Añadir columna<span class="kbd" style="margin-left: 4px">{{kAdd}}</span></a>
          </div>
          <datalist id="tipos"><option value="INTEGER"></option><option value="TEXT"></option><option value="REAL"></option><option value="NUMERIC(10,2)"></option><option value="BOOLEAN"></option><option value="DATE"></option><option value="BLOB"></option></datalist>
          <div class="help">{{hint}}</div>
        </div>
        <aside aria-label="Vista previa SQL" style="width: 370px; flex: none; display: flex; flex-direction: column; border-left: 1px solid var(--border); background: var(--surface)">
          <div style="height: 40px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 8px 0 14px; border-bottom: 1px solid var(--border)">
            <span style="font-weight: 600">Vista previa SQL</span><span class="help">{{previewInfo}}</span><span style="flex: 1"></span>
            <a href="#" class="btn btn-icon" aria-label="Copiar SQL" title="Copiar SQL"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></a>
            <a href="EditorResult.dc.html" class="btn btn-icon" aria-label="Abrir en el editor" title="Abrir en el editor"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path><path d="m9 13-2 2 2 2"></path><path d="m13 13 2 2-2 2"></path></svg></a>
          </div>
          <div style="flex: 1; min-height: 0">
            <dc-import name="SqlEditor" theme="{{theme}}" sql="{{sql}}" current="{{noLine}}" height="100%" hint-size="100%,100%"></dc-import>
          </div>
          <div style="flex: none; display: flex; gap: 8px; padding: 10px 14px; border-top: 1px solid var(--border); font-size: var(--fs-sm); color: var(--text-dim)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 1px"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><span>{{note}}</span></div>
        </aside>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="clientes · 1 cambio sin aplicar" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const added = [7];
    const focus = 7;
    const os = this.props.os ?? 'windows';
    const cols = [["id", "INTEGER", false, true, true, null], ["nombre", "TEXT", false, false, false, null], ["email", "TEXT", true, false, false, null], ["ciudad", "TEXT", true, false, false, null], ["saldo", "NUMERIC(10,2)", true, false, false, "0"], ["activo", "BOOLEAN", false, false, false, "TRUE"], ["alta", "DATE", true, false, false, "date('now')"], ["telefono", "TEXT", true, false, false, null]].map((c, i) => ({ n: i + 1, name: c[0], type: c[1], nul: c[2], pk: c[3], ai: c[4], def: c[5] ?? '',
      cls: i === focus ? 'field is-focus' : 'field',
      style: `display: grid; grid-template-columns: 32px 1fr 1.25fr 48px 40px 44px 1.15fr 36px; align-items: center; height: 36px; padding: 0 6px; gap: 6px; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent); background: ${added.includes(i) ? 'var(--ok-soft)' : (i % 2 ? 'var(--zebra)' : 'transparent')}; ${added.includes(i) ? 'box-shadow: inset 2px 0 0 var(--ok);' : ''}` }));
    return {
      theme: this.props.theme ?? 'b', os, noLine: 0, tabs: [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true}, {"label": "Modificar · clientes", "kind": "tool", "active": true, "dirty": true, "href": "TableDesigner.dc.html", "color": "#2f7dd6"}], cols, kAdd: os === 'macos' ? '⌘↩' : 'Ctrl+Intro',
      tname: "clientes", nameClass: "field", hint: "1 columna nueva (en verde) · los cambios se aplican en una transacción.", previewInfo: "· 1 sentencia", note: "SQLite solo admite añadir y renombrar columnas con ALTER TABLE; cambiar un tipo recrea la tabla.",
      sql: "ALTER TABLE \"clientes\"\n  ADD COLUMN \"telefono\" TEXT;"
    };
  }
}
