Cargando
<div class="th th-{{theme}}" data-os="{{os}}" aria-busy="true" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="clientes — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="loading" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Acciones de {{obj}}" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <span class="seg" role="tablist" aria-label="Vista del objeto">
          <a href="DataGrid.dc.html" role="tab" aria-selected="true" class="on">Datos</a>
          <a href="StructureView.dc.html" role="tab" aria-selected="false">Estructura</a>
          <a href="IndexManager.dc.html" role="tab" aria-selected="false">Índices</a>
          <a href="DdlView.dc.html" role="tab" aria-selected="false">DDL</a>
        </span>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <a href="DataFilterCondition.dc.html" class="btn btn-ghost" title="Filtrar la tabla ({{k.filter}})"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8v6l-4 2v-8z"></path></svg>Filtrar</a>
        <a href="DataFilterCondition.dc.html" class="btn btn-ghost" title="Ordenar ({{k.sort}})"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16"></path><path d="m3 8 4-4 4 4"></path><path d="M17 20V4"></path><path d="m13 16 4 4 4-4"></path></svg>Ordenar</a>
        <a href="GridColumnFilter.dc.html" class="btn btn-ghost" title="Buscar en las filas cargadas ({{k.find}})"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>Buscar en la página</a>
        <a href="GridEditMode.dc.html" class="btn btn-ghost" title="Añadir fila ({{k.row}} en la última fila)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Fila</a>
        <span style="flex: 1"></span>
        <a href="GridTransposed.dc.html" class="btn btn-icon" aria-label="Transponer" title="Transponer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h7v7H4z"></path><path d="M13 13h7v7h-7z"></path><path d="M15 4h5v5"></path><path d="M9 20H4v-5"></path></svg></a>
        <a href="PinnedResult.dc.html" class="btn btn-icon" aria-label="Fijar resultado" title="Fijar resultado"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17v5"></path><path d="M9 3h6l-1 6 4 4H6l4-4z"></path></svg></a>
        <a href="CompareMenu.dc.html" class="btn btn-icon" aria-label="Comparar con…" title="Comparar con…"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v18"></path><path d="M16 3v18"></path><path d="M3 8h5"></path><path d="M16 16h5"></path></svg></a>
        <a href="Chart.dc.html" class="btn btn-icon" aria-label="Graficar" title="Graficar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"></path><path d="M10 20V4"></path><path d="M16 20v-7"></path><path d="M22 20H2"></path></svg></a>
        <a href="ExportMenu.dc.html" class="btn btn-ghost" aria-haspopup="menu" title="Exportar ({{k.export}})"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"></path><path d="m7 8 5-5 5 5"></path><path d="M5 21h14"></path></svg>Exportar<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a>
        <a href="SyncMenu.dc.html" class="btn btn-icon" aria-label="Más acciones: importar, generar, transferir, sincronizar" aria-haspopup="menu" title="Más acciones"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
      </div>
      <div style="flex: 1; min-height: 0">
        <dc-import name="Grid" theme="{{theme}}" columns="{{columns}}" rows="{{rows}}" loading="true" label="Filas de clientes" height="100%" hint-size="100%,100%"></dc-import>
      </div>
      <div role="status" style="height: 34px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 12px; border-top: 1px solid var(--border); font-size: var(--fs-sm); color: var(--text-dim)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="color: var(--accent-text)"><path d="M12 3a9 9 0 1 0 9 9"></path></svg>
        <span class="num">Conectando a Ventas y leyendo clientes · 00:02</span>
        <button type="button" class="btn" style="height: 24px; font-size: var(--fs-sm)">Cancelar</button>
        <span style="flex: 1"></span>
        <span class="help">Las pestañas y el explorador se rellenan en cuanto responde la base</span>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" color="#2f7dd6" info="Conectando…" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const os = this.props.os ?? 'windows'; const mac = os === 'macos';
    const K = (s) => { if (!mac) return s; const p = s.split('+'); const key = p.pop(); const sym = { Alt: '⌥', 'Mayús': '⇧', Ctrl: '⌘' }; const km = { Intro: '↩', Supr: '⌫', 'Re Pág': '⇞', 'Av Pág': '⇟' }; return ['Alt', 'Mayús', 'Ctrl'].filter((m) => p.includes(m)).map((m) => sym[m]).join('') + (km[key] ?? key); };
    const k = { filter: K('Ctrl+Mayús+L'), sort: K('Ctrl+Mayús+O'), find: K('Ctrl+F'), row: K('Ctrl+Intro'), run: K('Ctrl+Intro'), script: K('Ctrl+Mayús+Intro'), fmt: K('Alt+Mayús+F'), stop: 'Esc',
      open: K('Intro'), alter: 'F4', del: K('Supr'), copy: K('Ctrl+C'), ddl: K('Ctrl+Mayús+C'), refresh: mac ? '⌘R' : 'F5', newq: K('Ctrl+T'), close: K('Ctrl+W'), closeAll: K('Ctrl+Mayús+W'),
      reopen: K('Ctrl+Mayús+T'), export: K('Ctrl+Mayús+X'), settings: K('Ctrl+,'), save: K('Ctrl+S'), more: K('Alt+M') };
    const act = os === 'windows' ? '' : 'flex-direction: row-reverse';
    return {
      theme: this.props.theme ?? 'b', os, k, obj: 'clientes',
      tabs: [{ label: 'clientes', kind: 'table', active: true, running: true, href: 'TreeLoading.dc.html' }],
      columns: [
        { name: 'id', type: 'integer', kind: 'num', w: '76px', key: true }, { name: 'nombre', type: 'text', kind: 'text', w: '140px' },
        { name: 'email', type: 'text', kind: 'text', w: '200px' }, { name: 'ciudad', type: 'text', kind: 'text', w: '130px' },
        { name: 'saldo', type: 'numeric(10,2)', kind: 'num', w: '112px' }, { name: 'activo', type: 'boolean', kind: 'bool', w: '78px' }, { name: 'alta', type: 'date', kind: 'date', w: '1fr' }],
      rows: []
    };
  }
}
