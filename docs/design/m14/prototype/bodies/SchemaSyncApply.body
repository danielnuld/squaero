Sincronizar estructura · aplicar
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Sincronizar estructura — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="clientes" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <header style="height: 56px; flex: none; display: flex; align-items: center; gap: 16px; padding: 0 24px; border-bottom: 1px solid var(--border)">
        <div style="min-width: 0">
          <h1 style="margin: 0; font-size: var(--fs-lg); font-weight: 600">Sincronizar estructura</h1>
          <div style="font-size: var(--fs-sm); color: var(--text-dim)">Ventas → Ventas copia · main</div>
        </div>
        <span style="flex: 1"></span>
        <ol aria-label="Pasos del asistente" style="list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 10px; font-size: var(--fs-md)"><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; background: var(--accent-soft); color: var(--accent-text)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span style="position: absolute; left: -9999px">Hecho:</span></span><span style="color: var(--text-dim)">Comparar</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; background: var(--accent-soft); color: var(--accent-text)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span style="position: absolute; left: -9999px">Hecho:</span></span><span style="color: var(--text-dim)">Revisar</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li aria-current="step" style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; background: var(--accent); color: var(--accent-fg)">3</span><span style="color: var(--text); font-weight: 600">Aplicar</span></li></ol>
      </header>
      <div style="flex: 1; min-height: 0; overflow: auto; padding: 24px 32px; display: flex; flex-direction: column; gap: 20px">
        <sc-if value="{{running}}" hint-placeholder-val="{{ true }}">
        <section style="display: flex; flex-direction: column; gap: 16px; max-width: 820px">
          <div style="display: flex; align-items: center; gap: 10px"><span style="display: flex; color: var(--accent)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-opacity=".25"></circle><path d="M21 12a9 9 0 0 0-9-9"></path></svg></span><span style="font-size: var(--fs-lg); font-weight: 600">Aplicando en Ventas copia · main</span></div>
          <div style="display: flex; flex-direction: column; gap: 8px">
            <div style="display: flex; align-items: baseline; gap: 8px; font-size: var(--fs-md)"><span class="num" style="font-weight: 600">Sentencia 3 de 3 · 2 aplicadas</span><span style="flex: 1"></span><span class="help num">00:02 transcurrido</span></div>
            <div role="progressbar" aria-label="Sentencias aplicadas" aria-valuemin="0" aria-valuemax="100" aria-valuenow="66" style="height: 8px; border-radius: 999px; background: var(--hover); overflow: hidden"><div style="width: 66%; height: 100%; border-radius: 999px; background: var(--accent)"></div></div>
          </div>
        </section>
        </sc-if>
        <sc-if value="{{done}}" hint-placeholder-val="{{ false }}">
        <section style="display: flex; flex-direction: column; gap: 12px; max-width: 820px">
          <div style="display: flex; align-items: center; gap: 10px"><span style="width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--ok-soft); color: var(--ok)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span style="font-size: var(--fs-lg); font-weight: 600">3 sentencias aplicadas en Ventas copia</span><span class="help">· 2.1 s · transacción confirmada</span></div>
          <div class="help">La estructura de Ventas copia › main coincide con Ventas, salvo la columna clientes.telefono, que se conservó.</div>
        </section>
        </sc-if>
        <section style="display: flex; flex-direction: column; gap: 8px; max-width: 820px">
          <h2 class="lbl" style="margin: 0; font-size: var(--fs-sm)">Sentencias</h2>
          <sc-if value="{{running}}" hint-placeholder-val="{{ true }}"><ol aria-label="Progreso por sentencia" style="list-style: none; margin: 0; padding: 0; border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden"><li style="display: grid; grid-template-columns: 26px 22px 1fr 150px; gap: 0 10px; align-items: center; min-height: 40px; padding: 4px 12px; ">
              <span role="img" aria-label="Aplicada" style="width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--ok-soft); color: var(--ok)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">1</span>
              <span class="mono" style="font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; ">DROP VIEW "ventas_por_ciudad";</span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim); text-align: right">Aplicada · 4 ms</span>
            </li><li style="display: grid; grid-template-columns: 26px 22px 1fr 150px; gap: 0 10px; align-items: center; min-height: 40px; padding: 4px 12px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);">
              <span role="img" aria-label="Aplicada" style="width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--ok-soft); color: var(--ok)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">2</span>
              <span class="mono" style="font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; ">CREATE VIEW "ventas_por_ciudad" AS SELECT c.ciudad, …</span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim); text-align: right">Aplicada · 6 ms</span>
            </li><li style="display: grid; grid-template-columns: 26px 22px 1fr 150px; gap: 0 10px; align-items: center; min-height: 40px; padding: 4px 12px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);">
              <span role="img" aria-label="Ejecutando" style="width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--accent-soft); color: var(--accent)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-opacity=".25"></circle><path d="M21 12a9 9 0 0 0-9-9"></path></svg></span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">3</span>
              <span class="mono" style="font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; ">CREATE INDEX "ix_clientes_ciudad" ON "clientes" ("ciudad");</span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim); text-align: right">Ejecutando · 00:02</span>
            </li><li style="display: grid; grid-template-columns: 26px 22px 1fr 150px; gap: 0 10px; align-items: center; min-height: 40px; padding: 4px 12px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent); color: var(--text-dim);">
              <span role="img" aria-label="Excluida" style="width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--surface); color: var(--text-dim)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg></span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">4</span>
              <span class="mono" style="font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-decoration: line-through;">ALTER TABLE "clientes" DROP COLUMN "telefono";</span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim); text-align: right">Excluida · elimina datos</span>
            </li></ol></sc-if>
          <sc-if value="{{done}}" hint-placeholder-val="{{ false }}"><ol aria-label="Resultado por sentencia" style="list-style: none; margin: 0; padding: 0; border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden"><li style="display: grid; grid-template-columns: 26px 22px 1fr 150px; gap: 0 10px; align-items: center; min-height: 40px; padding: 4px 12px; ">
              <span role="img" aria-label="Aplicada" style="width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--ok-soft); color: var(--ok)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">1</span>
              <span class="mono" style="font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; ">DROP VIEW "ventas_por_ciudad";</span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim); text-align: right">Aplicada · 4 ms</span>
            </li><li style="display: grid; grid-template-columns: 26px 22px 1fr 150px; gap: 0 10px; align-items: center; min-height: 40px; padding: 4px 12px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);">
              <span role="img" aria-label="Aplicada" style="width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--ok-soft); color: var(--ok)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">2</span>
              <span class="mono" style="font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; ">CREATE VIEW "ventas_por_ciudad" AS SELECT c.ciudad, …</span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim); text-align: right">Aplicada · 6 ms</span>
            </li><li style="display: grid; grid-template-columns: 26px 22px 1fr 150px; gap: 0 10px; align-items: center; min-height: 40px; padding: 4px 12px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);">
              <span role="img" aria-label="Aplicada" style="width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--ok-soft); color: var(--ok)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">3</span>
              <span class="mono" style="font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; ">CREATE INDEX "ix_clientes_ciudad" ON "clientes" ("ciudad");</span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim); text-align: right">Aplicada · 2.1 s</span>
            </li><li style="display: grid; grid-template-columns: 26px 22px 1fr 150px; gap: 0 10px; align-items: center; min-height: 40px; padding: 4px 12px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent); color: var(--text-dim);">
              <span role="img" aria-label="Excluida" style="width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--surface); color: var(--text-dim)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg></span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">4</span>
              <span class="mono" style="font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-decoration: line-through;">ALTER TABLE "clientes" DROP COLUMN "telefono";</span>
              <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim); text-align: right">Excluida · elimina datos</span>
            </li></ol></sc-if>
        </section>
        <sc-if value="{{running}}" hint-placeholder-val="{{ true }}"><div style="max-width: 820px"><div style="display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border-radius: var(--r-md); background: var(--surface); font-size: var(--fs-sm); color: var(--text-dim); line-height: 1.45"><span style="display: flex; flex: none; margin-top: 1px; color: var(--text-dim)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span><span>Todo va en una transacción: si cancelas o una sentencia falla, se revierte todo y Ventas copia queda como estaba.</span></div></div></sc-if>
      </div>
      <footer style="height: 52px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 24px; border-top: 1px solid var(--border); background: var(--surface)">
        <sc-if value="{{running}}" hint-placeholder-val="{{ true }}"><button type="button" class="btn" disabled="disabled" style="opacity: .45">Atrás</button><span class="help">Puedes seguir trabajando en otras pestañas.</span><span style="flex: 1"></span><span class="dlg-actions"><a href="SchemaSyncResult.dc.html" class="btn"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1"></rect></svg>Cancelar</a></span></sc-if>
        <sc-if value="{{done}}" hint-placeholder-val="{{ false }}"><a href="#" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>Copiar registro</a><span style="flex: 1"></span><span class="dlg-actions"><a href="SchemaSync.dc.html" class="btn">Comparar de nuevo</a><a href="DataGrid.dc.html" class="btn">Cerrar</a></span></sc-if>
      </footer>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="{{statusInfo}}" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"state":{"editor":"enum","options":["running","done"],"default":"running"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b',
      os: this.props.os ?? 'windows',
      noLine: 0,
      tabs: [{ label: 'Consulta 1', kind: 'query', href: 'EditorResult.dc.html', dirty: true }, { label: 'clientes', kind: 'table', href: 'DataGrid.dc.html' }, { label: 'Sincronizar estructura', kind: 'tool', active: true, color: '#2f7dd6', running: (this.props.state ?? 'running') === 'running' }],
      running: (this.props.state ?? 'running') === 'running',
      done: (this.props.state ?? 'running') === 'done',
      statusInfo: (this.props.state ?? 'running') === 'running' ? 'Aplicando · sentencia 3 de 3' : '3 sentencias aplicadas · 2.1 s',
    };
  }
}
