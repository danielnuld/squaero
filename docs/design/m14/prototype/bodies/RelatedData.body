Datos relacionados
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" notif="1" window-title="pedidos — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="pedidos" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Acciones de pedidos" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <span class="seg" role="tablist" aria-label="Vista del objeto" style="flex: none"><a href="DataGrid.dc.html" role="tab" aria-selected="true" class="on">Datos</a><a href="StructureView.dc.html" role="tab" aria-selected="false">Estructura</a><a href="IndexManager.dc.html" role="tab" aria-selected="false">Índices</a><a href="DdlView.dc.html" role="tab" aria-selected="false">DDL</a></span>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <a href="DataFilterCondition.dc.html" class="btn btn-ghost" title="Filtrar la tabla en el servidor (Ctrl+Mayús+L)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8v6l-4 2v-8z"></path></svg>Filtrar</a>
        <a href="DataFilterCondition.dc.html" class="btn btn-ghost" title="Ordenar (Ctrl+Mayús+O)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16"></path><path d="m3 8 4-4 4 4"></path><path d="M17 20V4"></path><path d="m13 16 4 4 4-4"></path></svg>Ordenar</a>
        <a href="GridColumnFilter.dc.html" class="btn btn-ghost" aria-pressed="false" title="Buscar en las filas cargadas (Ctrl+F)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>Buscar en la página</a>
        <a href="GridPendingChanges.dc.html" class="btn btn-ghost" title="Añadir fila (Ctrl+Intro en la última fila)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Fila</a>
        <span style="flex: 1"></span>
        <a href="GridTransposed.dc.html" class="btn btn-icon" aria-label="Transponer" title="Transponer" aria-pressed="false"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h7v7H4z"></path><path d="M13 13h7v7h-7z"></path><path d="M15 4h5v5"></path><path d="M9 20H4v-5"></path></svg></a>
        <a href="PinnedResult.dc.html" class="btn btn-icon" aria-label="Fijar resultado" title="Fijar resultado" aria-pressed="false"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17v5"></path><path d="M9 3h6l-1 6 4 4H6l4-4z"></path></svg></a>
        <a href="CompareMenu.dc.html" class="btn btn-icon" aria-label="Comparar con…" title="Comparar con…"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v18"></path><path d="M16 3v18"></path><path d="M3 8h5"></path><path d="M16 16h5"></path></svg></a>
        <a href="Chart.dc.html" class="btn btn-icon" aria-label="Graficar" title="Graficar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"></path><path d="M10 20V4"></path><path d="M16 20v-7"></path><path d="M22 20H2"></path></svg></a>
        <a href="ExportMenu.dc.html" class="btn btn-ghost" aria-haspopup="menu" aria-expanded="false"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"></path><path d="m7 8 5-5 5 5"></path><path d="M5 21h14"></path></svg>Exportar<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a>
        <a href="SyncMenu.dc.html" class="btn btn-icon" aria-label="Más acciones: importar, generar, transferir, sincronizar" aria-haspopup="menu" aria-expanded="false" title="Más acciones"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
      </div>
      <div style="flex: 1; min-height: 0">
        <dc-import name="Grid" theme="{{theme}}" columns="{{columns}}" rows="{{rows}}" selected="{{sel}}" label="Filas de pedidos" height="100%" hint-size="100%,100%"></dc-import>
      </div>
      <div style="height: 34px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 12px; border-top: 1px solid var(--border); font-size: var(--fs-sm); color: var(--text-dim)">
        <span class="num" style="white-space: nowrap">Filas 1–8 de 8</span> <a href="#" style="font-size: var(--fs-sm)">Contar total</a>
        <span class="help">Doble clic, F2 o empieza a escribir para editar una celda</span>
        <span style="flex: 1"></span>
        <label style="display: flex; align-items: center; gap: 6px; white-space: nowrap">Filas por página <span class="field" role="combobox" aria-expanded="false" style="height: 24px; display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-sm)">1000<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></label>
        <span class="seg" aria-label="Paginación"><a href="#" aria-label="Primera página">|‹</a><a href="#" aria-label="Página anterior">‹</a><span class="on" aria-current="page">1 / 1</span><a href="#" aria-label="Página siguiente">›</a><a href="#" aria-label="Última página">›|</a></span>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="pedidos · 8 filas · 6 columnas · 13 ms" hint-size="1280px,24px"></dc-import>
  <div class="dlg-scrim">
    <div class="dlg" role="dialog" aria-modal="true" aria-labelledby="rel-t" style="width: 880px; height: 520px">
      <div class="dlg-h"><span id="rel-t">Datos relacionados</span><span class="mono" style="font-size: var(--fs-md); font-weight: 400; color: var(--text-dim)">pedidos.cliente_id = 4</span><span style="flex: 1"></span><a href="GridContextMenuFk.dc.html" class="btn btn-icon" aria-label="Cerrar (Esc)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg></a></div>
      <div style="flex: 1; min-height: 0; display: flex; border-top: 1px solid var(--border)">
        <nav aria-label="Tablas relacionadas" style="width: 210px; flex: none; padding: 10px 8px; border-right: 1px solid var(--border); background: var(--surface); display: flex; flex-direction: column; gap: 2px"><div class="lbl" style="padding: 0 8px 6px">Relacionadas · 2 con datos</div><a href="#" aria-current="true" style="display: flex; align-items: center; gap: 8px; height: 30px; padding: 0 8px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: var(--sel); font-weight: 600"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--obj-table)"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg><span style="flex: 1">clientes</span><span style="font-size: var(--fs-xs); color: var(--text-dim)">referencia</span><span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">1</span></a><a href="#" aria-current="false" style="display: flex; align-items: center; gap: 8px; height: 30px; padding: 0 8px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: transparent; font-weight: 400"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--obj-table)"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg><span style="flex: 1">detalle_pedido</span><span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">3</span></a><div class="help" style="padding: 10px 8px 0">«referencia» es la fila a la que apunta la clave; el resto son filas que apuntan a ella.</div></nav>
        <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10px; padding: 12px 16px"><div style="display: flex; align-items: center; gap: 8px"><span style="font-weight: 600">clientes</span><span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">1 fila</span></div><div style="flex: 1; min-height: 0; border: 1px solid var(--border); border-radius: var(--r-sm); overflow: hidden; display: flex; flex-direction: column"><div style="flex: 1; min-height: 0">
        <dc-import name="Grid" theme="{{theme}}" columns="{{relColumns}}" rows="{{relRows}}"  label="Filas relacionadas en clientes" height="100%" hint-size="100%,100%"></dc-import>
      </div></div><div class="mono" style="padding: 8px 10px; border-radius: var(--r-sm); background: var(--surface); border: 1px solid var(--border); font-size: var(--fs-sm)"><span style="color: var(--syntax-keyword)">SELECT</span> * <span style="color: var(--syntax-keyword)">FROM</span> "main"."clientes" <span style="color: var(--syntax-keyword)">WHERE</span> "id" = <span style="color: var(--syntax-number)">4</span> <span style="color: var(--syntax-keyword)">LIMIT</span> <span style="color: var(--syntax-number)">200</span>;</div></div>
      </div>
      <div class="dlg-f"><span class="help">Ctrl+B o Ctrl+clic en una celda con flecha abre esta vista</span><span style="flex: 1"></span><span class="dlg-actions"><a href="DataGrid.dc.html" class="btn btn-primary">Abrir clientes filtrada</a><a href="GridContextMenuFk.dc.html" class="btn">Cerrar</a></span></div>
    </div>
  </div>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return Object.assign({ theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows', yes: true, no: false }, {"columns": [{"name": "id", "type": "integer", "kind": "num", "w": "76px", "key": true, "sort": "↑"}, {"name": "cliente_id", "type": "integer", "fk": "clientes.id", "kind": "num", "w": "180px"}, {"name": "fecha", "type": "date", "kind": "date", "w": "120px"}, {"name": "estado", "type": "text", "kind": "text", "w": "120px"}, {"name": "total", "type": "numeric(10,2)", "kind": "num", "w": "110px"}, {"name": "notas", "type": "text", "kind": "text", "w": "1fr"}], "rows": [[1, 4, "2024-02-10", "entregado", "1250.00", null], [2, 1, "2024-03-02", "entregado", "349.50", "Envío express"], [3, 5, "2024-05-19", "enviado", "89.90", null], [4, 8, "2024-07-07", "entregado", "5400.00", null], [5, 2, "2024-09-21", "pendiente", "980.50", "Factura a nombre de empresa"], [6, 4, "2024-12-01", "entregado", "3071.99", null], [7, 9, "2025-02-14", "cancelado", "88.25", "Sin existencias"], [8, 11, "2025-05-30", "enviado", "640.00", ""]], "sel": {"r": 0, "c": 1}, "relColumns": [{"name": "id", "type": "integer", "kind": "num", "w": "56px", "key": true}, {"name": "nombre", "type": "text", "kind": "text", "w": "100px"}, {"name": "email", "type": "text", "kind": "text", "w": "135px"}, {"name": "ciudad", "type": "text", "kind": "text", "w": "90px"}, {"name": "saldo", "type": "numeric(10,2)", "kind": "num", "w": "96px"}, {"name": "alta", "type": "date", "kind": "date", "w": "1fr"}], "relRows": [[4, "Luis Ramírez", "lramirez@correo.mx", "Cd. Obregón", "4321.99", "2024-01-09"]], "tabs": [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true}, {"label": "pedidos", "kind": "table", "active": true, "href": "GridContextMenuFk.dc.html"}]});
  }
}
