Triggers y eventos
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Triggers — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="expanded" selected="trg_pedidos_total" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>

      <div role="toolbar" aria-label="Acciones de triggers" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <a href="EditorEmpty.dc.html" class="btn btn-primary"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>Abrir en el editor</a>
        <button type="button" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>Copiar definición</button>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <span class="seg" role="radiogroup" aria-label="Tipo de objeto"><span role="radio" aria-checked="true" tabindex="0" class="on">Triggers</span><span role="radio" aria-checked="false" aria-disabled="true" tabindex="-1" title="No disponible en SQLite: no tiene eventos programados" style="color: var(--text-faint); opacity: .75">Eventos</span></span>
        <span style="flex: 1"></span>
        <button type="button" class="btn btn-icon" aria-label="Refrescar (F5)" title="Refrescar (F5)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></button>
        <button type="button" class="btn btn-ghost" aria-haspopup="menu" title="Deshabilitar, copiar como CREATE, eliminar trigger…">Más<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></button>
      </div>

      <div style="flex: 1; min-height: 0; display: flex">
        <nav aria-label="Triggers" style="width: 300px; flex: none; display: flex; flex-direction: column; border-right: 1px solid var(--border); background: var(--surface)">
          <label style="margin: 10px; position: relative; display: block">
            <span style="position: absolute; left: -9999px">Buscar por nombre o tabla</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position: absolute; left: 9px; top: 7px; color: var(--text-dim)"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <input class="field" placeholder="Buscar por nombre o tabla" style="width: 100%; padding-left: 28px; font-size: var(--fs-sm)">
          </label>
          <div style="flex: 1; min-height: 0; padding: 0 6px">
            <div class="lbl" style="padding: 4px 10px 6px">detalle_pedido</div>
            <a href="#" aria-current="true" style="height: 46px; box-sizing: border-box; display: flex; align-items: center; gap: 10px; padding: 0 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: var(--sel); box-shadow: inset 2px 0 0 var(--accent)">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--obj-trigger)"><path d="M13 2 4 14h7l-1 8 9-12h-7z"></path></svg>
              <span style="flex: 1; min-width: 0">
                <span style="display: block; font-weight: 600">trg_pedidos_total</span>
                <span style="display: block; font-size: var(--fs-xs); color: var(--text-dim)">Después de INSERT · por fila</span>
              </span>
            </a>
          </div>
          <div style="height: 32px; display: flex; align-items: center; padding: 0 12px; border-top: 1px solid var(--border); font-size: var(--fs-sm); color: var(--text-dim)">1 trigger</div>
        </nav>

        <section aria-label="Definición de trg_pedidos_total" style="flex: 1; min-width: 0; display: flex; flex-direction: column">
          <header style="padding: 16px 20px 14px; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 12px">
            <div style="display: flex; align-items: center; gap: 10px">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--obj-trigger)"><path d="M13 2 4 14h7l-1 8 9-12h-7z"></path></svg>
              <span style="font-size: var(--fs-xl); font-weight: 600">trg_pedidos_total</span>
              <span class="chip" style="background: color-mix(in srgb, var(--obj-trigger) 14%, transparent); color: var(--obj-trigger)">Trigger</span>
            </div>
            <dl style="margin: 0; display: grid; grid-template-columns: repeat(4, auto) 1fr; gap: 2px 28px; font-size: var(--fs-sm)">
              <dt class="lbl">Tabla</dt><dt class="lbl">Momento</dt><dt class="lbl">Evento</dt><dt class="lbl">Nivel</dt><dt></dt>
              <dd style="margin: 0"><a href="DataGrid.dc.html" style="display: inline-flex; align-items: center; gap: 4px; text-decoration: none"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg>detalle_pedido</a></dd>
              <dd style="margin: 0">Después de</dd><dd class="mono" style="margin: 0">INSERT</dd><dd style="margin: 0">Por fila</dd><dd></dd>
            </dl>
            <p style="margin: 0; font-size: var(--fs-sm); color: var(--text-dim)">Recalcula <span class="mono" style="color: var(--text)">pedidos.total</span> cada vez que se añade una línea de detalle.</p>
          </header>
          <div style="height: 34px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 20px; background: var(--surface); border-bottom: 1px solid var(--border)">
            <span style="font-weight: 600">Definición</span>
            <span class="help">Solo lectura · SQLite no permite ALTER TRIGGER: el editor la recrea con DROP + CREATE en una transacción</span>
          </div>
          <div style="flex: 1; min-height: 0"><dc-import name="SqlEditor" theme="{{theme}}" sql="{{ddl}}" current="0" height="100%" hint-size="100%,100%"></dc-import></div>
        </section>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" color="#2f7dd6" info="1 trigger · 0 eventos (no disponibles en SQLite)" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows',
      tabs: [{ label: 'Consulta 1', kind: 'query', href: 'EditorResult.dc.html', color: '#2f7dd6' }, { label: 'Triggers · main', kind: 'tool', active: true, href: 'Triggers.dc.html', color: '#2f7dd6' }],
      ddl: 'CREATE TRIGGER trg_pedidos_total\nAFTER INSERT ON detalle_pedido\nFOR EACH ROW\nBEGIN\n  UPDATE pedidos\n  SET total = (\n    SELECT SUM(cantidad * precio_unitario)\n    FROM detalle_pedido\n    WHERE pedido_id = NEW.pedido_id\n  )\n  WHERE id = NEW.pedido_id;\nEND;'
    };
  }
}
