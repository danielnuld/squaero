Historial local
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Historial local — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Acciones del historial local" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <a href="EditorResult.dc.html" class="btn btn-primary" title="El texto actual se guarda como versión antes de restaurar"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l3 2"></path></svg>Restaurar esta versión</a>
        <a href="EditorResult.dc.html" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Abrir en pestaña nueva</a>
        <span style="width: 1px; height: 20px; flex: none; background: var(--border); margin: 0 4px"></span>
        <label for="lh-tab" style="font-size: var(--fs-sm); color: var(--text-dim)">Pestaña</label>
        <button id="lh-tab" type="button" class="field" aria-haspopup="listbox" style="display: inline-flex; align-items: center; gap: 8px">Consulta 1<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button>
        <span style="flex: 1"></span>
        <span style="font-size: var(--fs-sm); color: var(--text-dim)"><span style="color: var(--danger)">−2</span> · <span style="color: var(--ok)">+2</span> líneas respecto al texto actual</span>
      </div>
      <div class="help" style="flex: none; padding: 8px 14px; border-bottom: 1px solid var(--border)">Restaurar no pierde nada: el texto actual se guarda antes como una versión más.</div>
      <div style="flex: 1; min-height: 0; display: flex">
        <div role="listbox" aria-label="Versiones guardadas" style="width: 240px; flex: none; border-right: 1px solid var(--border); padding: 0 8px; overflow: hidden"><div class="lbl" style="padding: 10px 10px 4px">Hoy</div><a href="LocalHistory.dc.html" role="option" aria-selected="false" style="display: block; padding: 8px 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: transparent"><div class="" style="font-size: var(--fs-md); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600">14:21:30</div><div style="margin-top: 3px; display: flex; align-items: center; gap: 6px; font-size: var(--fs-xs); color: var(--text-dim); white-space: nowrap; overflow: hidden">Al ejecutar · 125 caracteres · igual al texto actual</div></a><a href="LocalHistory.dc.html" role="option" aria-selected="true" style="display: block; padding: 8px 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: var(--sel); box-shadow: inset 2px 0 0 var(--accent)"><div class="" style="font-size: var(--fs-md); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600">14:12:04</div><div style="margin-top: 3px; display: flex; align-items: center; gap: 6px; font-size: var(--fs-xs); color: var(--text-dim); white-space: nowrap; overflow: hidden">Automática · 110 caracteres</div></a><a href="LocalHistory.dc.html" role="option" aria-selected="false" style="display: block; padding: 8px 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: transparent"><div class="" style="font-size: var(--fs-md); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600">13:58:47</div><div style="margin-top: 3px; display: flex; align-items: center; gap: 6px; font-size: var(--fs-xs); color: var(--text-dim); white-space: nowrap; overflow: hidden">Al ejecutar · 22 caracteres</div></a><div class="lbl" style="padding: 10px 10px 4px">Ayer</div><a href="LocalHistory.dc.html" role="option" aria-selected="false" style="display: block; padding: 8px 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: transparent"><div class="" style="font-size: var(--fs-md); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600">18:40:12</div><div style="margin-top: 3px; display: flex; align-items: center; gap: 6px; font-size: var(--fs-xs); color: var(--text-dim); white-space: nowrap; overflow: hidden">Al cerrar · 210 caracteres</div></a><a href="LocalHistory.dc.html" role="option" aria-selected="false" style="display: block; padding: 8px 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: transparent"><div class="" style="font-size: var(--fs-md); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600">17:02:09</div><div style="margin-top: 3px; display: flex; align-items: center; gap: 6px; font-size: var(--fs-xs); color: var(--text-dim); white-space: nowrap; overflow: hidden">Restaurada · 45 caracteres</div></a></div>
        <div role="region" aria-label="Diferencias" style="flex: 1; min-width: 0; display: grid; grid-template-columns: 1fr 1fr; align-content: start; font-family: var(--font-mono); font-size: var(--fs-sm)">
          <div style="border-right: 1px solid var(--border); min-width: 0; overflow: hidden"><div style="height: 32px; display: flex; align-items: center; gap: 8px; padding: 0 12px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm); font-family: var(--font-ui)"><span style="font-weight: 600">Versión de las 14:12:04</span><span style="color: var(--text-dim)">automática</span></div><div style="display: flex; height: 24px; align-items: center; background: var(--danger-soft)"><span class="num" style="width: 34px; flex: none; text-align: right; padding-right: 6px; color: var(--text-dim)">1</span><span aria-label="eliminada" style="width: 14px; flex: none; color: var(--danger)">−</span><span style="white-space: pre">SELECT c.nombre, c.ciudad, p.total</span></div><div style="display: flex; height: 24px; align-items: center; background: transparent"><span class="num" style="width: 34px; flex: none; text-align: right; padding-right: 6px; color: var(--text-dim)">2</span><span aria-label="" style="width: 14px; flex: none; color: var(--text-dim)"></span><span style="white-space: pre">FROM clientes c</span></div><div style="display: flex; height: 24px; align-items: center; background: transparent"><span class="num" style="width: 34px; flex: none; text-align: right; padding-right: 6px; color: var(--text-dim)">3</span><span aria-label="" style="width: 14px; flex: none; color: var(--text-dim)"></span><span style="white-space: pre">JOIN pedidos p ON p.cliente_id = c.id</span></div><div style="display: flex; height: 24px; align-items: center; background: var(--danger-soft)"><span class="num" style="width: 34px; flex: none; text-align: right; padding-right: 6px; color: var(--text-dim)">4</span><span aria-label="eliminada" style="width: 14px; flex: none; color: var(--danger)">−</span><span style="white-space: pre"><mark style="background: color-mix(in srgb, var(--danger) 22%, transparent); color: inherit; border-radius: 2px">WHERE p.total &gt; 1000</mark>;</span></div></div>
          <div style="min-width: 0; overflow: hidden"><div style="height: 32px; display: flex; align-items: center; gap: 8px; padding: 0 12px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm); font-family: var(--font-ui)"><span style="font-weight: 600">Texto actual</span><span style="color: var(--text-dim)">Consulta 1</span></div><div style="display: flex; height: 24px; align-items: center; background: var(--ok-soft)"><span class="num" style="width: 34px; flex: none; text-align: right; padding-right: 6px; color: var(--text-dim)">1</span><span aria-label="añadida" style="width: 14px; flex: none; color: var(--ok)">+</span><span style="white-space: pre">SELECT c.nombre, c.ciudad, <mark style="background: color-mix(in srgb, var(--ok) 22%, transparent); color: inherit; border-radius: 2px">p.fecha, p.estado, </mark>p.total</span></div><div style="display: flex; height: 24px; align-items: center; background: transparent"><span class="num" style="width: 34px; flex: none; text-align: right; padding-right: 6px; color: var(--text-dim)">2</span><span aria-label="" style="width: 14px; flex: none; color: var(--text-dim)"></span><span style="white-space: pre">FROM clientes c</span></div><div style="display: flex; height: 24px; align-items: center; background: transparent"><span class="num" style="width: 34px; flex: none; text-align: right; padding-right: 6px; color: var(--text-dim)">3</span><span aria-label="" style="width: 14px; flex: none; color: var(--text-dim)"></span><span style="white-space: pre">JOIN pedidos p ON p.cliente_id = c.id</span></div><div style="display: flex; height: 24px; align-items: center; background: var(--ok-soft)"><span class="num" style="width: 34px; flex: none; text-align: right; padding-right: 6px; color: var(--text-dim)">4</span><span aria-label="añadida" style="width: 14px; flex: none; color: var(--ok)">+</span><span style="white-space: pre"><mark style="background: color-mix(in srgb, var(--ok) 22%, transparent); color: inherit; border-radius: 2px">ORDER BY p.fecha</mark>;</span></div></div>
        </div>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" color="#2f7dd6" info="Consulta 1 · 5 versiones" hint-size="1280px,24px"></dc-import>

</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return Object.assign({ theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows', yes: true, no: false }, {"tabs": [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true, "color": "#2f7dd6"}, {"label": "Historial local", "kind": "tool", "active": true, "href": "LocalHistory.dc.html"}]});
  }
}
