Transacción abierta
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Consulta 1 — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="" tx="{{yes}}" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Ejecución de la consulta" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <a href="EditorConnectionMenu.dc.html" class="field" role="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Conexión de esta pestaña: Ventas, base main" title="Conexión y base de datos de esta pestaña" style="flex: none; display: inline-flex; align-items: center; gap: 7px; padding: 0 8px; text-decoration: none; font-size: var(--fs-sm)"><span style="width: 8px; height: 8px; border-radius: 50%; background: #2f7dd6; box-shadow: 0 0 0 2px color-mix(in srgb, #2f7dd6 25%, transparent)"></span><span style="font-weight: 600">Ventas</span><span style="color: var(--text-dim)">· main</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m6 9 6 6 6-6"></path></svg></a>
        <span style="flex: none; display: inline-flex"><a href="EditorResult.dc.html" class="btn btn-primary" title="Ejecutar la sentencia actual (Ctrl+Intro)" style="border-radius: var(--r-sm) 0 0 var(--r-sm)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>Ejecutar sentencia</a><a href="EditorRunMenu.dc.html" class="btn btn-primary" aria-label="Qué ejecutar: sentencia actual, selección o script completo" aria-haspopup="menu" aria-expanded="false" style="border-radius: 0 var(--r-sm) var(--r-sm) 0; padding: 0 7px; border-left: 1px solid color-mix(in srgb, var(--accent-fg) 40%, transparent)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a></span><button type="button" class="btn btn-icon" disabled aria-label="Detener (no hay nada en ejecución)" title="Detener (Ctrl+Pausa)" style="opacity: .45"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1"></rect></svg></button>
        <span style="width: 1px; height: 20px; flex: none; background: var(--border); margin: 0 4px"></span>
        <a href="#" class="btn btn-ghost" title="Formatear SQL (Alt+Mayús+F)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"></path><path d="M4 12h10"></path><path d="M4 18h14"></path></svg>Formatear</a>
        <span style="width: 1px; height: 20px; flex: none; background: var(--border); margin: 0 4px"></span>
        <span class="seg" role="radiogroup" aria-label="Modo de transacción" style="flex: none"><a href="EditorResult.dc.html" role="radio" class="" aria-checked="false" title="Auto: cada sentencia se confirma al ejecutarse">Auto</a><a href="TxManualPending.dc.html" role="radio" class="on" aria-checked="true" title="Manual: agrupa las sentencias hasta Commit o Revertir">Manual</a><a href="TxControlsMenu.dc.html" aria-label="Opciones de transacción" aria-haspopup="menu" aria-expanded="false" style="padding: 0 6px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a></span><a href="EditorDmlResult.dc.html" class="btn" title="Commit: confirmar la transacción (Alt+Mayús+C)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--ok)"><path d="M20 6 9 17l-5-5"></path></svg>Commit</a><a href="EditorResult.dc.html" class="btn" title="Revertir la transacción (Alt+Mayús+R)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg>Revertir</a>
        <span style="flex: 1"></span>
        <a href="EditorMoreMenu.dc.html" class="btn btn-ghost" aria-haspopup="menu" aria-expanded="false" aria-label="Más: plan, historial, variables, abrir y guardar .sql, snippet" style="">Más<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
      </div>
      <div style="height: 150px; flex: none; position: relative">
        <dc-import name="SqlEditor" theme="{{theme}}" sql="{{sql}}" current="2" caret-line="2" run-range="2-2" height="150px" hint-size="100%,150px"></dc-import>
      </div>
      <div role="separator" aria-orientation="horizontal" aria-label="Redimensionar editor y resultados" title="Arrastra para redimensionar · doble clic maximiza los resultados" style="height: 7px; flex: none; display: flex; align-items: center; justify-content: center; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--surface); cursor: row-resize"><span style="width: 36px; height: 3px; border-radius: 2px; background: var(--border-strong)"></span></div>
      <div role="status" aria-label="Transacción abierta" style="height: 40px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 10px 0 14px; background: var(--warn-soft); border-bottom: 1px solid color-mix(in srgb, var(--warn) 40%, transparent); box-shadow: inset 3px 0 0 var(--warn)">
        <span style="display: flex; color: var(--warn)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2 2"></path><path d="M10 2h4"></path></svg></span>
        <span style="font-weight: 600; white-space: nowrap">Transacción abierta · 2 sentencias</span>
        <span class="help" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0" title="Solo esta sesión ve los cambios hasta el Commit">Solo esta sesión ve los cambios</span>
        <span style="flex: 1"></span>
        <a href="EditorDmlResult.dc.html" class="btn" title="Commit: confirmar la transacción (Alt+Mayús+C)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--ok)"><path d="M20 6 9 17l-5-5"></path></svg>Commit <span class="kbd">Alt+Mayús+C</span></a>
        <a href="EditorResult.dc.html" class="btn" title="Revertir la transacción (Alt+Mayús+R)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg>Revertir <span class="kbd">Alt+Mayús+R</span></a>
      </div>
      <div style="height: 36px; flex: none; display: flex; align-items: center; padding: 0 6px 0 14px; border-bottom: 1px solid var(--border)">
        <div role="tablist" aria-label="Panel de resultados" style="display: flex; align-items: center; height: 100%; min-width: 0"><a href="EditorResult.dc.html" role="tab" aria-selected="true" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid var(--accent); color: var(--text); font-weight: 600">Resultado<span class="num" style="font-weight: 400; color: var(--text-dim)">· 1 fila afectada · 6 ms</span></a><a href="EditorError.dc.html" role="tab" aria-selected="false" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid transparent; color: var(--text-dim); font-weight: 400">Mensajes</a><a href="ExplainPlan.dc.html" role="tab" aria-selected="false" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid transparent; color: var(--text-dim); font-weight: 400">Plan</a></div>
        <span style="flex: 1"></span>
        
      </div>
      <div style="flex: 1; min-height: 0; padding: 22px 28px; display: flex; gap: 14px; overflow: hidden">
        <span style="width: 36px; height: 36px; flex: none; border-radius: 999px; display: flex; align-items: center; justify-content: center; background: var(--accent-soft); color: var(--accent)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span>
        <div style="flex: 1; min-width: 0">
          <div style="font-size: var(--fs-lg); font-weight: 600">1 fila eliminada · pendiente de Commit</div>
          <div style="margin-top: 2px; color: var(--text-dim)">DELETE en <span class="mono">pedidos</span> · 6 ms · forma parte de la transacción abierta</div>
          <div style="margin-top: 14px; display: flex; gap: 8px"></div>
          <div style="margin-top: 20px; max-width: 620px">
            <div class="lbl" style="margin-bottom: 4px">Sentencias en esta transacción</div>
            <div style="display: flex; align-items: center; gap: 10px; height: 28px; border-bottom: 1px solid var(--border)"><span class="num" style="width: 16px; color: var(--text-dim); font-size: var(--fs-sm)">1</span><span class="mono" style="flex: 1; font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis">UPDATE clientes SET saldo = saldo - 120 WHERE id = 4;</span><span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">1 fila</span></div>
            <div style="display: flex; align-items: center; gap: 10px; height: 28px; border-bottom: 1px solid var(--border)"><span class="num" style="width: 16px; color: var(--text-dim); font-size: var(--fs-sm)">2</span><span class="mono" style="flex: 1; font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis">DELETE FROM pedidos WHERE id = 31;</span><span class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">1 fila</span></div>
          </div>
        </div>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" color="#2f7dd6" tx="Transacción · 2 sentencias" info="1 fila afectada · 6 ms" hint-size="1280px,24px"></dc-import>

</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return Object.assign({ theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows', yes: true, no: false }, {"tabs": [{"label": "Consulta 1", "kind": "query", "active": true, "dirty": true, "href": "EditorResult.dc.html", "color": "#2f7dd6"}, {"label": "clientes", "kind": "table", "href": "DataGrid.dc.html", "color": "#2f7dd6"}], "sql": "UPDATE clientes SET saldo = saldo - 120 WHERE id = 4;\nDELETE FROM pedidos WHERE id = 31;"});
  }
}
