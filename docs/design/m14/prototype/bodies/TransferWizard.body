Transferir · destino
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Transferir · clientes — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="clientes" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <header style="height: 56px; flex: none; display: flex; align-items: center; gap: 16px; padding: 0 24px; border-bottom: 1px solid var(--border)">
        <div style="min-width: 0">
          <h1 style="margin: 0; font-size: var(--fs-lg); font-weight: 600">Transferir datos · clientes</h1>
          <div style="font-size: var(--fs-sm); color: var(--text-dim)">Copia filas a otra conexión o tabla</div>
        </div>
        <span style="flex: 1"></span>
        <ol aria-label="Pasos del asistente" style="list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 10px; font-size: var(--fs-md)"><li aria-current="step" style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; background: var(--accent); color: var(--accent-fg)">1</span><span style="color: var(--text); font-weight: 600">Destino</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; border: 1px solid var(--border-strong); color: var(--text-dim)">2</span><span style="color: var(--text-dim)">Columnas</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; border: 1px solid var(--border-strong); color: var(--text-dim)">3</span><span style="color: var(--text-dim)">Transferir</span></li></ol>
      </header>
      <div style="flex: 1; min-height: 0; overflow: auto; padding: 24px 32px; display: flex; flex-direction: column; gap: 24px">
        <section style="display: flex; flex-direction: column; gap: 12px">
          <div style="display: flex; align-items: baseline; gap: 8px"><h2 class="lbl" style="margin: 0; font-size: var(--fs-sm)">Origen y destino</h2></div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <span style="padding-top: 5px; color: var(--text-dim)">Origen</span>
            <div style="max-width: 360px"><div style="min-height: 28px; display: flex; align-items: center; gap: 8px"><span aria-hidden="true" style="width: 8px; height: 8px; flex: none; border-radius: 50%; background: #2f7dd6"></span><span style="display: flex; color: var(--obj-table)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg></span><span style="font-weight: 600">clientes</span><span style="color: var(--text-dim)">· Ventas · main</span></div></div>
          </div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <span style="padding-top: 5px; color: var(--text-dim)">Filas</span>
            <div style="max-width: 360px"><div role="radiogroup" aria-label="Filas que se transfieren" style="display: flex; flex-direction: column; gap: 2px"><label style="display: flex; align-items: center; gap: 8px; min-height: 28px"><input type="radio" name="trows" checked="checked" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0">Toda la tabla · 12 filas</label><label style="display: flex; align-items: center; gap: 8px; min-height: 28px"><input type="radio" name="trows" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0">Solo las que cumplan un filtro…</label></div><div class="help" style="margin-top: 4px">Se lee la tabla completa, no solo la página cargada.</div></div>
          </div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <label for="dst" style="padding-top: 5px; color: var(--text-dim)">Conexión destino</label>
            <div style="max-width: 360px"><select id="dst" class="field is-focus" style="width: 100%"><option selected="selected">Elige una conexión…</option><option>Ventas copia</option><option>Producción (PostgreSQL) · solo lectura</option></select><div class="help" style="margin-top: 4px">Cualquier conexión guardada; puede ser de otro motor. Las de solo lectura no admiten escrituras.</div></div>
          </div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <label for="dstdb" style="padding-top: 5px; color: var(--text-dim)">Base de datos</label>
            <div style="max-width: 360px"><select id="dstdb" class="field" style="width: 100%" disabled="disabled"><option selected="selected">Elige primero una conexión</option></select></div>
          </div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <label for="dsttbl" style="padding-top: 5px; color: var(--text-dim)">Tabla destino</label>
            <div style="max-width: 360px"><select id="dsttbl" class="field" style="width: 100%" disabled="disabled"><option selected="selected">Elige primero una conexión</option></select><div class="help" style="margin-top: 4px">Se leen sus columnas al pulsar Siguiente.</div></div>
          </div>
        </section>
      </div>
      <footer style="height: 52px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 24px; border-top: 1px solid var(--border); background: var(--surface)">
        <button type="button" class="btn" disabled="disabled" style="opacity: .45">Atrás</button>
        
        <span style="flex: 1"></span>
        <span class="dlg-actions"><a href="TransferWizardResult.dc.html" class="btn btn-primary">Siguiente</a><a href="DataGrid.dc.html" class="btn">Cancelar</a></span>
      </footer>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="Transferir · clientes · 12 filas" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b',
      os: this.props.os ?? 'windows',
      noLine: 0,
      tabs: [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true}, {"label": "clientes", "kind": "table", "href": "DataGrid.dc.html"}, {"label": "Transferir · clientes", "kind": "tool", "active": true, "href": "#", "color": "#2f7dd6"}],
    };
  }
}
