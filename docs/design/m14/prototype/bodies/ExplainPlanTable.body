Plan de la tabla
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Plan · pedidos — Producción — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" conn-name="Producción (PostgreSQL)" conn-color="#c4302b" safe="{{yes}}" second="{{no}}" selected="pedidos" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Acciones del plan" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <a href="ExplainPlanTable.dc.html" class="btn btn-primary" title="Refrescar el plan (F5)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg>Refrescar</a>
        <span style="width: 1px; height: 20px; flex: none; background: var(--border); margin: 0 4px"></span>
        <a href="ExplainPlan.dc.html" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path><path d="m9 13-2 2 2 2"></path><path d="m13 13 2 2-2 2"></path></svg>Abrir en el editor</a>
        <button type="button" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>Copiar plan</button>
        <span style="flex: 1"></span>
        <span class="chip" style="background: var(--hover); color: var(--text-dim); font-weight: 500"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>Producción · solo lectura</span>
      </div>
      <div style="flex: none; padding: 12px 16px; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 8px">
        <div style="display: flex; align-items: center; gap: 8px"><span class="lbl">Consulta analizada</span><span style="flex: 1"></span>
          <span class="chip" style="background: var(--hover); color: var(--text-dim)">Coste total 88.10</span><span class="chip" style="background: var(--hover); color: var(--text-dim)">2.3 ms</span><span class="chip" style="background: var(--hover); color: var(--text-dim)">1000 filas</span></div>
        <code class="mono" style="font-size: var(--fs-sm); color: var(--text-dim)"><span style="color: var(--syntax-keyword)">SELECT</span> * <span style="color: var(--syntax-keyword)">FROM</span> pedidos <span style="color: var(--syntax-keyword)">ORDER BY</span> fecha <span style="color: var(--syntax-keyword)">DESC LIMIT</span> <span style="color: var(--syntax-number)">1000</span></code>
      </div>
      <div role="toolbar" aria-label="Opciones del plan" style="height: 36px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 6px 0 10px; border-bottom: 1px solid var(--border)">
        <span class="seg" role="radiogroup" aria-label="Vista del plan"><a href="#" role="radio" class="on" aria-checked="true">Árbol</a><a href="#" role="radio" aria-checked="false">Tabla</a><a href="#" role="radio" aria-checked="false">Texto</a></span>
        <label style="display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-sm); white-space: nowrap"><input type="checkbox" checked style="accent-color: var(--accent); margin: 0">Con ANALYZE <span style="color: var(--text-dim)">(ejecuta la consulta)</span></label>
        <span class="help" style="display: inline-flex; align-items: center; gap: 10px; white-space: nowrap"><span style="display: inline-flex; align-items: center; gap: 5px"><span style="width: 14px; height: 8px; border-radius: 4px; background: var(--accent)"></span>Coste propio</span><span style="display: inline-flex; align-items: center; gap: 5px"><span style="width: 14px; height: 8px; border-radius: 4px; background: var(--warn)"></span>Nodo más costoso</span><span style="display: inline-flex; align-items: center; gap: 5px"><span style="width: 14px; height: 3px; border-radius: 2px; background: var(--type-dot-num)"></span>Filas reales</span></span>
        <span style="flex: 1"></span>
        <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim); white-space: nowrap">3 nodos · 14:32:40</span>
        <a href="ExplainPlanTable.dc.html" class="btn btn-icon" aria-label="Refrescar el plan (F5)" title="Refrescar el plan (F5)" style="width: 28px; height: 28px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></a>
      </div>
      <div style="flex: 1; min-height: 0; display: flex"><div role="tree" aria-label="Plan de ejecución" style="flex: 1; min-width: 0; overflow: hidden"><div style="display: grid; grid-template-columns: 1fr 120px 150px 70px; height: 30px; align-items: center; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm); font-weight: 600"><span style="padding: 0 10px; ">Operación</span><span style="padding: 0 10px; text-align: right;">Filas (est. / reales)</span><span style="padding: 0 10px; text-align: right;">Coste propio</span><span style="padding: 0 10px; text-align: right;">Tiempo</span></div><a href="#" role="treeitem" aria-level="1" aria-selected="false" class="" style="display: grid; grid-template-columns: 1fr 120px 150px 70px; align-items: center; height: 36px; text-decoration: none; color: var(--text); border-bottom: 1px solid var(--border); background: transparent"><span style="display: flex; align-items: center; gap: 6px; padding-left: 10px; min-width: 0"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim); flex: none"><path d="m6 9 6 6 6-6"></path></svg><span style="font-weight: 600; white-space: nowrap">Limit</span><span class="mono" style="font-size: var(--fs-sm); color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis">1000 filas</span></span><span style="padding: 0 10px; display: flex; flex-direction: column; align-items: flex-end; gap: 3px"><span class="mono num" style="font-size: var(--fs-sm)">1000 <span style="color: var(--text-dim)">/</span> 1000</span><span style="width: 90px; height: 3px; border-radius: 2px; background: var(--hover)"><span style="display: block; width: 81%; height: 3px; border-radius: 2px; background: var(--type-dot-num)"></span></span></span><span style="padding: 0 10px; display: flex; align-items: center; gap: 8px"><span style="flex: 1; height: 8px; border-radius: 4px; background: var(--hover)"><span style="display: block; width: 2%; height: 8px; border-radius: 4px; background: var(--accent)"></span></span><span class="mono num" style="width: 34px; text-align: right; font-size: var(--fs-sm); color: var(--text-dim)">2 %</span></span><span class="mono num" style="padding: 0 10px; text-align: right; font-size: var(--fs-sm); color: var(--text-dim)">2.3 ms</span></a><a href="#" role="treeitem" aria-level="2" aria-selected="true" class="focus-in" style="display: grid; grid-template-columns: 1fr 120px 150px 70px; align-items: center; height: 36px; text-decoration: none; color: var(--text); border-bottom: 1px solid var(--border); background: var(--sel)"><span style="display: flex; align-items: center; gap: 6px; padding-left: 32px; min-width: 0"><span style="width: 10px; height: 16px; flex: none; margin-top: -12px; border-left: 1px solid var(--border-strong); border-bottom: 1px solid var(--border-strong); border-bottom-left-radius: 4px"></span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim); flex: none"><path d="m6 9 6 6 6-6"></path></svg><span style="font-weight: 600; white-space: nowrap">Sort</span><span class="mono" style="font-size: var(--fs-sm); color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis">clave: fecha DESC · top-N heapsort</span></span><span style="padding: 0 10px; display: flex; flex-direction: column; align-items: flex-end; gap: 3px"><span class="mono num" style="font-size: var(--fs-sm)">1240 <span style="color: var(--text-dim)">/</span> 1000</span><span style="width: 90px; height: 3px; border-radius: 2px; background: var(--hover)"><span style="display: block; width: 81%; height: 3px; border-radius: 2px; background: var(--type-dot-num)"></span></span></span><span style="padding: 0 10px; display: flex; align-items: center; gap: 8px"><span style="flex: 1; height: 8px; border-radius: 4px; background: var(--hover)"><span style="display: block; width: 25%; height: 8px; border-radius: 4px; background: var(--accent)"></span></span><span class="mono num" style="width: 34px; text-align: right; font-size: var(--fs-sm); color: var(--text-dim)">25 %</span></span><span class="mono num" style="padding: 0 10px; text-align: right; font-size: var(--fs-sm); color: var(--text-dim)">2.1 ms</span></a><a href="#" role="treeitem" aria-level="3" aria-selected="false" class="" style="display: grid; grid-template-columns: 1fr 120px 150px 70px; align-items: center; height: 36px; text-decoration: none; color: var(--text); border-bottom: 1px solid var(--border); background: transparent"><span style="display: flex; align-items: center; gap: 6px; padding-left: 54px; min-width: 0"><span style="width: 10px; height: 16px; flex: none; margin-top: -12px; border-left: 1px solid var(--border-strong); border-bottom: 1px solid var(--border-strong); border-bottom-left-radius: 4px"></span><span style="width: 12px; flex: none"></span><span style="font-weight: 600; white-space: nowrap">Seq Scan</span><span class="mono" style="font-size: var(--fs-sm); color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis">pedidos</span><span class="chip" style="height: 18px; background: var(--warn-soft); color: var(--warn)">Más costoso</span></span><span style="padding: 0 10px; display: flex; flex-direction: column; align-items: flex-end; gap: 3px"><span class="mono num" style="font-size: var(--fs-sm)">1240 <span style="color: var(--text-dim)">/</span> 1240</span><span style="width: 90px; height: 3px; border-radius: 2px; background: var(--hover)"><span style="display: block; width: 100%; height: 3px; border-radius: 2px; background: var(--type-dot-num)"></span></span></span><span style="padding: 0 10px; display: flex; align-items: center; gap: 8px"><span style="flex: 1; height: 8px; border-radius: 4px; background: var(--hover)"><span style="display: block; width: 73%; height: 8px; border-radius: 4px; background: var(--warn)"></span></span><span class="mono num" style="width: 34px; text-align: right; font-size: var(--fs-sm); color: var(--text-dim)">73 %</span></span><span class="mono num" style="padding: 0 10px; text-align: right; font-size: var(--fs-sm); color: var(--text-dim)">0.9 ms</span></a></div><aside aria-label="Detalle del nodo" style="width: 270px; flex: none; border-left: 1px solid var(--border); padding: 12px 16px; overflow: hidden"><div style="font-weight: 600; font-size: var(--fs-lg)">Sort · pedidos</div><div style="margin-top: 6px"><span class="chip" style="background: var(--accent-soft); color: var(--accent-text)">25 % del coste total</span></div><dl style="margin: 12px 0 0; display: grid; grid-template-columns: 96px 1fr; gap: 6px 10px; font-size: var(--fs-md)"><dt style="color: var(--text-dim)">Clave</dt><dd class="mono" style="margin: 0; font-size: var(--fs-sm);">fecha DESC</dd><dt style="color: var(--text-dim)">Método</dt><dd class="mono" style="margin: 0; font-size: var(--fs-sm);">top-N heapsort</dd><dt style="color: var(--text-dim)">Memoria</dt><dd class="mono" style="margin: 0; font-size: var(--fs-sm);">92 kB</dd><dt style="color: var(--text-dim)">Filas est.</dt><dd class="mono" style="margin: 0; font-size: var(--fs-sm);">1240</dd><dt style="color: var(--text-dim)">Filas reales</dt><dd class="mono" style="margin: 0; font-size: var(--fs-sm);">1000</dd><dt style="color: var(--text-dim)">Coste</dt><dd class="mono" style="margin: 0; font-size: var(--fs-sm);">83.90 … 86.00</dd><dt style="color: var(--text-dim)">Tiempo real</dt><dd class="mono" style="margin: 0; font-size: var(--fs-sm);">2.1 ms</dd></dl><div class="help" style="margin-top: 14px; padding-top: 10px; border-top: 1px solid var(--border); line-height: 1.5">Ordena en memoria y se queda con las primeras 1000 filas; no necesita escribir en disco.</div></aside></div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Producción" db="ventas" color="#c4302b" safe="{{yes}}" info="Plan · 3 nodos · 2.3 ms" hint-size="1280px,24px"></dc-import>

</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return Object.assign({ theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows', yes: true, no: false }, {"tabs": [{"label": "pedidos", "kind": "table", "href": "DataGrid.dc.html", "color": "#c4302b", "safe": true}, {"label": "Plan · pedidos", "kind": "tool", "active": true, "href": "ExplainPlanTable.dc.html", "color": "#c4302b"}]});
  }
}
