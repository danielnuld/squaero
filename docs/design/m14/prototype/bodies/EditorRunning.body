Ejecutando
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Consulta 1 — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Ejecución de la consulta" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <a href="EditorConnectionMenu.dc.html" class="field" role="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Conexión de esta pestaña: Ventas, base main" title="Conexión y base de datos de esta pestaña" style="flex: none; display: inline-flex; align-items: center; gap: 7px; padding: 0 8px; text-decoration: none; font-size: var(--fs-sm)"><span style="width: 8px; height: 8px; border-radius: 50%; background: #2f7dd6; box-shadow: 0 0 0 2px color-mix(in srgb, #2f7dd6 25%, transparent)"></span><span style="font-weight: 600">Ventas</span><span style="color: var(--text-dim)">· main</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m6 9 6 6 6-6"></path></svg></a>
        <a href="EditorMultipleResults.dc.html" class="btn btn-danger" title="Detener la ejecución (Ctrl+Pausa)" style="flex: none"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="fill: currentColor"><rect x="6" y="6" width="12" height="12" rx="1"></rect></svg>Detener</a>
        <span style="width: 1px; height: 20px; flex: none; background: var(--border); margin: 0 4px"></span>
        <a href="#" class="btn btn-ghost" title="Formatear SQL (Alt+Mayús+F)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"></path><path d="M4 12h10"></path><path d="M4 18h14"></path></svg>Formatear</a>
        <span style="width: 1px; height: 20px; flex: none; background: var(--border); margin: 0 4px"></span>
        <span class="seg" role="radiogroup" aria-label="Modo de transacción" style="flex: none"><a href="EditorResult.dc.html" role="radio" class="on" aria-checked="true" title="Auto: cada sentencia se confirma al ejecutarse">Auto</a><a href="TxManualPending.dc.html" role="radio" class="" aria-checked="false" title="Manual: agrupa las sentencias hasta Commit o Revertir">Manual</a><a href="TxControlsMenu.dc.html" aria-label="Opciones de transacción" aria-haspopup="menu" aria-expanded="false" style="padding: 0 6px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a></span>
        <span style="flex: 1"></span>
        <a href="EditorMoreMenu.dc.html" class="btn btn-ghost" aria-haspopup="menu" aria-expanded="false" aria-label="Más: plan, historial, variables, abrir y guardar .sql, snippet" style="">Más<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
      </div>
      <div style="height: 150px; flex: none; position: relative">
        <dc-import name="SqlEditor" theme="{{theme}}" sql="{{sql}}" current="3" caret-line="5" run-range="2-4" height="150px" hint-size="100%,150px"></dc-import>
      </div>
      <div role="separator" aria-orientation="horizontal" aria-label="Redimensionar editor y resultados" title="Arrastra para redimensionar · doble clic maximiza los resultados" style="height: 7px; flex: none; display: flex; align-items: center; justify-content: center; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--surface); cursor: row-resize"><span style="width: 36px; height: 3px; border-radius: 2px; background: var(--border-strong)"></span></div>
      <div style="height: 36px; flex: none; display: flex; align-items: center; padding: 0 6px 0 14px; border-bottom: 1px solid var(--border)">
        <div role="tablist" aria-label="Panel de resultados" style="display: flex; align-items: center; height: 100%; min-width: 0"><a href="EditorMultipleResults.dc.html" role="tab" aria-selected="false" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid transparent; color: var(--text-dim); font-weight: 400">1 · clientes<span class="num" style="font-weight: 400; color: var(--text-dim)">12 filas</span></a><span role="tab" aria-selected="true" aria-busy="true" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 7px; margin-right: 16px; border-bottom: 2px solid var(--accent); font-weight: 600; white-space: nowrap"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="color: var(--accent-text)"><path d="M12 3a9 9 0 1 0 9 9"></path></svg>2 · Ejecutando</span><a href="EditorError.dc.html" role="tab" aria-selected="false" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid transparent; color: var(--text-dim); font-weight: 400">Mensajes</a></div>
        <span style="flex: 1"></span>
        <div role="toolbar" aria-label="Acciones del resultado" style="display: flex; align-items: center; gap: 2px"><span role="status" aria-live="polite" class="num" style="font-size: var(--fs-sm); color: var(--text-dim); margin-right: 10px">Ejecutando · 00:04 · sentencia 2 de 3</span><a href="EditorMultipleResults.dc.html" class="btn" style="height: 28px">Cancelar</a></div>
      </div>
      <div style="flex: 1; min-height: 0">
        <dc-import name="Grid" theme="{{theme}}" columns="{{columns}}" rows="{{rows}}" loading="{{yes}}" label="Resultado de la consulta" height="100%" hint-size="100%,100%"></dc-import>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" color="#2f7dd6" info="Ejecutando script · sentencia 2 de 3 · 00:04" hint-size="1280px,24px"></dc-import>

</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return Object.assign({ theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows', yes: true, no: false }, {"tabs": [{"label": "Consulta 1", "kind": "query", "active": true, "dirty": true, "running": true, "href": "EditorRunning.dc.html", "color": "#2f7dd6"}, {"label": "clientes", "kind": "table", "href": "DataGrid.dc.html", "color": "#2f7dd6"}], "sql": "SELECT * FROM clientes;\nSELECT p.estado, COUNT(*) AS n, SUM(d.cantidad * d.precio) AS importe\n  FROM pedidos p JOIN detalle_pedido d ON d.pedido_id = p.id\n GROUP BY p.estado;\nSELECT * FROM productos;", "columns": [{"name": "estado", "type": "text", "kind": "text", "w": "200px"}, {"name": "n", "type": "integer", "kind": "num", "w": "120px"}, {"name": "importe", "type": "numeric", "kind": "num", "w": "1fr"}], "rows": []});
  }
}
