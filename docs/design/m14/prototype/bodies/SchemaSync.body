Sincronizar estructura
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Sincronizar estructura — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="clientes" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <header style="height: 56px; flex: none; display: flex; align-items: center; gap: 16px; padding: 0 24px; border-bottom: 1px solid var(--border)">
        <div style="min-width: 0">
          <h1 style="margin: 0; font-size: var(--fs-lg); font-weight: 600">Sincronizar estructura</h1>
          <div style="font-size: var(--fs-sm); color: var(--text-dim)">Genera el SQL que iguala el destino al origen</div>
        </div>
        <span style="flex: 1"></span>
        <ol aria-label="Pasos del asistente" style="list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 10px; font-size: var(--fs-md)"><li aria-current="step" style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; background: var(--accent); color: var(--accent-fg)">1</span><span style="color: var(--text); font-weight: 600">Comparar</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; border: 1px solid var(--border-strong); color: var(--text-dim)">2</span><span style="color: var(--text-dim)">Revisar</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; border: 1px solid var(--border-strong); color: var(--text-dim)">3</span><span style="color: var(--text-dim)">Aplicar</span></li></ol>
      </header>
      <div style="flex: 1; min-height: 0; overflow: auto; padding: 24px 32px; display: flex; flex-direction: column; gap: 24px">
        <section aria-label="Origen y destino" style="display: grid; grid-template-columns: 1fr 44px 1fr; align-items: stretch; max-width: 880px">
          <div style="display: flex; flex-direction: column; gap: 10px; padding: 16px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--surface)">
            <span class="lbl" style="font-size: var(--fs-sm)">Origen · el modelo</span>
            <div style="display: flex; align-items: center; gap: 8px; font-weight: 600"><span aria-hidden="true" style="width: 8px; height: 8px; flex: none; border-radius: 50%; background: #2f7dd6"></span>Ventas<span style="font-weight: 400; color: var(--text-dim)">· SQLite · conexión activa</span></div>
            <div style="display: grid; grid-template-columns: 110px 1fr; gap: 8px; align-items: center"><label for="sdb" style="color: var(--text-dim)">Base de datos</label><select id="sdb" class="field" style="width: 100%"><option selected="selected">main</option></select></div>
            <div class="help">No se modifica.</div>
          </div>
          <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; color: var(--text-dim)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg><span style="font-size: var(--fs-xs)">iguala</span></div>
          <div style="display: flex; flex-direction: column; gap: 10px; padding: 16px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--accent-soft)">
            <span class="lbl" style="font-size: var(--fs-sm)">Destino · se modifica</span>
            <div style="display: flex; align-items: center; gap: 8px; font-weight: 600"><span aria-hidden="true" style="width: 8px; height: 8px; flex: none; border-radius: 50%; background: #2e9e52"></span>Ventas copia<span style="font-weight: 400; color: var(--text-dim)">· SQLite</span></div>
            <div style="display: grid; grid-template-columns: 110px 1fr; gap: 8px; align-items: center"><label for="dconn" style="color: var(--text-dim)">Conexión</label><select id="dconn" class="field" style="width: 100%"><option selected="selected">Ventas copia</option><option>Producción (PostgreSQL) · solo lectura</option></select><label for="ddb" style="color: var(--text-dim)">Base de datos</label><select id="ddb" class="field" style="width: 100%"><option selected="selected">main</option></select></div>
            <div class="help">Aquí se aplican los cambios. Con un destino de solo lectura solo se genera el script.</div>
          </div>
        </section>
        <section style="display: flex; flex-direction: column; gap: 12px">
          <div style="display: flex; align-items: baseline; gap: 8px"><h2 class="lbl" style="margin: 0; font-size: var(--fs-sm)">Qué comparar</h2></div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <span style="padding-top: 5px; color: var(--text-dim)">Objetos</span>
            <div style="max-width: 360px"><div style="display: flex; flex-direction: column"><label style="display: flex; align-items: center; gap: 8px; min-height: 28px"><input type="checkbox" checked="checked" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0">Tablas, columnas y claves primarias</label><label style="display: flex; align-items: center; gap: 8px; min-height: 28px"><input type="checkbox" checked="checked" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0">Índices y restricciones</label><label style="display: flex; align-items: center; gap: 8px; min-height: 28px"><input type="checkbox" checked="checked" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0">Vistas</label></div></div>
          </div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 0 16px; align-items: start">
            <span style="padding-top: 5px; color: var(--text-dim)">Tablas sobrantes</span>
            <div style="max-width: 360px"><label style="display: flex; align-items: center; gap: 8px; min-height: 28px"><input type="checkbox" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0">Eliminar las tablas que solo están en el destino</label><div class="help" style="margin-top: 4px">Desmarcado: se conservan. Si lo marcas, esas sentencias aparecen en «Elimina datos» y empiezan desmarcadas.</div></div>
          </div>
        </section>
      </div>
      <footer style="height: 52px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 24px; border-top: 1px solid var(--border); background: var(--surface)">
        <button type="button" class="btn" disabled="disabled" style="opacity: .45">Atrás</button>
        
        <span style="flex: 1"></span>
        <span class="dlg-actions"><a href="SchemaSyncResult.dc.html" class="btn btn-primary">Comparar</a><a href="DataGrid.dc.html" class="btn">Cancelar</a></span>
      </footer>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="Sincronizar estructura · Ventas → Ventas copia" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b',
      os: this.props.os ?? 'windows',
      noLine: 0,
      tabs: [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true}, {"label": "clientes", "kind": "table", "href": "DataGrid.dc.html"}, {"label": "Sincronizar estructura", "kind": "tool", "active": true, "href": "#", "color": "#2f7dd6"}],
    };
  }
}
