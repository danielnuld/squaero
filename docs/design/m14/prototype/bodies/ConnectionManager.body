Conexiones
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Conexiones — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="plug" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="db" selected="" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>

      <div role="toolbar" aria-label="Acciones de conexiones" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <a href="ConnectionForm.dc.html" class="btn btn-primary"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Nueva conexión…</a>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <a href="#" class="btn btn-ghost" title="Squaero .json, DBeaver data-sources.json o Navicat .ncx"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg>Importar…</a>
        <a href="#" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"></path><path d="m7 8 5-5 5 5"></path><path d="M5 21h14"></path></svg>Exportar…</a>
        <span style="flex: 1"></span>
        <label style="position: relative; display: block; width: 260px">
          <span style="position: absolute; left: -9999px">Buscar conexiones</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position: absolute; left: 9px; top: 7px; color: var(--text-dim)"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input class="field" placeholder="Buscar por nombre, motor o servidor" style="width: 100%; padding-left: 28px; font-size: var(--fs-sm)">
        </label>
      </div>

      <div role="table" aria-label="Conexiones guardadas" style="flex: 1; min-height: 0; overflow: hidden; padding: 0 0 12px">
        <div role="row" style="{{headStyle}}">
          <span role="columnheader">Nombre</span><span role="columnheader">Destino</span><span role="columnheader">Entorno</span><span role="columnheader">Protección</span><span role="columnheader">Último uso</span><span role="columnheader"><span style="position: absolute; left: -9999px">Acciones</span></span>
        </div>
        <sc-for list="{{groups}}" as="g" hint-placeholder-count="2">
          <div role="row" style="height: 34px; display: flex; align-items: flex-end; gap: 8px; padding: 0 22px 6px">
            <span role="rowheader" class="lbl">{{g.name}}</span><span class="num" style="font-size: var(--fs-xs); color: var(--text-dim)">{{g.count}}</span>
          </div>
          <sc-for list="{{g.items}}" as="c" hint-placeholder-count="3">
            <div role="row" aria-selected="{{c.selected}}" class="{{c.cls}}" style="{{c.style}}">
              <span role="cell" style="display: flex; align-items: center; gap: 10px; min-width: 0">
                <span style="{{c.accent}}"></span>
                <span style="{{c.badge}}">{{c.mono}}</span>
                <span style="min-width: 0"><span style="display: flex; align-items: center; gap: 6px; font-weight: 500; white-space: nowrap">{{c.name}}<sc-if value="{{c.open}}"><span class="chip" style="height: 18px; background: var(--ok-soft); color: var(--ok)">Conectada</span></sc-if></span><span style="display: block; font-size: var(--fs-xs); color: var(--text-dim)">{{c.engine}}</span></span>
              </span>
              <span role="cell" class="mono" style="font-size: var(--fs-sm); color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap">{{c.target}}</span>
              <span role="cell" style="display: flex; align-items: center; gap: 6px; font-size: var(--fs-sm)"><span style="{{c.envDot}}"></span>{{c.env}}</span>
              <span role="cell">
                <sc-if value="{{c.ro}}"><span class="chip" style="background: var(--hover); color: var(--text-dim)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>Solo lectura</span></sc-if>
                <sc-if value="{{c.cw}}"><span class="chip" style="background: var(--warn-soft); color: var(--warn)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"></path></svg>Confirmar escrituras</span></sc-if>
                <sc-if value="{{c.none}}"><span style="font-size: var(--fs-sm); color: var(--text-dim)">Ninguna</span></sc-if>
              </span>
              <span role="cell" class="num" style="font-size: var(--fs-sm); color: var(--text-dim)">{{c.when}}</span>
              <span role="cell" style="display: flex; align-items: center; justify-content: flex-end; gap: 2px">
                <sc-if value="{{c.open}}"><a href="Welcome.dc.html" class="btn btn-icon" aria-label="Desconectar {{c.name}}" title="Desconectar"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 13h16z"></path><path d="M4 18h16"></path></svg></a></sc-if>
                <a href="{{c.connHref}}" class="btn" style="height: 26px; font-size: var(--fs-sm)">{{c.connLabel}}</a>
                <a href="ConnectionForm.dc.html" class="btn btn-icon" aria-label="Editar {{c.name}}" title="Editar"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg></a>
                <a href="{{c.moreHref}}" class="btn btn-icon" aria-haspopup="menu" aria-label="Más acciones de {{c.name}}: duplicar, exportar, eliminar" title="Duplicar, exportar, eliminar…"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
              </span>
            </div>
          </sc-for>
        </sc-for>
        <p class="help" style="margin: 20px 22px 0; max-width: 640px; line-height: 1.5">Eliminar una conexión solo la quita de esta lista: no toca la base de datos. Está en el menú ⋯ de cada fila y se puede deshacer.</p>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" color="#2f7dd6" info="{{status}}" hint-size="1280px,24px"></dc-import>

  <sc-if value="{{deleted}}">
    <div class="toast" role="status" style="bottom: 64px; align-items: center">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim); flex: none"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg>
      <span style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px"><span style="font-weight: 600; font-size: var(--fs-md)">Conexión eliminada</span><span style="color: var(--text-dim)">«Ventas copia» · el archivo .db sigue en su sitio</span></span>
      <a href="ConnectionManager.dc.html" class="btn focus" style="height: 26px">Deshacer</a>
      <a href="ConnectionManager.dc.html" class="btn btn-icon" aria-label="Cerrar aviso" style="width: 24px; height: 24px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg></a>
    </div>
  </sc-if>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"deleted":{"editor":"boolean","default":false},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const os = this.props.os ?? 'windows';
    const deleted = this.props.deleted === true || this.props.deleted === 'true';
    const cols = 'minmax(0, 1.3fr) minmax(0, 1.2fr) 100px 170px 80px 150px';
    const badge = (c) => `width: 28px; height: 28px; flex: none; border-radius: var(--r-sm); background: color-mix(in srgb, ${c} 16%, transparent); color: ${c}; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 11px; font-weight: 600`;
    const envC = { Desarrollo: '#2f7dd6', Pruebas: '#2e9e52', 'Producción': '#c4302b' };
    const item = ([name, engine, mono, color, target, env, prot, when, open, sel]) => ({
      name, engine, mono, target, when, open, env, badge: badge(color), selected: sel ? 'true' : 'false', cls: sel ? 'focus-in' : '',
      envDot: `width: 8px; height: 8px; border-radius: 50%; background: ${envC[env]}`,
      ro: prot === 'ro', cw: prot === 'cw', none: !prot,
      connLabel: open ? 'Abrir' : 'Conectar', connHref: 'ConnectedNoTab.dc.html', moreHref: name === 'Ventas copia' ? 'ConfirmDeleteConnection.dc.html' : '#',
      accent: `width: 3px; height: 28px; flex: none; border-radius: 2px; background: ${color}`,
      style: `height: 48px; display: grid; grid-template-columns: ${cols}; align-items: center; gap: 12px; padding: 0 16px; margin: 0 6px; border-radius: var(--r-sm); background: ${sel ? 'var(--sel)' : 'transparent'}`
    });
    let local = [
      ['Ventas', 'SQLite', 'SQ', '#2f7dd6', 'C:\\datos\\ventas.db', 'Desarrollo', '', 'ahora', true, false],
      ['Ventas copia', 'SQLite', 'SQ', '#2e9e52', 'C:\\datos\\ventas_copia.db', 'Pruebas', '', 'hace 3 días', false, !deleted],
      ['Eventos', 'MongoDB', 'MG', '#9b6ad6', 'localhost:27017/eventos', 'Desarrollo', '', '2 oct', false, false]];
    if (deleted) local = local.filter((r) => r[0] !== 'Ventas copia');
    const groups = [
      { name: 'Local', items: local.map(item) },
      { name: 'Servidores', items: [
        ['Producción', 'PostgreSQL 16', 'PG', '#c4302b', 'db.interno:5432/ventas', 'Producción', 'ro', 'ayer', false, false],
        ['Producción (MySQL)', 'MySQL 8.4', 'MY', '#c4302b', 'db.interno:3306/ventas', 'Producción', 'cw', '12 oct', false, false],
        ['Facturación', 'SQL Server 2022', 'MS', '#2fa9b8', 'sql01.interno:1433/facturas', 'Pruebas', 'ro', 'sep 2026', false, false]].map(item) }
    ].map((g) => ({ ...g, count: String(g.items.length) }));
    return {
      theme: this.props.theme ?? 'b', os, groups, deleted, status: `${deleted ? 5 : 6} conexiones guardadas · 1 abierta`,
      headStyle: `height: 32px; display: grid; grid-template-columns: ${cols}; align-items: center; gap: 12px; padding: 0 22px; border-bottom: 1px solid var(--border); font-size: var(--fs-xs); color: var(--text-dim); font-weight: 600`,
      tabs: [{ label: 'Consulta 1', kind: 'query', href: 'EditorResult.dc.html' }, { label: 'Conexiones', kind: 'tool', active: true, href: 'ConnectionManager.dc.html' }]
    };
  }
}
