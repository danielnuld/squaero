Paleta de comandos
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; position: relative; overflow: hidden; background: var(--chrome)">
  <div style="position: absolute; inset: 0"><dc-import name="DataGrid" theme="{{theme}}" os="{{os}}" hint-size="1280px,800px"></dc-import></div>
  <a href="DataGrid.dc.html" aria-label="Cerrar la paleta (Esc)" style="position: absolute; left: 0; right: 0; top: 38px; bottom: 0; background: var(--scrim); z-index: 9"></a>

  <div role="dialog" aria-modal="true" aria-label="Paleta de comandos" style="position: absolute; top: 4px; left: 320px; width: 640px; display: flex; flex-direction: column; background: var(--overlay); border: 1px solid var(--border-strong); border-radius: var(--r-lg); box-shadow: var(--shadow-lg); overflow: hidden; z-index: 10">
    <div style="height: 46px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 12px 0 14px; border-bottom: 1px solid var(--border)">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--accent-text); flex: none"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <input value="{{query}}" placeholder="{{placeholder}}" role="combobox" aria-expanded="true" aria-controls="pal-results" aria-activedescendant="{{activeId}}" aria-label="Buscar comandos" style="flex: 1; min-width: 0; height: 100%; border: 0; outline: 0; background: transparent; font-size: var(--fs-lg); color: var(--text)">
      <a href="DataGrid.dc.html" class="btn btn-icon" aria-label="Cerrar la paleta (Esc)" title="Cerrar (Esc)" style="width: 28px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg></a>
    </div>

    <div role="tablist" aria-label="Ámbito de la búsqueda" style="height: 40px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 12px; border-bottom: 1px solid var(--border)">
      <sc-for list="{{scopes}}" as="s" hint-placeholder-count="4">
        <button role="tab" aria-selected="{{s.sel}}" aria-controls="pal-results" tabindex="{{s.tab}}" title="{{s.title}}" onClick="{{s.go}}" class="chip" style="{{s.style}}">{{s.label}}<sc-if value="{{s.hasCount}}"><span class="num" style="font-weight: 400; opacity: .75">{{s.count}}</span></sc-if></button>
      </sc-for>
      <span style="flex: 1"></span>
      <span class="help" style="display: flex; align-items: center; gap: 5px"><span class="kbd">Tab</span>cambia de ámbito</span>
    </div>

    <sc-if value="{{listMode}}" hint-placeholder-val="{{ true }}">
      <div role="listbox" id="pal-results" aria-label="Resultados" style="max-height: 470px; overflow: hidden; padding: 2px 6px 6px">
        <sc-for list="{{groups}}" as="g" hint-placeholder-count="3">
          <div role="group" aria-label="{{g.title}}">
            <div style="height: 28px; display: flex; align-items: flex-end; gap: 8px; padding: 0 8px 4px">
              <span class="lbl" style="flex: 1">{{g.title}}</span>
              <sc-if value="{{g.hasMore}}"><button onClick="{{g.more}}" style="height: 24px; border: 0; padding: 0 4px; background: transparent; font-size: var(--fs-sm); color: var(--accent-text)">{{g.moreLabel}}</button></sc-if>
            </div>
            <sc-for list="{{g.items}}" as="it" hint-placeholder-count="3">
              <a href="{{it.href}}" id="{{it.id}}" role="option" aria-selected="{{it.sel}}" aria-disabled="{{it.dis}}" title="{{it.why}}" style="{{it.style}}">
                <span style="{{it.iconStyle}}">
                  <sc-if value="{{it.i.query}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path><path d="m9 13-2 2 2 2"></path><path d="m13 13 2 2-2 2"></path></svg></sc-if>
                  <sc-if value="{{it.i.refresh}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></sc-if>
                  <sc-if value="{{it.i.plus}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></sc-if>
                  <sc-if value="{{it.i.table}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg></sc-if>
                  <sc-if value="{{it.i.view}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg></sc-if>
                  <sc-if value="{{it.i.trigger}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"></path></svg></sc-if>
                  <sc-if value="{{it.i.function}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 20c2 0 2.5-1.5 3-4l2-10c.5-2.5 1-4 3-4"></path><path d="M7 10h9"></path></svg></sc-if>
                  <sc-if value="{{it.i.settings}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path></svg></sc-if>
                  <sc-if value="{{it.i.help}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg></sc-if>
                  <sc-if value="{{it.i.monitor}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"></path></svg></sc-if>
                  <sc-if value="{{it.i.clock}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2 2"></path><path d="M10 2h4"></path></svg></sc-if>
                  <sc-if value="{{it.i.users}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="4"></circle><path d="M2 21v-1a6 6 0 0 1 12 0v1"></path><path d="M16 4a4 4 0 0 1 0 8"></path><path d="M22 21v-1a6 6 0 0 0-4-5.6"></path></svg></sc-if>
                  <sc-if value="{{it.i.er}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="6" rx="1"></rect><rect x="14" y="15" width="7" height="6" rx="1"></rect><path d="M6.5 9v3a2 2 0 0 0 2 2h7a2 2 0 0 1 2 2v-1"></path></svg></sc-if>
                  <sc-if value="{{it.i.builder}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1"></rect><rect x="14" y="3" width="7" height="5" rx="1"></rect><rect x="14" y="12" width="7" height="9" rx="1"></rect><rect x="3" y="16" width="7" height="5" rx="1"></rect></svg></sc-if>
                  <sc-if value="{{it.i.notebook}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="15" height="20" rx="2"></rect><path d="M9 2v20"></path><path d="M2 7h4M2 12h4M2 17h4"></path></svg></sc-if>
                  <sc-if value="{{it.i.import}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg></sc-if>
                  <sc-if value="{{it.i.transfer}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h14l-4-4"></path><path d="M20 16H6l4 4"></path></svg></sc-if>
                  <sc-if value="{{it.i.sync}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3L20 9"></path><path d="M20 4v5h-5"></path><path d="M20 12a8 8 0 0 1-14 5.3L4 15"></path><path d="M4 20v-5h5"></path></svg></sc-if>
                  <sc-if value="{{it.i.backup}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="5" rx="1"></rect><path d="M4 9v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9"></path><path d="M10 13h4"></path></svg></sc-if>
                  <sc-if value="{{it.i.bookmark}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg></sc-if>
                  <sc-if value="{{it.i.history}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l3 2"></path></svg></sc-if>
                  <sc-if value="{{it.i.search}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></sc-if>
                </span>
                <span style="flex: 1; min-width: 0; display: flex; align-items: baseline; gap: 8px; overflow: hidden; white-space: nowrap">
                  <span style="{{it.labelStyle}}">{{it.pre}}<span style="color: var(--accent-text); font-weight: 700">{{it.mid}}</span>{{it.post}}</span>
                  <span style="{{it.subStyle}}">{{it.sub}}</span>
                </span>
                <span style="display: flex; gap: 3px; flex: none">
                  <sc-if value="{{it.hasKey}}"><span class="kbd">{{it.key}}</span></sc-if>
                </span>
              </a>
            </sc-for>
          </div>
        </sc-for>
      </div>
    </sc-if>

    <sc-if value="{{snipMode}}" hint-placeholder-val="{{ false }}">
      <div style="height: 318px; display: flex">
        <div role="listbox" aria-label="Snippets" style="width: 248px; flex: none; padding: 6px; border-right: 1px solid var(--border); overflow: hidden; display: flex; flex-direction: column; gap: 2px">
          <sc-for list="{{snips}}" as="s" hint-placeholder-count="4">
            <button role="option" aria-selected="{{s.sel}}" onClick="{{s.go}}" style="{{s.style}}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; color: var(--accent-text); margin-top: 2px"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
              <span style="flex: 1; min-width: 0"><span style="display: block; font-weight: 500">{{s.label}}</span><span style="display: block; font-size: var(--fs-xs); color: var(--text-dim)">{{s.sub}}</span></span>
            </button>
          </sc-for>
        </div>
        <div style="flex: 1; min-width: 0; display: flex; flex-direction: column">
          <div style="padding: 12px 14px 2px; display: flex; align-items: center; gap: 8px">
            <span style="font-weight: 600; font-size: var(--fs-lg)">{{snip.label}}</span>
            <span class="chip" style="background: var(--hover); color: var(--text)"><span style="{{snip.dot}}"></span>{{snip.conn}}</span>
          </div>
          <div style="padding: 0 14px 10px; font-size: var(--fs-sm); color: var(--text-dim)">{{snip.desc}}</div>
          <div style="flex: 1; min-height: 0; border-top: 1px solid var(--border)">
            <dc-import name="SqlEditor" theme="{{theme}}" sql="{{snip.sql}}" current="0" height="100%" hint-size="100%,100%"></dc-import>
          </div>
          <div style="flex: none; display: flex; align-items: center; gap: 6px; padding: 8px 10px; border-top: 1px solid var(--border)">
            <a href="SnippetsTool.dc.html" class="btn btn-ghost" style="height: 26px">Editar…</a>
            <span class="help" style="flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">Se ejecuta en {{snip.target}}</span>
            <a href="EditorEmpty.dc.html" class="btn" title="Insertar en el cursor ({{snip.kIns}})" style="height: 26px">Insertar</a>
            <a href="EditorResult.dc.html" class="btn btn-primary" title="Abrir en una pestaña nueva ({{snip.kOpen}})" style="height: 26px">Abrir</a>
          </div>
        </div>
      </div>
    </sc-if>

    <sc-if value="{{empty}}" hint-placeholder-val="{{ false }}">
      <div style="padding: 36px 24px 32px; display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center">
        <span style="font-weight: 600; font-size: var(--fs-lg)">Sin resultados para «{{query}}»</span>
        <span style="font-size: var(--fs-sm); color: var(--text-dim)">Prueba con otro ámbito o busca el texto dentro de los datos.</span>
        <a href="DataSearchResults.dc.html" class="btn btn-primary" style="margin-top: 10px">Buscar en los datos</a>
      </div>
    </sc-if>

    <div style="height: 34px; flex: none; display: flex; align-items: center; gap: 16px; padding: 0 14px; border-top: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm); color: var(--text-dim)">
      <sc-for list="{{hints}}" as="h" hint-placeholder-count="4">
        <span style="display: flex; align-items: center; gap: 5px"><span class="kbd">{{h.key}}</span>{{h.label}}</span>
      </sc-for>
      <span style="flex: 1"></span>
      <span class="num">{{countLabel}}</span>
    </div>
  </div>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"scope":{"editor":"enum","options":["todo","objetos","acciones","snippets"],"default":"todo"},"query":{"editor":"text","default":""},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const p = this.props;
    const os = p.os ?? 'windows';
    const mac = os === 'macos';
    const MOD = { Control: ['⌃', 0], Alt: ['⌥', 1], 'Mayús': ['⇧', 2], Ctrl: ['⌘', 3] };
    const KEY = { Intro: '↩', Supr: '⌫', Tab: '⇥' };
    const fmt = (s) => {
      if (!s) return '';
      const ks = s.endsWith('++') ? [...s.slice(0, -2).split('+'), '+'] : s.split('+');
      if (!mac) return ks.join('+');
      return ks.filter((k) => MOD[k]).sort((a, b) => MOD[a][1] - MOD[b][1]).map((k) => MOD[k][0]).join('') + ks.filter((k) => !MOD[k]).map((k) => KEY[k] ?? k).join('');
    };
    const scope = this.state.scope ?? p.scope ?? 'todo';
    const query = p.query ?? '';
    const q = query.trim().toLowerCase();
    const A = (icon, label, href, key = '', sub = '', kw = '', why = '') => ({ icon, label, href, key, sub, kw, why });
    const SNIPS = [
      { label: 'Clientes activos', sub: 'Ventas · usado hace 2 días', conn: 'Ventas', color: '#2f7dd6', desc: 'Clientes con la marca de activo, ordenados por nombre.', sql: 'SELECT id, nombre, email, ciudad\nFROM clientes\nWHERE activo = 1\nORDER BY nombre;' },
      { label: 'Ventas por estado', sub: 'Ventas · usado la semana pasada', conn: 'Ventas', color: '#2f7dd6', desc: 'Número de pedidos y total vendido por estado del pedido.', sql: 'SELECT estado, COUNT(*) AS pedidos, SUM(total) AS total\nFROM pedidos\nGROUP BY estado\nORDER BY total DESC;' },
      { label: 'Productos sin existencias', sub: 'Ventas · usado hace un mes', conn: 'Ventas', color: '#2f7dd6', desc: 'Productos que ya no tienen unidades en almacén.', sql: 'SELECT id, nombre, precio\nFROM productos\nWHERE existencias = 0;' },
      { label: 'Top clientes por saldo', sub: 'Cualquier conexión', conn: 'Cualquier conexión', color: '', desc: 'Los diez clientes con mayor saldo pendiente.', sql: 'SELECT nombre, ciudad, saldo\nFROM clientes\nORDER BY saldo DESC\nLIMIT 10;' }];
    const NO = 'No disponible en SQLite';
    const G = {
      acciones: ['Acciones', 'acciones', [A('query', 'Nueva consulta', 'EditorEmpty.dc.html', 'Ctrl+T', 'en Ventas'), A('settings', 'Ajustes', 'SettingsGeneral.dc.html', 'Ctrl+,'),
        A('help', 'Atajos de teclado', 'ShortcutsHelp.dc.html', 'F1'), A('view', 'Cambiar tema claro / oscuro', 'CommandPalette.dc.html', '', 'sin atajo', 'tema'),
        A('refresh', 'Desconectar', 'ConnectedNoTab.dc.html', '', 'Ventas', 'cerrar conexion'), A('plus', 'Nueva tabla', 'NewTableDesigner.dc.html', '', 'en main'),
        A('table', 'Lista de objetos de la base activa', 'ObjectList.dc.html')]],
      objetos: ['Objetos', 'objetos', [A('table', 'clientes', 'DataGrid.dc.html', '', 'tabla · main · 12 filas'), A('table', 'detalle_pedido', 'DataGrid.dc.html', '', 'tabla · main · 20 filas'),
        A('table', 'pedidos', 'DataGrid.dc.html', '', 'tabla · main · 8 filas'), A('table', 'productos', 'DataGrid.dc.html', '', 'tabla · main · 8 filas'),
        A('view', 'ventas_por_ciudad', 'ViewData.dc.html', '', 'vista · main'), A('trigger', 'trg_pedidos_total', 'Triggers.dc.html', '', 'trigger · pedidos')]],
      snippets: ['Snippets', 'snippets', SNIPS.map((s) => A('bookmark', s.label, 'EditorResult.dc.html', '', s.sub))],
      herramientas: ['Herramientas', 'acciones', [A('er', 'Diagrama ER', 'ErDiagram.dc.html'), A('builder', 'Constructor de consultas', 'QueryBuilder.dc.html'),
        A('notebook', 'Notebook', 'Notebook.dc.html'), A('function', 'Rutinas y funciones', 'Routines.dc.html'), A('trigger', 'Triggers', 'Triggers.dc.html'),
        A('import', 'Importar datos', 'ImportWizard.dc.html'), A('transfer', 'Transferir datos', 'TransferWizard.dc.html'),
        A('sync', 'Sincronizar esquema', 'SchemaSync.dc.html'), A('backup', 'Copia de seguridad y restauración', 'BackupRestore.dc.html'),
        A('monitor', 'Monitor del servidor', '#', '', NO, '', 'SQLite es una base embebida: no hay servidor que monitorizar'),
        A('clock', 'Consultas lentas', '#', '', NO, '', 'SQLite no registra consultas lentas'),
        A('users', 'Usuarios y permisos', '#', '', NO, '', 'SQLite no tiene usuarios ni permisos')]],
      historial: ['Historial', '', [A('history', 'SELECT nombre, ciudad FROM clientes WHERE saldo > 1000', 'EditorResult.dc.html', '', 'hace 5 min · se abre sin ejecutar'),
        A('history', 'UPDATE pedidos SET estado = \'enviado\' WHERE id = 7', 'EditorDmlResult.dc.html', '', 'ayer · se abre sin ejecutar')]]
    };
    const order = { todo: ['acciones', 'objetos', 'snippets', 'herramientas', 'historial'], objetos: ['objetos'], acciones: ['acciones', 'herramientas'], snippets: ['snippets'] };
    const limit = { acciones: 3, objetos: 4, snippets: 2, herramientas: 2, historial: 0 };
    const match = (it) => !q || it.label.toLowerCase().includes(q) || it.kw.includes(q);
    const countFor = (sc) => order[sc].reduce((n, k) => n + G[k][2].filter(match).length, 0);
    let flat = 0;
    const groups = [];
    for (const key of order[scope]) {
      const [title, target, all] = G[key];
      const hits = all.filter(match);
      const cap = scope === 'todo' && !q ? limit[key] : hits.length;
      if (!hits.length || !cap) continue;
      const items = hits.slice(0, cap).map((it) => {
        const n = flat++;
        const on = n === 0;
        const dis = !!it.why;
        const at = q ? it.label.toLowerCase().indexOf(q) : -1;
        const i = {}; i[it.icon] = true;
        const color = dis ? 'var(--text-dim)' : ({ table: 'var(--obj-table)', view: 'var(--obj-view)', trigger: 'var(--obj-trigger)', function: 'var(--obj-function)', bookmark: 'var(--accent-text)', history: 'var(--text-dim)' }[it.icon] ?? 'var(--text-dim)');
        return { ...it, i, id: `pal-opt-${n}`, sel: on ? 'true' : 'false', dis: dis ? 'true' : 'false', why: it.why || '', hasKey: !!it.key, key: fmt(it.key),
          pre: at < 0 ? it.label : it.label.slice(0, at), mid: at < 0 ? '' : it.label.slice(at, at + q.length), post: at < 0 ? '' : it.label.slice(at + q.length),
          iconStyle: `width: 18px; flex: none; display: flex; justify-content: center; color: ${color}`,
          labelStyle: `overflow: hidden; text-overflow: ellipsis; ${dis ? 'color: var(--text-dim);' : ''} ${key === 'historial' ? 'font-family: var(--font-mono); font-size: var(--fs-sm);' : ''}`,
          subStyle: `font-size: var(--fs-xs); overflow: hidden; text-overflow: ellipsis; color: var(--text-dim); ${dis ? 'font-style: italic;' : ''}`,
          style: `height: 32px; display: flex; align-items: center; gap: 10px; padding: 0 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: ${on ? 'var(--sel)' : 'transparent'}; ${on ? 'box-shadow: inset 0 0 0 2px var(--accent);' : ''}` };
      });
      const rest = hits.length - items.length;
      groups.push({ title, items, hasMore: rest > 0 && !!target, moreLabel: `Ver ${rest} más`, more: () => this.setState({ scope: target }) });
    }
    if (q && scope !== 'snippets') groups.push({ title: 'Buscar en los datos', hasMore: false, moreLabel: '', more: null, items: [{ i: { search: true }, id: 'pal-opt-data', label: '', pre: `Buscar «${query}» en todas las tablas`, mid: '', post: '', sub: 'Ventas · main', hasKey: false, key: '', href: 'DataSearchResults.dc.html', sel: 'false', dis: 'false', why: '',
      iconStyle: 'width: 18px; flex: none; display: flex; justify-content: center; color: var(--text-dim)', labelStyle: 'overflow: hidden; text-overflow: ellipsis',
      subStyle: 'font-size: var(--fs-xs); color: var(--text-dim)',
      style: 'height: 32px; display: flex; align-items: center; gap: 10px; padding: 0 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text)' }] });

    const snipHits = SNIPS.filter((s) => !q || s.label.toLowerCase().includes(q));
    const si = Math.min(this.state.snip ?? 0, Math.max(0, snipHits.length - 1));
    const snips = snipHits.map((s, n) => ({ ...s, sel: n === si ? 'true' : 'false', go: () => this.setState({ snip: n }),
      style: `width: 100%; display: flex; align-items: flex-start; gap: 10px; padding: 7px 10px; border: 0; border-radius: var(--r-sm); text-align: left; background: ${n === si ? 'var(--sel)' : 'transparent'}; ${n === si ? 'box-shadow: inset 0 0 0 2px var(--accent);' : ''}` }));
    const cur = snipHits[si] ?? SNIPS[0];
    const snip = { ...cur, kIns: fmt('Alt+Intro'), kOpen: fmt('Intro'),
      target: cur.color ? `${cur.conn} · main` : 'la conexión de la pestaña activa (Ventas · main)',
      dot: `width: 8px; height: 8px; border-radius: 50%; background: ${cur.color || 'var(--text-dim)'}` };
    const snipMode = scope === 'snippets' && snipHits.length > 0;
    const listMode = scope !== 'snippets' && groups.some((g) => g.title !== 'Buscar en los datos');
    const S = [['todo', 'Todo', 'Ctrl+K'], ['objetos', 'Objetos', 'Ctrl+P'], ['acciones', 'Acciones', ''], ['snippets', 'Snippets', 'Ctrl+J']];
    const scopes = S.map(([id, label, k]) => {
      const on = id === scope;
      return { label, title: k ? `${label} (${fmt(k)})` : label, sel: on ? 'true' : 'false', tab: on ? '0' : '-1', hasCount: !!q, count: String(countFor(id)), go: () => this.setState({ scope: id, snip: 0 }),
        style: `border: 1px solid ${on ? 'transparent' : 'var(--border-strong)'}; background: ${on ? 'var(--accent-soft)' : 'transparent'}; color: ${on ? 'var(--accent-text)' : 'var(--text-dim)'}; font-weight: ${on ? 600 : 500}; height: 24px; padding: 0 10px` };
    });
    const placeholder = { todo: 'Buscar tablas, acciones, snippets…', objetos: 'Buscar tablas, vistas… (Intro para abrir)', acciones: 'Buscar acciones y herramientas', snippets: 'Buscar snippets' }[scope];
    const H = (k, label) => ({ key: fmt(k), label });
    const hints = scope === 'snippets'
      ? [H('Intro', 'Abrir'), H('Ctrl+Intro', 'Ejecutar'), H('Alt+Intro', 'Insertar en el cursor'), H('Esc', 'Cerrar')]
      : [H('↑↓', 'Navegar'), H('Intro', 'Abrir'), H('Esc', 'Cerrar')];
    const total = scope === 'snippets' ? snipHits.length : countFor(scope);
    return {
      theme: p.theme ?? 'b', os, query, placeholder, scopes, groups, hints, snips, snip,
      activeId: snipMode ? '' : 'pal-opt-0',
      listMode, snipMode, empty: !listMode && !snipMode,
      countLabel: q ? `${total} resultados` : `${total} elementos`
    };
  }
}
