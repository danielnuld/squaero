Notebook SQL
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Análisis de ventas — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>

      <div role="toolbar" aria-label="Acciones del notebook" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <button type="button" class="field" aria-haspopup="listbox" title="Conexión y base de datos del notebook" style="height: 28px; display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-sm)"><span style="width: 8px; height: 8px; border-radius: 50%; background: #2f7dd6"></span><b style="font-weight: 600">Ventas</b><span style="color: var(--text-dim)">· main</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button>
        <button type="button" class="btn btn-primary" title="Ejecutar todas las celdas en orden (Ctrl+Mayús+Intro)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>Ejecutar todo</button>
        <button type="button" class="btn btn-icon" disabled="disabled" aria-label="Detener (nada en ejecución)" title="Detener (nada en ejecución)" style="opacity: .45"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1"></rect></svg></button>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <button type="button" class="btn" aria-haspopup="listbox" title="Abrir otro notebook (Ctrl+O)" style="min-width: 190px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><rect x="5" y="2" width="15" height="20" rx="2"></rect><path d="M9 2v20"></path><path d="M2 7h4M2 12h4M2 17h4"></path></svg><span style="flex: 1; font-weight: 600">Análisis de ventas</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button>
        <button type="button" class="btn btn-icon" aria-label="Nuevo notebook" title="Nuevo notebook"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></button>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <button type="button" class="btn btn-ghost" aria-haspopup="menu"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"></path><path d="m7 8 5-5 5 5"></path><path d="M5 21h14"></path></svg>Exportar<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button>
        <span style="flex: 1"></span>
        <span style="font-size: var(--fs-sm); color: var(--text-dim)">Guardado hace 1 min</span>
        <button type="button" class="btn btn-ghost" aria-haspopup="menu" title="Renombrar, duplicar, eliminar notebook…">Más<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></button>
      </div>

      <div style="height: 40px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 16px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm)">
        <span class="lbl">Parámetros</span>
        <label style="display: inline-flex; align-items: center; gap: 0; border: 1px solid var(--border-strong); border-radius: var(--r-sm); overflow: hidden; background: var(--content)">
          <span class="mono" style="padding: 0 8px; height: 24px; display: flex; align-items: center; background: var(--accent-soft); color: var(--accent-text); font-size: var(--fs-sm)">:ciudad</span>
          <input value="Hermosillo" aria-label="Valor de :ciudad" style="width: 110px; height: 24px; border: 0; outline: none; padding: 0 8px; background: transparent; font-size: var(--fs-sm)">
        </label>
        <button type="button" class="btn btn-ghost" style="height: 24px; font-size: var(--fs-sm); color: var(--accent-text)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Parámetro</button>
        <span class="help">Se envían como parámetros enlazados (:nombre), nunca pegados en el SQL.</span>
      </div>

      <div style="flex: 1; min-height: 0; overflow: hidden; background: var(--surface)">
        <div style="max-width: 860px; margin: 0 auto; padding: 16px 24px 0 8px; display: flex; flex-direction: column; gap: 12px">

          <div style="display: flex; gap: 8px">
            <span class="mono" style="width: 40px; flex: none; padding-top: 10px; text-align: right; font-size: var(--fs-xs); color: var(--text-dim)">MD</span>
            <section aria-label="Celda Markdown" title="Doble clic para editar" style="flex: 1; min-width: 0; padding: 12px 16px; border: 1px solid transparent; border-radius: var(--r-md)">
              <h2 style="margin: 0 0 6px; font-size: var(--fs-xl); font-weight: 600">Ventas por ciudad</h2>
              <p style="margin: 0; color: var(--text-dim); line-height: 1.5">Resumen semanal para el equipo comercial. Cambia <span class="mono" style="color: var(--accent-text)">:ciudad</span> en Parámetros para ver el detalle de otra ciudad. Los importes salen de <b style="color: var(--text)">pedidos.total</b>.</p>
            </section>
          </div>

          <div style="display: flex; gap: 8px">
            <span class="mono" style="width: 40px; flex: none; padding-top: 10px; text-align: right; font-size: var(--fs-xs); color: var(--text-dim)">[1]</span>
            <section aria-label="Celda SQL 1" style="flex: 1; min-width: 0; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--content); overflow: hidden">
              <div style="height: 100px"><dc-import name="SqlEditor" theme="{{theme}}" sql="{{sql1}}" current="0" height="100px" hint-size="100%,100px"></dc-import></div>
              <div style="height: 32px; display: flex; align-items: center; gap: 8px; padding: 0 8px 0 12px; border-top: 1px solid var(--border); font-size: var(--fs-sm); color: var(--text-dim)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--ok)"><path d="M20 6 9 17l-5-5"></path></svg>
                <span class="num">4 filas · 9 ms</span>
                <span style="flex: 1"></span>
                <a href="Chart.dc.html" class="btn btn-ghost" style="height: 24px; font-size: var(--fs-sm)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"></path><path d="M10 20V4"></path><path d="M16 20v-7"></path><path d="M22 20H2"></path></svg>Graficar</a>
                <button type="button" class="btn btn-icon" aria-label="Copiar resultado" style="width: 24px; height: 24px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></button>
              </div>
              <div style="height: 152px"><dc-import name="Grid" theme="{{theme}}" columns="{{cols1}}" rows="{{rows1}}" label="Resultado de la celda 1" height="152px" hint-size="100%,152px"></dc-import></div>
            </section>
          </div>

          <div style="display: flex; gap: 8px">
            <span class="mono" style="width: 40px; flex: none; padding-top: 44px; text-align: right; font-size: var(--fs-xs); color: var(--accent-text)">[2]</span>
            <section aria-label="Celda SQL 2 (activa)" style="flex: 1; min-width: 0; border: 1px solid var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); border-radius: var(--r-md); background: var(--content); overflow: hidden">
              <div role="toolbar" aria-label="Acciones de la celda" style="height: 34px; display: flex; align-items: center; gap: 4px; padding: 0 6px; border-bottom: 1px solid var(--border); background: var(--surface)">
                <button type="button" class="btn" title="Ejecutar esta celda (Ctrl+Intro)" style="height: 24px; font-size: var(--fs-sm); color: var(--accent-text)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>Ejecutar celda<span class="kbd">Ctrl+Intro</span></button>
                <span class="lbl" style="margin-left: 6px">SQL</span>
                <span style="flex: 1"></span>
                <button type="button" class="btn btn-ghost" style="height: 24px; font-size: var(--fs-sm)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"></path><path d="M4 12h10"></path><path d="M4 18h14"></path></svg>Formatear</button>
                <button type="button" class="btn btn-ghost" style="height: 24px; font-size: var(--fs-sm)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>SQL</button>
                <button type="button" class="btn btn-ghost" style="height: 24px; font-size: var(--fs-sm)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Markdown</button>
                <span style="width: 1px; height: 16px; background: var(--border); margin: 0 2px"></span>
                <button type="button" class="btn btn-icon" aria-label="Subir celda" style="width: 24px; height: 24px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6"></path></svg></button>
                <button type="button" class="btn btn-icon" aria-label="Bajar celda" style="width: 24px; height: 24px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button>
                <button type="button" class="btn btn-icon" aria-label="Eliminar celda (Ctrl+Z la recupera)" title="Eliminar celda (Ctrl+Z la recupera)" style="width: 24px; height: 24px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg></button>
              </div>
              <div style="height: 100px"><dc-import name="SqlEditor" theme="{{theme}}" sql="{{sql2}}" current="3" caret-line="3" height="100px" hint-size="100%,100px"></dc-import></div>
              <div style="height: 32px; display: flex; align-items: center; gap: 8px; padding: 0 8px 0 12px; border-top: 1px solid var(--border); font-size: var(--fs-sm); color: var(--text-dim)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--ok)"><path d="M20 6 9 17l-5-5"></path></svg>
                <span class="num">3 filas · 6 ms · :ciudad = 'Hermosillo'</span>
                <span style="flex: 1"></span>
                <a href="Chart.dc.html" class="btn btn-ghost" style="height: 24px; font-size: var(--fs-sm)">Graficar</a>
              </div>
              <div style="height: 122px"><dc-import name="Grid" theme="{{theme}}" columns="{{cols2}}" rows="{{rows2}}" label="Resultado de la celda 2" height="122px" hint-size="100%,122px"></dc-import></div>
            </section>
          </div>
        </div>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" color="#2f7dd6" info="Notebook · 3 celdas · 2 ejecutadas · celda 2, línea 3" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows',
      tabs: [{ label: 'Consulta 1', kind: 'query', href: 'EditorResult.dc.html', color: '#2f7dd6' }, { label: 'Análisis de ventas', kind: 'tool', active: true, href: 'Notebook.dc.html', color: '#2f7dd6' }],
      sql1: 'SELECT c.ciudad, COUNT(*) AS pedidos, SUM(p.total) AS importe\nFROM clientes c JOIN pedidos p ON p.cliente_id = c.id\nGROUP BY c.ciudad\nORDER BY importe DESC;',
      sql2: 'SELECT c.nombre, p.fecha, p.total\nFROM pedidos p JOIN clientes c ON c.id = p.cliente_id\nWHERE c.ciudad = :ciudad\nORDER BY p.fecha DESC;',
      cols1: [{ name: 'ciudad', type: 'text', kind: 'text', w: '1fr' }, { name: 'pedidos', type: 'bigint', kind: 'num', w: '120px' }, { name: 'importe', type: 'numeric', kind: 'num', w: '160px' }],
      rows1: [['Hermosillo', 3, '4180.00'], ['Nogales', 2, '2940.50'], ['Guaymas', 2, '1215.00'], ['Cd. Obregón', 1, '860.00']],
      cols2: [{ name: 'nombre', type: 'text', kind: 'text', w: '1fr' }, { name: 'fecha', type: 'date', kind: 'date', w: '160px' }, { name: 'total', type: 'numeric', kind: 'num', w: '160px' }],
      rows2: [['María López', '2025-06-02', '1480.00'], ['Sofía Torres', '2025-05-18', '2100.00'], ['Paola Núñez', '2025-04-30', '600.00']]
    };
  }
}
