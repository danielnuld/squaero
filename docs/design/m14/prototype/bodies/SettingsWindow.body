Ajustes · Ventana
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Ajustes — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="settings" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="SettingsNav" theme="{{theme}}" active="window" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Ventana" style="height: 44px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 10px 0 32px; border-bottom: 1px solid var(--border)">
        <h1 style="margin: 0; font-size: var(--fs-lg); font-weight: 600">Ventana</h1>
        <span class="help">Barras de la ventana principal</span>
        <span style="flex: 1"></span>
        <button class="btn btn-ghost" onClick="{{reset}}">Restablecer esta sección</button>
      </div>

      <div style="flex: 1; min-height: 0; display: flex; gap: 32px; overflow: hidden; padding: 4px 32px 24px">
        <div style="flex: 1; min-width: 0">
          <div class="lbl" style="font-size: var(--fs-sm); color: var(--text); margin: 14px 0 4px; padding-bottom: 6px; border-bottom: 1px solid var(--border)">Documento</div>
          <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); column-gap: 24px; padding: 10px 0">
            <span style="padding-top: 5px; font-weight: 500">Barra del documento</span>
            <div>
              <span class="seg" role="radiogroup" aria-label="Barra del documento"><sc-for list="{{bars}}" as="m" hint-placeholder-count="2"><button role="radio" aria-checked="{{m.checked}}" tabindex="{{m.tab}}" onClick="{{m.go}}" class="{{m.cls}}" style="{{m.style}}">{{m.label}}</button></sc-for></span>
              <div class="help" style="margin-top: 6px">{{barHelp}}</div>
            </div>
          </div>

          <div class="lbl" style="font-size: var(--fs-sm); color: var(--text); margin: 14px 0 4px; padding-bottom: 6px; border-bottom: 1px solid var(--border)">Menús · {{osName}}</div>
          <sc-if value="{{isMac}}">
            <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); column-gap: 24px; padding: 10px 0">
              <span style="font-weight: 500">Barra de menús</span>
              <div>
                <span style="display: flex; align-items: center; gap: 8px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--ok)"><path d="M20 6 9 17l-5-5"></path></svg>En la barra de menús de macOS</span>
                <div class="help" style="margin-top: 6px">En macOS los menús están siempre en la barra del sistema, con el menú Squaero (Acerca de, Ajustes <span class="kbd">⌘,</span>) y Edición estándar. No hay nada que elegir.</div>
              </div>
            </div>
          </sc-if>
          <sc-if value="{{notMac}}">
            <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); column-gap: 24px; padding: 10px 0">
              <span style="padding-top: 5px; font-weight: 500">Barra de menús</span>
              <div>
                <div role="radiogroup" aria-label="Barra de menús" style="display: flex; flex-direction: column; gap: 8px">
                  <sc-for list="{{menus}}" as="m" hint-placeholder-count="2">
                    <label style="display: flex; align-items: flex-start; gap: 8px"><input type="radio" name="menu" checked="{{m.on}}" onClick="{{m.go}}" style="accent-color: var(--accent); margin: 2px 0 0; width: 16px; height: 16px"><span><span style="display: block">{{m.label}}</span><span class="help" style="display: block">{{m.help}}</span></span></label>
                  </sc-for>
                </div>
                <div class="help" style="margin-top: 8px">{{menuHelp}}</div>
              </div>
            </div>
          </sc-if>
          <sc-if value="{{isLinux}}">
            <div style="display: grid; grid-template-columns: 160px minmax(0, 1fr); column-gap: 24px; padding: 4px 0 10px">
              <span style="font-weight: 500">Botones de la ventana</span>
              <div class="help">Siguen la disposición del escritorio (gtk-decoration-layout): a la izquierda o a la derecha, y solo los que tu sistema muestra.</div>
            </div>
          </sc-if>
        </div>

        <aside aria-label="Vista previa" style="width: 340px; flex: none; margin-top: 14px; align-self: flex-start">
          <div class="lbl" style="margin-bottom: 8px">Vista previa</div>
          <div aria-hidden="true" style="height: 220px; display: flex; flex-direction: column; border: 1px solid var(--border-strong); border-radius: var(--r-md); overflow: hidden; background: var(--chrome); box-shadow: var(--shadow-sm); font-size: 11px; color: var(--text-dim)">
            <span style="height: 22px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 8px">
              <sc-if value="{{isMac}}"><span style="display: flex; gap: 4px"><span style="width: 8px; height: 8px; border-radius: 50%; background: #ff5f57"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #febc2e"></span><span style="width: 8px; height: 8px; border-radius: 50%; background: #28c840"></span></span></sc-if>
              <sc-if value="{{inlineMenu}}"><span style="display: flex; gap: 8px; color: var(--text)"><span>Archivo</span><span>Editar</span><span>Ver</span></span></sc-if>
              <span style="flex: 1"></span><span style="width: 90px; height: 11px; border-radius: 3px; background: var(--content); border: 1px solid var(--border)"></span><span style="flex: 1"></span>
              <sc-if value="{{hamburger}}"><span style="font-size: 13px; color: var(--text)">≡</span></sc-if>
            </span>
            <sc-if value="{{classicMenu}}"><span style="height: 18px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 8px; background: var(--overlay); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); color: var(--text)">Archivo<span>Editar</span><span>Ver</span><span>Consulta</span></span></sc-if>
            <span style="flex: 1; display: flex; min-height: 0">
              <span style="width: 54px; display: flex; flex-direction: column; gap: 4px; padding: 6px 4px">
                <span style="height: 4px; border-radius: 2px; background: var(--text-faint); opacity: .5"></span><span style="height: 4px; border-radius: 2px; background: var(--text-faint); opacity: .5"></span><span style="height: 4px; border-radius: 2px; background: var(--text-faint); opacity: .5"></span>
              </span>
              <span style="flex: 1; display: flex; flex-direction: column; background: var(--content); border-top-left-radius: 6px; overflow: hidden">
                <span style="height: 16px; flex: none; background: var(--surface); border-bottom: 1px solid var(--border)"></span>
                <span style="height: 24px; flex: none; display: flex; align-items: center; gap: 5px; padding: 0 6px; border-bottom: 1px solid var(--border); background: var(--accent-soft); white-space: nowrap">
                  <span style="height: 15px; padding: 0 6px; display: flex; align-items: center; border-radius: 3px; background: var(--accent); color: var(--accent-fg); font-weight: 600">▶ {{runLabel}}</span>
                  <span style="height: 15px; padding: 0 5px; display: flex; align-items: center; gap: 3px; border: 1px solid var(--border-strong); border-radius: 3px; color: var(--text)"><span style="width: 6px; height: 6px; border-radius: 50%; background: #2f7dd6"></span>Ventas ▾</span>
                  <sc-if value="{{full}}"><span style="color: var(--text)">Formatear</span><span style="color: var(--text)">Auto</span></sc-if>
                  <span style="flex: 1"></span><span style="color: var(--text)">⋯</span>
                </span>
                <span style="flex: 1; display: flex; flex-direction: column; gap: 5px; padding: 6px">
                  <span style="height: 6px; border-radius: 2px; background: var(--zebra); box-shadow: inset 0 0 0 1px var(--border)"></span><span style="height: 6px; border-radius: 2px; background: var(--zebra); box-shadow: inset 0 0 0 1px var(--border)"></span><span style="height: 6px; border-radius: 2px; background: var(--zebra); box-shadow: inset 0 0 0 1px var(--border)"></span><span style="height: 6px; border-radius: 2px; background: var(--zebra); box-shadow: inset 0 0 0 1px var(--border)"></span>
                </span>
              </span>
            </span>
          </div>
          <div class="help" style="margin-top: 8px">{{previewNote}}</div>
        </aside>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const os = this.props.os ?? 'windows';
    const isMac = os === 'macos';
    const isLinux = os === 'linux';
    const bar = this.state.bar ?? 'Completa';
    const full = bar === 'Completa';
    const M = isLinux
      ? [['hamburger', 'Menú en la barra de cabecera (≡)', 'Como las apps de GNOME. F10 lo abre.'], ['classic', 'Barra de menús clásica', 'Archivo, Editar, Ver… bajo el título, con teclas de acceso (Alt+letra).']]
      : [['inline', 'Integrada en la barra de título', 'Ahorra una fila. Alt o F10 la enfoca; Alt+letra abre cada menú.'], ['classic', 'Barra de menús clásica', 'Una fila propia bajo el título, como en las apps Win32.']];
    const menu = this.state.menu ?? M[0][0];
    const menus = M.map(([id, label, help]) => ({ label, help, on: id === menu, go: () => this.setState({ menu: id }) }));
    const kRun = isMac ? '⌘↩' : 'Ctrl+Intro';
    return {
      os, theme: this.props.theme ?? 'b', isMac, notMac: !isMac, isLinux, full,
      osName: { windows: 'Windows', macos: 'macOS', linux: 'Linux' }[os],
      bars: ['Completa', 'Mínima'].map((label) => ({ label, checked: label === bar ? 'true' : 'false', tab: label === bar ? '0' : '-1', cls: label === bar ? 'on' : '',
        style: `border-top: 0; border-bottom: 0; border-left: 0; ${label === bar ? '' : 'background: transparent;'}`, go: () => this.setState({ bar: label }) })),
      barHelp: full ? 'Todas las acciones del documento a la vista.' : `Solo quedan Ejecutar, el selector de conexión y Más ⋯; el resto está en Más, el menú y ${isMac ? '⌘K' : 'Ctrl+K'}. Nunca se oculta la forma visible de ejecutar.`,
      menus, menuHelp: 'Se aplica al reiniciar Squaero.',
      inlineMenu: !isMac && !isLinux && menu === 'inline', classicMenu: !isMac && menu === 'classic', hamburger: isLinux && menu === 'hamburger',
      runLabel: full ? 'Ejecutar' : '',
      previewNote: full ? 'Barra completa del documento (resaltada).' : `Barra mínima: ▶ (${kRun}), conexión y Más.`,
      reset: () => this.setState({ bar: undefined, menu: undefined }),
      tabs: [{ label: 'Consulta 1', kind: 'query', href: 'EditorResult.dc.html', dirty: true, color: '#2f7dd6' }, { label: 'Ajustes', kind: 'settings', active: true, href: 'SettingsWindow.dc.html' }]
    };
  }
}
