Eliminar tabla
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; position: relative; overflow: hidden">
  <div style="position: absolute; left: 0; top: 0; width: 1280px; height: 800px">
    <dc-import name="DataGrid" theme="{{theme}}" os="{{os}}" hint-size="1280px,800px"></dc-import>
  </div>
  <div class="dlg-scrim">
    <div class="dlg" role="alertdialog" aria-modal="true" aria-labelledby="dropTitle" aria-describedby="dropDesc" style="width: 520px">
      <div class="dlg-h">
        <span style="width: 28px; height: 28px; flex: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--danger-soft); color: var(--danger)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg></span>
        <span id="dropTitle" style="flex: 1">¿Eliminar la tabla clientes?</span>
        <a href="DataGrid.dc.html" class="btn btn-icon" aria-label="Cancelar (Esc)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg></a>
      </div>
      <div class="dlg-b">
        <p id="dropDesc" style="margin: 0; line-height: 1.5">Se borrarán la tabla, sus <b>12 filas</b> y sus <b>2 índices</b> de <b>Ventas › main</b>. No se puede deshacer.</p>
        <div style="display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border-radius: var(--r-md); background: var(--warn-soft); font-size: var(--fs-sm); color: var(--text); line-height: 1.45"><span style="display: flex; flex: none; margin-top: 1px; color: var(--warn)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg></span><span><span class="mono">pedidos.cliente_id</span> referencia esta tabla: sus 8 pedidos quedarán apuntando a clientes que ya no existen.</span></div>
        <div style="display: flex; flex-direction: column; gap: 6px"><span class="lbl">Se ejecutará</span><div style="height: 40px; flex: none; display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden"><div style="flex: 1; min-height: 0"><dc-import name="SqlEditor" theme="{{theme}}" sql="{{drop}}" current="{{noLine}}" height="100%" hint-size="100%,100%"></dc-import></div></div></div>
        <div style="display: flex; flex-direction: column; gap: 6px">
          <label for="confirmName">Escribe <b class="mono" style="font-size: var(--fs-sm)">clientes</b> para confirmar</label>
          <div style="position: relative"><input id="confirmName" class="field is-focus" value="{{typedValue}}" autocomplete="off" spellcheck="false" aria-describedby="confirmHelp" style="width: 100%; font-family: var(--font-mono); font-size: var(--fs-sm)">
          <sc-if value="{{typed}}" hint-placeholder-val="{{ false }}"><span style="position: absolute; right: 10px; top: 6px; display: flex; align-items: center; gap: 4px; font-size: var(--fs-sm); color: var(--ok)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Coincide</span></sc-if></div>
          <div id="confirmHelp" class="help">Intro no elimina: pulsa el botón. Esc cancela.</div>
        </div>
      </div>
      <div class="dlg-f">
        <a href="#" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>Copiar SQL</a>
        <span style="flex: 1"></span>
        <span class="dlg-actions">
          <sc-if value="{{typed}}" hint-placeholder-val="{{ false }}"><a href="ObjectList.dc.html" class="btn btn-danger">Eliminar tabla</a></sc-if>
          <sc-if value="{{notTyped}}" hint-placeholder-val="{{ true }}"><button type="button" class="btn btn-danger" disabled="disabled" title="Escribe el nombre de la tabla para activarlo" style="opacity: .45">Eliminar tabla</button></sc-if>
          <a href="DataGrid.dc.html" class="btn">Cancelar</a>
        </span>
      </div>
    </div>
  </div>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"typed":{"editor":"boolean","default":false},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b',
      os: this.props.os ?? 'windows',
      noLine: 0,
      drop: "DROP TABLE \"main\".\"clientes\";",
      typed: !!this.props.typed,
      notTyped: !this.props.typed,
      typedValue: this.props.typed ? 'clientes' : '',
    };
  }
}
