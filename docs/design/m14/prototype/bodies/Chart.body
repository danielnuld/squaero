Gráfico
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" notif="1" window-title="Gráfico · productos — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="productos" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Opciones del gráfico" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <span class="lbl">Tipo</span><span class="seg" role="radiogroup" aria-label="Tipo de gráfico"><a href="#" class="on" role="radio" aria-checked="true">Barras</a><a href="#" role="radio" aria-checked="false">Líneas</a><a href="#" role="radio" aria-checked="false">Pastel</a></span>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <label class="lbl" for="eje">Eje</label><select id="eje" class="field" style="width: 120px"><option>sku</option><option>nombre</option></select>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <span class="lbl">Valores</span>
        <label style="display: flex; align-items: center; gap: 6px; white-space: nowrap"><input type="checkbox" checked="checked" style="accent-color: var(--accent); margin: 0">precio</label>
        <label style="display: flex; align-items: center; gap: 6px; white-space: nowrap"><input type="checkbox" style="accent-color: var(--accent); margin: 0">existencias</label>
        <span style="flex: 1"></span>
        <a href="#" class="btn btn-ghost"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"></path><path d="m7 8 5-5 5 5"></path><path d="M5 21h14"></path></svg>Guardar imagen</a>
        <a href="DataGrid.dc.html" class="btn btn-ghost"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg>Ver datos</a>
      </div>
      <div style="flex: 1; min-height: 0; padding: 20px 24px; display: flex; flex-direction: column; gap: 10px"><div style="display: flex; align-items: baseline; gap: 10px"><span style="font-size: var(--fs-lg); font-weight: 600">precio por sku</span><span style="font-size: var(--fs-sm); color: var(--text-dim)">productos · 8 filas · toda la tabla</span></div><svg width="880" height="470" viewBox="0 0 880 470" role="img" aria-label="Barras: precio por sku, 8 productos" style="display: block; font-family: var(--font-ui)"><line x1="56" x2="864" y1="430.0" y2="430.0" style="stroke: var(--border)"></line><text x="48" y="434.0" text-anchor="end" style="fill: var(--text-dim); font-size: 11px; font-variant-numeric: tabular-nums">0</text><line x1="56" x2="864" y1="311.7" y2="311.7" style="stroke: var(--border)"></line><text x="48" y="315.7" text-anchor="end" style="fill: var(--text-dim); font-size: 11px; font-variant-numeric: tabular-nums">400</text><line x1="56" x2="864" y1="193.4" y2="193.4" style="stroke: var(--border)"></line><text x="48" y="197.4" text-anchor="end" style="fill: var(--text-dim); font-size: 11px; font-variant-numeric: tabular-nums">800</text><line x1="56" x2="864" y1="75.1" y2="75.1" style="stroke: var(--border)"></line><text x="48" y="79.1" text-anchor="end" style="fill: var(--text-dim); font-size: 11px; font-variant-numeric: tabular-nums">1200</text><rect x="76.2" y="391.9" width="60.6" height="38.1" rx="3" style="fill: var(--accent)"><title>SKU-1001: 129.00</title></rect><text x="106.5" y="385.9" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px; font-variant-numeric: tabular-nums">129.00</text><text x="106.5" y="454" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px">SKU-1001</text><rect x="177.2" y="326.6" width="60.6" height="103.4" rx="3" style="fill: var(--accent)"><title>SKU-1002: 349.50</title></rect><text x="207.5" y="320.6" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px; font-variant-numeric: tabular-nums">349.50</text><text x="207.5" y="454" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px">SKU-1002</text><rect x="278.2" y="403.4" width="60.6" height="26.6" rx="3" style="fill: var(--accent)"><title>SKU-1003: 89.90</title></rect><text x="308.5" y="397.4" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px; font-variant-numeric: tabular-nums">89.90</text><text x="308.5" y="454" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px">SKU-1003</text><rect x="379.2" y="45.9" width="60.6" height="384.1" rx="3" style="fill: var(--accent)"><title>SKU-1004: 1299.00</title></rect><text x="409.5" y="39.9" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px; font-variant-numeric: tabular-nums">1299.00</text><text x="409.5" y="454" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px">SKU-1004</text><rect x="480.2" y="294.3" width="60.6" height="135.7" rx="3" style="fill: var(--accent)"><title>SKU-1005: 459.00</title></rect><text x="510.5" y="288.3" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px; font-variant-numeric: tabular-nums">459.00</text><text x="510.5" y="454" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px">SKU-1005</text><rect x="581.2" y="412.3" width="60.6" height="17.7" rx="3" style="fill: var(--accent)"><title>SKU-1006: 59.90</title></rect><text x="611.5" y="406.3" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px; font-variant-numeric: tabular-nums">59.90</text><text x="611.5" y="454" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px">SKU-1006</text><rect x="682.2" y="193.7" width="60.6" height="236.3" rx="3" style="fill: var(--accent)"><title>SKU-1007: 799.00</title></rect><text x="712.5" y="187.7" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px; font-variant-numeric: tabular-nums">799.00</text><text x="712.5" y="454" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px">SKU-1007</text><rect x="783.2" y="365.2" width="60.6" height="64.8" rx="3" style="fill: var(--accent)"><title>SKU-1008: 219.00</title></rect><text x="813.5" y="359.2" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px; font-variant-numeric: tabular-nums">219.00</text><text x="813.5" y="454" text-anchor="middle" style="fill: var(--text-dim); font-size: 11px">SKU-1008</text></svg><div class="help">El pastel usa solo la primera columna de valores seleccionada. «id» no se ofrece como valor: es la clave primaria.</div></div>
      
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="productos · 8 filas · 1 serie" hint-size="1280px,24px"></dc-import>
  
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return Object.assign({ theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows', yes: true, no: false }, {"tabs": [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true}, {"label": "productos", "kind": "table", "href": "DataGrid.dc.html"}, {"label": "Gráfico · productos", "kind": "tool", "active": true, "href": "Chart.dc.html"}]});
  }
}
