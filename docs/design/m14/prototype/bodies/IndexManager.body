Índices · clientes
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="clientes — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="clientes" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Acciones de los índices" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <span class="seg" role="tablist" aria-label="Vista del objeto">
          <a href="DataGrid.dc.html" role="tab" aria-selected="false">Datos</a>
          <a href="StructureView.dc.html" role="tab" aria-selected="false">Estructura</a>
          <a href="IndexManager.dc.html" role="tab" aria-selected="true" class="on">Índices</a>
          <a href="DdlView.dc.html" role="tab" aria-selected="false">DDL</a>
        </span>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <a href="#ixname" class="btn btn-ghost" aria-pressed="true" style="background: var(--hover)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Nuevo índice</a>
        <a href="#" class="btn btn-ghost" style="color: var(--danger)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg>Eliminar ix_clientes_ciudad…</a>
        <span style="flex: 1"></span>
        <a href="#" class="btn btn-icon" aria-label="Refrescar (F5)" title="Refrescar (F5)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></a>
        <a href="TreeContextMenu.dc.html" class="btn btn-icon" aria-label="Más acciones: eliminar tabla, vaciar, renombrar" aria-haspopup="menu" title="Más acciones"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
      </div>
      <div style="flex: 1; min-height: 0; display: flex">
        <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; overflow: auto">
          <section style="flex: none; display: flex; flex-direction: column; gap: 8px; padding: 16px 16px 8px">
            <div style="display: flex; align-items: baseline; gap: 8px"><h2 style="margin: 0; font-size: var(--fs-md); font-weight: 600">Índices</h2><span class="help num">2</span></div>
            <div role="table" aria-label="Índices de clientes" style="border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden">
              <div role="row" style="display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) 52px minmax(0, 1.3fr) 32px; gap: 0 12px; align-items: center; height: 30px; padding: 0 8px 0 14px; background: var(--surface); font-size: var(--fs-sm); font-weight: 600"><span role="columnheader">Nombre</span><span role="columnheader">Columnas</span><span role="columnheader">Único</span><span role="columnheader">Origen</span><span></span></div>
              <div role="row" style="display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) 52px minmax(0, 1.3fr) 32px; gap: 0 12px; align-items: center; height: 36px; padding: 0 8px 0 14px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);">
              <span role="cell"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">ux_clientes_email</span></span><span role="cell"><span class="mono" style="font-size: var(--fs-sm)">email</span></span><span role="cell"><span role="img" aria-label="sí" style="display: flex; color: var(--text)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span></span><span role="cell" style="color: var(--text-dim)">Índice único</span>
              <a href="#" role="cell" class="btn btn-icon" aria-label="Eliminar el índice ux_clientes_email" title="Eliminar índice" style="width: 28px; height: 28px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg></a>
            </div><div role="row" style="display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) 52px minmax(0, 1.3fr) 32px; gap: 0 12px; align-items: center; height: 36px; padding: 0 8px 0 14px; border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent); background: var(--sel); box-shadow: inset 3px 0 0 var(--accent);">
              <span role="cell"><span class="mono" style="font-size: var(--fs-sm); font-weight: 500">ix_clientes_ciudad</span></span><span role="cell"><span class="mono" style="font-size: var(--fs-sm)">ciudad</span></span><span role="cell"><span aria-label="no" style="color: var(--text-dim)">—</span></span><span role="cell" style="color: var(--text-dim)">Índice</span>
              <a href="#" role="cell" class="btn btn-icon" aria-label="Eliminar el índice ix_clientes_ciudad" title="Eliminar índice" style="width: 28px; height: 28px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg></a>
            </div>
            </div>
            <div class="help">La clave primaria id es el rowid de SQLite: no necesita un índice aparte.</div>
          </section>
          <section style="flex: none; display: flex; flex-direction: column; gap: 8px; padding: 8px 16px 16px">
            <div style="display: flex; align-items: center; gap: 8px"><h2 style="margin: 0; font-size: var(--fs-md); font-weight: 600">Restricciones</h2><span style="flex: 1"></span><button type="button" class="btn" disabled="disabled" style="opacity: .45"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Nueva restricción</button></div>
            <div style="display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border-radius: var(--r-md); background: var(--surface); font-size: var(--fs-sm); color: var(--text-dim); line-height: 1.45"><span style="display: flex; flex: none; margin-top: 1px; color: var(--text-dim)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span><span>SQLite no permite añadir restricciones a una tabla existente: se definen en el CREATE TABLE. <a href="DdlView.dc.html">Ver el DDL</a></span></div>
          </section>
        </div>
        <aside aria-label="Nuevo índice" style="width: 340px; flex: none; display: flex; flex-direction: column; gap: 14px; padding: 16px; border-left: 1px solid var(--border); background: var(--surface)">
          <h2 style="margin: 0; font-size: var(--fs-lg); font-weight: 600">Nuevo índice</h2>
          <div style="display: grid; grid-template-columns: 80px 1fr; gap: 10px 12px; align-items: center">
            <label for="ixname" style="color: var(--text-dim)">Nombre</label><input id="ixname" class="field is-focus" value="ix_clientes_ciudad_alta" style="width: 100%; font-family: var(--font-mono); font-size: var(--fs-sm);">
            <span style="color: var(--text-dim); align-self: start; padding-top: 4px">Columnas</span>
            <div style="display: flex; flex-wrap: wrap; gap: 6px"><span class="chip" style="height: 26px; padding-right: 2px; background: var(--accent-soft); color: var(--accent-text)"><span class="mono">ciudad</span><a href="#" class="btn btn-icon" aria-label="Quitar ciudad" style="width: 24px; height: 24px; color: inherit"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg></a></span><span class="chip" style="height: 26px; padding-right: 2px; background: var(--accent-soft); color: var(--accent-text)"><span class="mono">alta</span><a href="#" class="btn btn-icon" aria-label="Quitar alta" style="width: 24px; height: 24px; color: inherit"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg></a></span><a href="#" class="btn" style="height: 26px; border-style: dashed; font-size: var(--fs-sm)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Columna</a></div>
            <span></span><label style="display: flex; align-items: center; gap: 8px; min-height: 28px"><input type="checkbox" style="accent-color: var(--accent); width: 16px; height: 16px; margin: 0">Único</label>
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px"><span class="lbl">Vista previa</span><div style="height: 92px; flex: none; display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden"><div style="flex: 1; min-height: 0"><dc-import name="SqlEditor" theme="{{theme}}" sql="{{ixsql}}" current="{{noLine}}" height="100%" hint-size="100%,100%"></dc-import></div></div></div>
          <div style="display: flex; gap: 8px"><span class="dlg-actions"><a href="#" class="btn btn-primary">Crear índice</a><a href="#" class="btn">Cancelar</a></span></div>
        </aside>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="clientes · 2 índices" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b',
      os: this.props.os ?? 'windows',
      noLine: 0,
      tabs: [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true}, {"label": "clientes", "kind": "table", "active": true, "href": "StructureView.dc.html"}],
      ixsql: "CREATE INDEX\n  \"ix_clientes_ciudad_alta\"\n  ON \"clientes\" (\"ciudad\", \"alta\");",
    };
  }
}
