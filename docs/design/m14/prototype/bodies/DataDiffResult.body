Sincronizar datos · revisar
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Sincronizar datos · clientes — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="clientes" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <header style="height: 56px; flex: none; display: flex; align-items: center; gap: 16px; padding: 0 24px; border-bottom: 1px solid var(--border)">
        <div style="min-width: 0">
          <h1 style="margin: 0; font-size: var(--fs-lg); font-weight: 600">Sincronizar datos · clientes</h1>
          <div style="font-size: var(--fs-sm); color: var(--text-dim)">Ventas → Ventas copia · main</div>
        </div>
        <span style="flex: 1"></span>
        <ol aria-label="Pasos del asistente" style="list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 10px; font-size: var(--fs-md)"><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; background: var(--accent-soft); color: var(--accent-text)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span style="position: absolute; left: -9999px">Hecho:</span></span><span style="color: var(--text-dim)">Comparar</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li aria-current="step" style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; background: var(--accent); color: var(--accent-fg)">2</span><span style="color: var(--text); font-weight: 600">Revisar</span></li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m9 6 6 6-6 6"></path></svg><li style="display: flex; align-items: center; gap: 8px"><span style="position: relative; width: 22px; height: 22px; box-sizing: border-box; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--fs-sm); font-weight: 600; border: 1px solid var(--border-strong); color: var(--text-dim)">3</span><span style="color: var(--text-dim)">Aplicar</span></li></ol>
      </header>
      <div style="flex: 1; min-height: 0; overflow: auto; padding: 18px 24px; display: flex; flex-direction: column; gap: 12px">
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: var(--fs-md)">
          <span class="lbl" style="font-size: var(--fs-sm)">Origen</span><span style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--border)"><span aria-hidden="true" style="width: 8px; height: 8px; flex: none; border-radius: 50%; background: #2f7dd6"></span><b style="font-weight: 600">Ventas</b><span style="color: var(--text-dim)">clientes · 12 filas</span></span>
          <span style="display: flex; color: var(--text-dim)" aria-label="hacia"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg></span>
          <span class="lbl" style="font-size: var(--fs-sm)">Destino</span><span style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: var(--r-md); background: var(--accent-soft); border: 1px solid var(--border)"><span aria-hidden="true" style="width: 8px; height: 8px; flex: none; border-radius: 50%; background: #2e9e52"></span><b style="font-weight: 600">Ventas copia</b><span style="color: var(--text-dim)">clientes · 11 filas</span></span>
          
        </div>
        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap"><span style="font-size: var(--fs-lg); font-weight: 600">3 cambios</span><span style="color: var(--text-dim)">para igualar</span><span aria-hidden="true" style="width: 8px; height: 8px; flex: none; border-radius: 50%; background: #2e9e52"></span><span style="font-weight: 600">Ventas copia › main.clientes</span><span style="flex: 1"></span>
          <span class="chip" style="background: var(--ok-soft); color: var(--ok)">1 INSERT</span><span class="chip" style="background: var(--warn-soft); color: var(--warn)">2 UPDATE</span><span class="chip" style="background: var(--surface); color: var(--text-dim); border: 1px solid var(--border)">0 DELETE · desactivado</span></div>
        <div class="help">Tabla completa comparada por id: 12 filas en el origen, 11 en el destino, 9 iguales.</div>
        <div style="height: 132px; flex: none; border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden"><dc-import name="Grid" theme="{{theme}}" columns="{{ocols}}" rows="{{orows}}" label="Cambios por fila" row-state="{{ostate}}" height="100%" hint-size="100%,100%"></dc-import></div>
        <div style="height: 186px; flex: none; display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden"><div style="height: 32px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 6px 0 12px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm); color: var(--text-dim)"><span style="color: var(--text); font-weight: 600">SQL</span><span>· 3 sentencias · literales según el tipo de cada columna · en una transacción</span><span style="flex: 1"></span><a href="#" class="btn btn-ghost" style="height: 26px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>Copiar</a></div><div style="flex: 1; min-height: 0"><dc-import name="SqlEditor" theme="{{theme}}" sql="{{ddsql}}" current="{{noLine}}" height="100%" hint-size="100%,100%"></dc-import></div></div>
      </div>
      <footer style="height: 52px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 24px; border-top: 1px solid var(--border); background: var(--surface)">
        <a href="DataDiff.dc.html" class="btn">Atrás</a>
        <a href="EditorResult.dc.html" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path><path d="m9 13-2 2 2 2"></path><path d="m13 13 2 2-2 2"></path></svg>Abrir en el editor</a>
        <span style="flex: 1"></span>
        <span class="dlg-actions"><a href="DataDiffConfirm.dc.html" class="btn btn-primary">Aplicar 3 cambios en Ventas copia…</a><a href="DataGrid.dc.html" class="btn">Cancelar</a></span>
      </footer>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="3 cambios · 1 INSERT · 2 UPDATE · 0 DELETE" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return {
      theme: this.props.theme ?? 'b',
      os: this.props.os ?? 'windows',
      noLine: 0,
      tabs: [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true}, {"label": "clientes", "kind": "table", "href": "DataGrid.dc.html"}, {"label": "Sincronizar datos", "kind": "tool", "active": true, "href": "#", "color": "#2f7dd6"}],
      ocols: [{"name": "operación", "type": "text", "kind": "text", "w": "110px"}, {"name": "id", "type": "integer", "kind": "num", "w": "56px", "key": true}, {"name": "columna", "type": "text", "kind": "text", "w": "110px"}, {"name": "en el destino", "type": "valor actual", "kind": "text", "w": "170px"}, {"name": "pasa a", "type": "valor del origen", "kind": "text", "w": "1fr"}],
      orows: [["INSERT", 12, "(fila nueva)", null, "Andrés Solís · asolis@correo.mx · Puerto Peñasco · 315.75"], ["UPDATE", 2, "saldo", "900.00", "980.50"], ["UPDATE", 5, "ciudad", "Navojoa", "Hermosillo"]],
      ostate: { 0: 'added', 1: 'changed', 2: 'changed' },
      ddsql: "INSERT INTO \"main\".\"clientes\" (\"id\", \"nombre\", \"email\", \"ciudad\", \"saldo\", \"activo\", \"alta\")\n  VALUES (12, 'Andrés Solís', 'asolis@correo.mx', 'Puerto Peñasco', 315.75, TRUE, '2025-06-19');\nUPDATE \"main\".\"clientes\" SET \"saldo\" = 980.50 WHERE \"id\" = 2;\nUPDATE \"main\".\"clientes\" SET \"ciudad\" = 'Hermosillo' WHERE \"id\" = 5;",
    };
  }
}
