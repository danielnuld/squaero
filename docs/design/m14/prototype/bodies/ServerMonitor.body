Monitor de servidor
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="{{winTitle}}" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <sc-if value="{{pg}}" hint-placeholder-val="{{ true }}">
      <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="db" selected="" conn-name="Producción (PostgreSQL)" conn-color="#c4302b" safe="true" height="738px" hint-size="248px,738px"></dc-import>
    </sc-if>
    <sc-if value="{{lite}}" hint-placeholder-val="{{ false }}">
      <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="" height="738px" hint-size="248px,738px"></dc-import>
    </sc-if>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>

      <sc-if value="{{pg}}" hint-placeholder-val="{{ true }}">
        <div role="toolbar" aria-label="Acciones del monitor" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
          <span class="seg" role="radiogroup" aria-label="Actualización automática"><span role="radio" aria-checked="true" tabindex="0" class="on"><span style="width: 6px; height: 6px; border-radius: 50%; background: var(--ok); margin-right: 6px"></span>Cada 5 s</span><span role="radio" aria-checked="false" tabindex="-1">En pausa</span></span>
          <button type="button" class="btn btn-icon" aria-label="Refrescar ahora (F5)" title="Refrescar ahora (F5)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></button>
          <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
          <label style="position: relative; display: block">
            <span style="position: absolute; left: -9999px">Filtrar sesiones</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position: absolute; left: 9px; top: 7px; color: var(--text-dim)"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <input class="field" placeholder="Filtrar por usuario, base o consulta" style="width: 260px; padding-left: 28px; font-size: var(--fs-sm)">
          </label>
          <button type="button" class="btn btn-ghost" aria-pressed="true" style="background: var(--accent-soft); color: var(--accent-text)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Ocultar inactivas</button>
          <span style="flex: 1"></span>
          <a href="SlowQueries.dc.html" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2 2"></path><path d="M10 2h4"></path></svg>Consultas lentas</a>
        </div>

        <div role="group" aria-label="Indicadores del servidor" style="flex: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--border); background: var(--surface)">
          <div style="padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--content); display: flex; flex-direction: column; gap: 2px">
            <span class="lbl">Sesiones abiertas</span>
            <span style="display: flex; align-items: baseline; gap: 6px"><span class="num" style="font-size: 22px; font-weight: 600">14</span><span style="font-size: var(--fs-sm); color: var(--text-dim)">de 100 máx.</span></span>
            <svg width="100%" height="28" viewBox="0 0 120 28" preserveAspectRatio="none" aria-hidden="true" style="display: block; fill: none"><polyline points="0,20 10,18 20,19 30,15 40,16 50,12 60,14 70,11 80,13 90,9 100,10 110,8 120,9" style="stroke: var(--accent); stroke-width: 1.5" vector-effect="non-scaling-stroke"></polyline></svg>
          </div>
          <div style="padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--content); display: flex; flex-direction: column; gap: 2px">
            <span class="lbl">Transacciones por segundo</span>
            <span style="display: flex; align-items: baseline; gap: 6px"><span class="num" style="font-size: 22px; font-weight: 600">312</span><span style="font-size: var(--fs-sm); color: var(--text-dim)">+8 % en 5 min</span></span>
            <svg width="100%" height="28" viewBox="0 0 120 28" preserveAspectRatio="none" aria-hidden="true" style="display: block; fill: none"><polyline points="0,16 10,14 20,17 30,12 40,13 50,9 60,15 70,10 80,8 90,11 100,6 110,9 120,7" style="stroke: var(--accent); stroke-width: 1.5" vector-effect="non-scaling-stroke"></polyline></svg>
          </div>
          <div style="padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--content); display: flex; flex-direction: column; gap: 2px">
            <span class="lbl">Aciertos de caché</span>
            <span style="display: flex; align-items: baseline; gap: 6px"><span class="num" style="font-size: 22px; font-weight: 600">99.2 %</span><span style="font-size: var(--fs-sm); color: var(--text-dim)">buffers compartidos</span></span>
            <svg width="100%" height="28" viewBox="0 0 120 28" preserveAspectRatio="none" aria-hidden="true" style="display: block; fill: none"><polyline points="0,6 10,6 20,7 30,6 40,6 50,8 60,7 70,6 80,6 90,7 100,6 110,6 120,6" style="stroke: var(--accent); stroke-width: 1.5" vector-effect="non-scaling-stroke"></polyline></svg>
          </div>
          <div style="padding: 10px 12px; border: 1px solid var(--warn); border-radius: var(--r-md); background: var(--warn-soft); display: flex; flex-direction: column; gap: 2px">
            <span class="lbl" style="color: var(--warn); display: flex; align-items: center; gap: 4px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>Esperas por bloqueo</span>
            <span style="display: flex; align-items: baseline; gap: 6px"><span class="num" style="font-size: 22px; font-weight: 600; color: var(--warn)">2</span><span style="font-size: var(--fs-sm); color: var(--warn)">bloqueadas por la 4127</span></span>
            <svg width="100%" height="28" viewBox="0 0 120 28" preserveAspectRatio="none" aria-hidden="true" style="display: block; fill: none"><polyline points="0,24 10,24 20,24 30,24 40,22 50,24 60,24 70,20 80,20 90,16 100,16 110,16 120,16" style="stroke: var(--warn); stroke-width: 1.5" vector-effect="non-scaling-stroke"></polyline></svg>
          </div>
        </div>

        <div style="flex: 1; min-height: 0">
          <dc-import name="Grid" theme="{{theme}}" columns="{{columns}}" rows="{{rows}}" marked="{{marked}}" selected="{{sel}}" density="compacta" label="Sesiones del servidor" height="100%" hint-size="100%,100%"></dc-import>
        </div>

        <section aria-label="Sesión 4127 seleccionada" style="height: 108px; flex: none; box-sizing: border-box; padding: 10px 16px; border-top: 1px solid var(--border); background: var(--surface); display: flex; flex-direction: column; gap: 8px">
          <div style="display: flex; align-items: center; gap: 10px; font-size: var(--fs-sm)">
            <span style="flex: none; font-weight: 600; font-size: var(--fs-md); white-space: nowrap">Sesión 4127</span>
            <span class="chip" style="flex: none; white-space: nowrap; background: var(--warn-soft); color: var(--warn)">Inactiva en transacción · 12 min</span>
            <span style="flex: 1; min-width: 0; color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis">reportes · bloquea a 4133 y 4140</span>
            <button type="button" class="btn btn-ghost" style="height: 28px; font-size: var(--fs-sm)" title="Copiar la consulta en una pestaña nueva de Producción">Copiar al editor</button>
            <button type="button" class="btn" aria-disabled="true" title="No hay ninguna consulta en curso que cancelar: la sesión está inactiva dentro de una transacción" style="height: 28px; font-size: var(--fs-sm); opacity: .5">Cancelar consulta</button>
            <a href="KillSessionConfirm.dc.html" class="btn btn-danger" style="height: 28px; font-size: var(--fs-sm)" title="Pide confirmación antes de ejecutar pg_terminate_backend(4127)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1"></rect></svg>Terminar sesión 4127…</a>
          </div>
          <div class="mono" style="flex: 1; display: flex; align-items: center; padding: 0 10px; border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--content); font-size: var(--fs-sm); color: var(--text); overflow: hidden; white-space: nowrap; text-overflow: ellipsis"><span><span style="color: var(--syntax-keyword)">UPDATE</span> pedidos <span style="color: var(--syntax-keyword)">SET</span> estado = <span style="color: var(--syntax-string)">'facturado'</span> <span style="color: var(--syntax-keyword)">WHERE</span> fecha &lt; <span style="color: var(--syntax-string)">'2025-06-01'</span> <span style="color: var(--syntax-keyword)">AND</span> estado = <span style="color: var(--syntax-string)">'enviado'</span>;</span></div>
        </section>
      </sc-if>

      <sc-if value="{{lite}}" hint-placeholder-val="{{ false }}">
        <div style="flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; background: var(--surface)">
          <div role="status" style="max-width: 440px; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center">
            <span style="width: 44px; height: 44px; border-radius: 50%; background: var(--hover); color: var(--text-dim); display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"></path></svg></span>
            <span style="font-size: var(--fs-lg); font-weight: 600">SQLite no tiene sesiones que monitorizar</span>
            <span style="color: var(--text-dim); line-height: 1.5">Ventas es un archivo local: no hay servidor, ni otros usuarios conectados, ni estadísticas de actividad. El monitor funciona con PostgreSQL, MySQL y SQL Server.</span>
            <a href="ServerMonitor.dc.html" class="btn btn-primary" style="margin-top: 4px">Abrir el monitor de Producción</a>
            <span class="help">En SQLite, esta herramienta aparece deshabilitada en el menú Herramientas y en la paleta.</span>
          </div>
        </div>
      </sc-if>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="{{sbConn}}" db="{{sbDb}}" color="{{sbColor}}" safe="{{pg}}" info="{{sbInfo}}" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"motor":{"editor":"enum","options":["postgres","sqlite"],"default":"postgres"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const pg = (this.props.motor ?? 'postgres') !== 'sqlite';
    const color = pg ? '#c4302b' : '#2f7dd6';
    return {
      theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows', pg, lite: !pg,
      winTitle: pg ? 'Monitor de servidor — Producción — Squaero' : 'Monitor de servidor — Ventas — Squaero',
      sbConn: pg ? 'Producción' : 'Ventas', sbDb: pg ? 'ventas' : 'main', sbColor: color,
      sbInfo: pg ? '14 sesiones · 9 visibles · actualizado hace 2 s' : 'Monitor no disponible en SQLite',
      tabs: [{ label: 'Consulta 1', kind: 'query', href: 'EditorResult.dc.html', color, safe: pg }, { label: 'Monitor de servidor', kind: 'tool', active: true, href: 'ServerMonitor.dc.html', color, safe: pg }],
      columns: [
        { name: 'pid', type: 'integer', kind: 'num', w: '64px' }, { name: 'usuario', type: 'name', kind: 'text', w: '96px' },
        { name: 'base', type: 'name', kind: 'text', w: '72px' }, { name: 'cliente', type: 'inet', kind: 'text', w: '100px' },
        { name: 'estado', type: 'text', kind: 'text', w: '150px' }, { name: 'espera', type: 'text', kind: 'text', w: '72px' },
        { name: 'duración', type: 'interval', kind: 'date', w: '100px', sort: '↓' }, { name: 'consulta', type: 'text', kind: 'text', w: '1fr' }],
      rows: [
        [4133, 'app_ventas', 'ventas', '10.0.2.14', 'active', 'Lock', '00:11:42', 'UPDATE pedidos SET total = $1 WHERE id = $2'],
        [4140, 'app_ventas', 'ventas', '10.0.2.15', 'active', 'Lock', '00:08:03', 'DELETE FROM detalle_pedido WHERE pedido_id = $1'],
        [4127, 'reportes', 'ventas', '10.0.3.21', 'idle in transaction', 'Client', '00:12:07', 'UPDATE pedidos SET estado = $1 WHERE fecha < $2 AND estado = $3'],
        [4188, 'etl', 'ventas', '10.0.4.2', 'active', 'IO', '00:01:19', 'COPY detalle_pedido FROM STDIN'],
        [4201, 'app_ventas', 'ventas', '10.0.2.14', 'active', null, '00:00:02', 'SELECT * FROM productos WHERE sku = $1'],
        [4205, 'app_ventas', 'ventas', '10.0.2.16', 'active', null, '00:00:01', 'INSERT INTO pedidos (cliente_id, fecha) VALUES ($1, $2)'],
        [4210, 'postgres', 'postgres', '127.0.0.1', 'active', null, '00:00:00', 'SELECT pid, usename, datname, state FROM pg_stat_activity'],
        [102, 'postgres', null, null, 'active', 'Activity', '6 d 04:12', 'autovacuum launcher'],
        [4211, 'reportes', 'ventas', '10.0.3.21', 'active', null, '00:00:00', 'SELECT ciudad, SUM(total) FROM ventas_por_ciudad GROUP BY 1']],
      marked: [2], sel: { r: 2, c: 0 }
    };
  }
}
