Snippets
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Snippets — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Biblioteca de snippets" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <span class="field" style="width: 300px; display: inline-flex; align-items: center; gap: 6px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg><input aria-label="Buscar snippets" placeholder="Buscar por nombre o por lo que hace" style="flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text)"></span>
        <span style="flex: 1"></span>
        <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim); margin-right: 6px">3 snippets</span>
        <button type="button" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg>Importar…</button>
        <button type="button" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"></path><path d="m7 8 5-5 5 5"></path><path d="M5 21h14"></path></svg>Exportar…</button>
      </div>
      <div style="flex: 1; min-height: 0; display: flex">
        <div role="listbox" aria-label="Snippets guardados" style="width: 300px; flex: none; border-right: 1px solid var(--border); padding: 8px; display: flex; flex-direction: column; gap: 2px"><a href="SnippetsTool.dc.html" role="option" aria-selected="false" style="display: block; padding: 8px 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: transparent"><div class="" style="font-size: var(--fs-md); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600">Clientes activos <span class="kbd" style="font-weight: 400">act</span></div><div style="margin-top: 3px; display: flex; align-items: center; gap: 6px; font-size: var(--fs-xs); color: var(--text-dim); white-space: nowrap; overflow: hidden"><span class="mono" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis">SELECT * FROM clientes WHERE activo</span></div></a><a href="SnippetsTool.dc.html" role="option" aria-selected="true" style="display: block; padding: 8px 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: var(--sel); box-shadow: inset 2px 0 0 var(--accent)"><div class="" style="font-size: var(--fs-md); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600">Ventas por estado <span class="kbd" style="font-weight: 400">vxe</span></div><div style="margin-top: 3px; display: flex; align-items: center; gap: 6px; font-size: var(--fs-xs); color: var(--text-dim); white-space: nowrap; overflow: hidden"><span class="mono" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis">SELECT estado, COUNT(*) AS n, SUM(total)…</span></div></a><a href="SnippetsTool.dc.html" role="option" aria-selected="false" style="display: block; padding: 8px 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: transparent"><div class="" style="font-size: var(--fs-md); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600">Productos sin existencias</div><div style="margin-top: 3px; display: flex; align-items: center; gap: 6px; font-size: var(--fs-xs); color: var(--text-dim); white-space: nowrap; overflow: hidden"><span class="mono" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis">SELECT sku, nombre FROM productos WHERE…</span></div></a></div>
        <section aria-label="Snippet seleccionado" style="flex: 1; min-width: 0; display: flex; flex-direction: column; padding: 18px 20px; gap: 16px; overflow: hidden">
          <div style="display: flex; align-items: center; gap: 8px">
            <div style="flex: 1"><div style="font-size: var(--fs-lg); font-weight: 600">Ventas por estado</div><div class="help" style="margin-top: 2px">Guardado el 12/10/2026 · 6 líneas · se guarda al escribir</div></div>
            <a href="EditorMultipleResults.dc.html" class="btn btn-primary" title="Abrir en una pestaña de consulta nueva"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Abrir en pestaña nueva</a>
            <a href="EditorResult.dc.html" class="btn">Insertar en Consulta 1</a>
            <a href="#" class="btn btn-icon" aria-label="Más: renombrar, duplicar, eliminar" title="Más: renombrar, duplicar, eliminar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
          </div>
          <div style="display: grid; grid-template-columns: 120px 1fr; gap: 4px 12px; align-items: center">
            <label for="snip-abbr" style="color: var(--text-dim)">Abreviatura</label>
            <input id="snip-abbr" class="field" value="vxe" placeholder="p. ej. sel" style="width: 160px; font-family: var(--font-mono)">
            <span></span><span class="help">Escríbela en el editor y pulsa <span class="kbd">Tab</span> para expandirla. Una palabra; vacía la quita.</span>
          </div>
          <div style="flex: 1; min-height: 0; border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden">
            <dc-import name="SqlEditor" theme="{{theme}}" sql="{{sql}}" current="0" height="100%" hint-size="100%,100%"></dc-import>
          </div>
        </section>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" color="#2f7dd6" info="3 snippets" hint-size="1280px,24px"></dc-import>

</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return Object.assign({ theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows', yes: true, no: false }, {"tabs": [{"label": "Consulta 1", "kind": "query", "href": "EditorResult.dc.html", "dirty": true, "color": "#2f7dd6"}, {"label": "Snippets", "kind": "tool", "active": true, "href": "SnippetsTool.dc.html"}], "sql": "SELECT estado,\n       COUNT(*)   AS n,\n       SUM(total) AS total\n  FROM pedidos\n GROUP BY estado\n ORDER BY total DESC;"});
  }
}
