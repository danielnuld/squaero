Varios resultados
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Consulta 1 — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Ejecución de la consulta" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <a href="EditorConnectionMenu.dc.html" class="field" role="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Conexión de esta pestaña: Ventas, base main" title="Conexión y base de datos de esta pestaña" style="flex: none; display: inline-flex; align-items: center; gap: 7px; padding: 0 8px; text-decoration: none; font-size: var(--fs-sm)"><span style="width: 8px; height: 8px; border-radius: 50%; background: #2f7dd6; box-shadow: 0 0 0 2px color-mix(in srgb, #2f7dd6 25%, transparent)"></span><span style="font-weight: 600">Ventas</span><span style="color: var(--text-dim)">· main</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m6 9 6 6 6-6"></path></svg></a>
        <span style="flex: none; display: inline-flex"><a href="EditorResult.dc.html" class="btn btn-primary" title="Ejecutar la sentencia actual (Ctrl+Intro)" style="border-radius: var(--r-sm) 0 0 var(--r-sm)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>Ejecutar sentencia</a><a href="EditorRunMenu.dc.html" class="btn btn-primary" aria-label="Qué ejecutar: sentencia actual, selección o script completo" aria-haspopup="menu" aria-expanded="false" style="border-radius: 0 var(--r-sm) var(--r-sm) 0; padding: 0 7px; border-left: 1px solid color-mix(in srgb, var(--accent-fg) 40%, transparent)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a></span><button type="button" class="btn btn-icon" disabled aria-label="Detener (no hay nada en ejecución)" title="Detener (Ctrl+Pausa)" style="opacity: .45"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1"></rect></svg></button>
        <span style="width: 1px; height: 20px; flex: none; background: var(--border); margin: 0 4px"></span>
        <a href="#" class="btn btn-ghost" title="Formatear SQL (Alt+Mayús+F)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"></path><path d="M4 12h10"></path><path d="M4 18h14"></path></svg>Formatear</a>
        <span style="width: 1px; height: 20px; flex: none; background: var(--border); margin: 0 4px"></span>
        <span class="seg" role="radiogroup" aria-label="Modo de transacción" style="flex: none"><a href="EditorResult.dc.html" role="radio" class="on" aria-checked="true" title="Auto: cada sentencia se confirma al ejecutarse">Auto</a><a href="TxManualPending.dc.html" role="radio" class="" aria-checked="false" title="Manual: agrupa las sentencias hasta Commit o Revertir">Manual</a><a href="TxControlsMenu.dc.html" aria-label="Opciones de transacción" aria-haspopup="menu" aria-expanded="false" style="padding: 0 6px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a></span>
        <span style="flex: 1"></span>
        <a href="EditorMoreMenu.dc.html" class="btn btn-ghost" aria-haspopup="menu" aria-expanded="false" aria-label="Más: plan, historial, variables, abrir y guardar .sql, snippet" style="">Más<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
      </div>
      <div style="height: 150px; flex: none; position: relative">
        <dc-import name="SqlEditor" theme="{{theme}}" sql="{{sql}}" current="1" caret-line="1" run-range="1-1" height="150px" hint-size="100%,150px"></dc-import>
      </div>
      <div role="separator" aria-orientation="horizontal" aria-label="Redimensionar editor y resultados" title="Arrastra para redimensionar · doble clic maximiza los resultados" style="height: 7px; flex: none; display: flex; align-items: center; justify-content: center; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--surface); cursor: row-resize"><span style="width: 36px; height: 3px; border-radius: 2px; background: var(--border-strong)"></span></div>
      <div style="height: 36px; flex: none; display: flex; align-items: center; padding: 0 6px 0 14px; border-bottom: 1px solid var(--border)">
        <div role="tablist" aria-label="Panel de resultados" style="display: flex; align-items: center; height: 100%; min-width: 0"><a href="EditorMultipleResults.dc.html" role="tab" aria-selected="true" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 14px; text-decoration: none; white-space: nowrap; border-bottom: 2px solid var(--accent); color: var(--text); font-weight: 600"><span class="num" style="color: var(--text-dim)">1 ·</span><span class="mono" style="font-size: var(--fs-sm)">clientes</span><span class="num" style="font-weight: 400; color: var(--text-dim)">12</span></a><a href="EditorMultipleResults.dc.html" role="tab" aria-selected="false" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 14px; text-decoration: none; white-space: nowrap; border-bottom: 2px solid transparent; color: var(--text-dim); font-weight: 400"><span class="num" style="color: var(--text-dim)">2 ·</span><span class="mono" style="font-size: var(--fs-sm)">estado, n, importe</span><span class="num" style="font-weight: 400; color: var(--text-dim)">4</span></a><a href="EditorMultipleResults.dc.html" role="tab" aria-selected="false" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 14px; text-decoration: none; white-space: nowrap; border-bottom: 2px solid transparent; color: var(--text-dim); font-weight: 400"><span class="num" style="color: var(--text-dim)">3 ·</span><span class="mono" style="font-size: var(--fs-sm)">productos</span><span class="num" style="font-weight: 400; color: var(--text-dim)">8</span></a><span style="width: 1px; height: 18px; background: var(--border); margin-right: 14px"></span><a href="EditorError.dc.html" role="tab" aria-selected="false" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid transparent; color: var(--text-dim); font-weight: 400">Mensajes</a><a href="ExplainPlan.dc.html" role="tab" aria-selected="false" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid transparent; color: var(--text-dim); font-weight: 400">Plan</a></div>
        <span style="flex: 1"></span>
        <div role="toolbar" aria-label="Acciones del resultado" style="display: flex; align-items: center; gap: 2px"><a href="EditorResult.dc.html" class="btn btn-icon" aria-label="Refrescar (F5): vuelve a leer este SELECT" title="Refrescar (F5) · vuelve a leer este SELECT" style="width: 28px; height: 28px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></a><a href="GridColumnFilter.dc.html" class="btn btn-icon" aria-label="Buscar en la página: solo en las 12 filas cargadas" title="Buscar en la página · solo en las 12 filas cargadas (Ctrl+F en la rejilla)" style="width: 28px; height: 28px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></a><a href="GridTransposed.dc.html" class="btn btn-icon" aria-label="Transponer" title="Transponer" style="width: 28px; height: 28px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h7v7H4z"></path><path d="M13 13h7v7h-7z"></path><path d="M15 4h5v5"></path><path d="M9 20H4v-5"></path></svg></a><a href="PinnedResult.dc.html" class="btn btn-icon" aria-label="Fijar resultado" title="Fijar resultado" style="width: 28px; height: 28px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17v5"></path><path d="M9 3h6l-1 6 4 4H6l4-4z"></path></svg></a><a href="CompareMenu.dc.html" class="btn btn-icon" aria-label="Comparar con…" title="Comparar con…" style="width: 28px; height: 28px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v18"></path><path d="M16 3v18"></path><path d="M3 8h5"></path><path d="M16 16h5"></path></svg></a><a href="Chart.dc.html" class="btn btn-icon" aria-label="Graficar" title="Graficar" style="width: 28px; height: 28px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"></path><path d="M10 20V4"></path><path d="M16 20v-7"></path><path d="M22 20H2"></path></svg></a><a href="ExportMenu.dc.html" class="btn btn-ghost" aria-haspopup="menu" title="Exportar el resultado completo" style="height: 28px; padding: 0 8px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"></path><path d="m7 8 5-5 5 5"></path><path d="M5 21h14"></path></svg>Exportar<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a></div>
      </div>
      <div style="flex: 1; min-height: 0">
        <dc-import name="Grid" theme="{{theme}}" columns="{{columns}}" rows="{{rows}}"  label="Resultado de la consulta" height="100%" hint-size="100%,100%"></dc-import>
      </div>
      <div style="height: 30px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 12px; border-top: 1px solid var(--border); font-size: var(--fs-sm); color: var(--text-dim)">
        <span class="num">Filas 1–12 de 12</span><span class="help">Doble clic, F2 o empieza a escribir para editar una celda</span><span style="flex: 1"></span><span class="num">Script: 3 sentencias · 14 ms</span>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" color="#2f7dd6" info="clientes · 12 filas · 7 columnas · 14 ms · ejecutado 14:18:11" hint-size="1280px,24px"></dc-import>

</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return Object.assign({ theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows', yes: true, no: false }, {"tabs": [{"label": "Consulta 1", "kind": "query", "active": true, "dirty": true, "href": "EditorResult.dc.html", "color": "#2f7dd6"}, {"label": "clientes", "kind": "table", "href": "DataGrid.dc.html", "color": "#2f7dd6"}], "sql": "SELECT * FROM clientes;\nSELECT p.estado, COUNT(*) AS n, SUM(d.cantidad * d.precio) AS importe\n  FROM pedidos p JOIN detalle_pedido d ON d.pedido_id = p.id\n GROUP BY p.estado;\nSELECT * FROM productos;", "columns": [{"name": "id", "type": "integer", "kind": "num", "w": "64px", "key": true}, {"name": "nombre", "type": "text", "kind": "text", "w": "140px"}, {"name": "email", "type": "text", "kind": "text", "w": "200px"}, {"name": "ciudad", "type": "text", "kind": "text", "w": "130px"}, {"name": "saldo", "type": "numeric(10,2)", "kind": "num", "w": "110px"}, {"name": "activo", "type": "boolean", "kind": "bool", "w": "76px"}, {"name": "alta", "type": "date", "kind": "date", "w": "1fr"}], "rows": [[1, "María López", "maria.lopez@correo.mx", "Hermosillo", "1250.00", "true", "2023-02-14"], [2, "Juan Pérez", "jperez@correo.mx", "Nogales", "980.50", "true", "2023-03-01"], [3, "Ana Gómez", "ana.gomez@correo.mx", "Guaymas", null, "false", "2023-05-22"], [4, "Luis Ramírez", "lramirez@correo.mx", "Cd. Obregón", "4321.99", "true", "2024-01-09"], [5, "Sofía Torres", "storres@correo.mx", "Hermosillo", "12.00", "true", "2024-04-18"], [6, "Carlos Ruiz", "cruiz@correo.mx", "Navojoa", "777.77", "false", "2024-06-30"], [7, "Elena Díaz", "ediaz@correo.mx", "Caborca", "230.10", "true", "2024-08-12"], [8, "Miguel Ángel", "", "Nogales", "5400.00", "true", "2024-11-03"], [9, "Paola Núñez", "pnunez@correo.mx", "Hermosillo", "88.25", "true", "2025-01-27"], [10, "Roberto Sil", "rsil@correo.mx", "Guaymas", "1590.40", "false", "2025-03-15"], [11, "Verónica Paz", "vpaz@correo.mx", "Agua Prieta", "640.00", "true", "2025-05-02"], [12, "Andrés Solís", "asolis@correo.mx", "Puerto Peñasco", "315.75", "true", "2025-06-19"]]});
  }
}
