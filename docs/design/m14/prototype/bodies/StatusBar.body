Barra de estado
<footer class="th th-{{theme}}" role="status" style="width: 100%; min-width: 600px; height: var(--h-status); box-sizing: border-box; display: flex; align-items: center; gap: 14px; padding: 0 12px 0 14px; background: var(--chrome); color: var(--text-dim); font-size: var(--fs-sm)">
  <span style="display: flex; align-items: center; gap: 6px">
    <span style="{{dot}}"></span>
    <span style="color: var(--text)">{{connLabel}}</span>
    <sc-if value="{{hasDb}}"><span>·</span><span>{{db}}</span></sc-if>
  </span>
  <sc-if value="{{safe}}"><span class="chip" style="height: 18px; background: var(--hover); color: var(--text-dim)"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>Solo lectura</span></sc-if>
  <sc-if value="{{hasTx}}"><span class="chip" style="height: 18px; background: var(--warn-soft); color: var(--warn)">{{tx}}</span></sc-if>
  <span style="flex: 1"></span>
  <sc-for list="{{items}}" as="it" hint-placeholder-count="3"><span class="num" style="white-space: nowrap">{{it}}</span></sc-for>
</footer>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"conn":{"editor":"text","default":"Ventas"},"db":{"editor":"text","default":"main"},"color":{"editor":"color","default":"#2f7dd6"},"tx":{"editor":"text","default":""},"safe":{"editor":"boolean","default":false},"lost":{"editor":"boolean","default":false},"info":{"editor":"text","default":"12 filas · 7 columnas · 20 ms"},"$preview":{"width":1280,"height":24}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const p = this.props;
    const conn = p.conn ?? 'Ventas';
    const info = p.info ?? '12 filas · 7 columnas · 20 ms';
    const color = p.color ?? (/Producción/.test(conn) ? '#c4302b' : '#2f7dd6');
    return {
      theme: p.theme ?? 'b', connLabel: conn ? (p.lost ? `${conn} (desconectada)` : conn) : 'Sin conexión', db: p.db ?? 'main', hasDb: !!conn && !!(p.db ?? 'main'),
      dot: `width: 8px; height: 8px; border-radius: 50%; background: ${!conn ? 'var(--text-faint)' : p.lost ? 'var(--danger)' : color}; box-shadow: 0 0 0 2px color-mix(in srgb, ${conn && !p.lost ? color : 'transparent'} 25%, transparent)`,
      safe: !!p.safe, tx: p.tx ?? '', hasTx: !!p.tx,
      items: info ? info.split(' · ') : []
    };
  }
}
