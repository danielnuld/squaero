Consultas lentas
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Consultas lentas — Producción — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="" conn-name="Producción (PostgreSQL)" conn-color="#c4302b" safe="true" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>

      <div role="toolbar" aria-label="Acciones de consultas lentas" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <a href="EditorResult.dc.html" class="btn btn-primary" title="Abrir la consulta seleccionada en una pestaña de Producción"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path><path d="m9 13-2 2 2 2"></path><path d="m13 13 2 2-2 2"></path></svg>Abrir en el editor</a>
        <a href="ExplainPlan.dc.html" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="5" rx="1"></rect><rect x="3" y="17" width="6" height="5" rx="1"></rect><rect x="15" y="17" width="6" height="5" rx="1"></rect><path d="M12 7v5"></path><path d="M6 17v-3h12v3"></path></svg>Plan de ejecución</a>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <span id="sq-order" style="font-size: var(--fs-sm); color: var(--text-dim)">Ordenar por</span>
        <span class="seg" role="radiogroup" aria-labelledby="sq-order"><span role="radio" aria-checked="true" tabindex="0" class="on">Latencia media</span><span role="radio" aria-checked="false" tabindex="-1">Tiempo total</span><span role="radio" aria-checked="false" tabindex="-1">Ejecuciones</span></span>
        <span style="flex: 1"></span>
        <button type="button" class="btn btn-icon" aria-label="Refrescar (F5)" title="Refrescar (F5)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></button>
        <button type="button" class="btn btn-icon" aria-label="Más acciones: exportar, reiniciar estadísticas" aria-haspopup="menu" title="Más acciones"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></button>
      </div>

      <div style="height: 32px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 14px; border-bottom: 1px solid var(--border); background: var(--surface)" class="help">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
        <span>Datos de <span class="mono" style="color: var(--text)">pg_stat_statements</span> desde el último reinicio (12 oct., 09:14). Los parámetros aparecen como $1, $2.</span>
      </div>

      <div style="flex: 1; min-height: 0">
        <dc-import name="Grid" theme="{{theme}}" columns="{{columns}}" rows="{{rows}}" marked="{{marked}}" selected="{{sel}}" label="Consultas más lentas" height="100%" hint-size="100%,100%"></dc-import>
      </div>

      <section aria-label="Detalle de la consulta seleccionada" style="height: 230px; flex: none; display: flex; border-top: 1px solid var(--border)">
        <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; border-right: 1px solid var(--border)">
          <div style="height: 32px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 8px 0 14px; border-bottom: 1px solid var(--border); background: var(--surface)">
            <span style="font-weight: 600">Consulta</span>
            <span class="mono" style="font-size: var(--fs-xs); color: var(--text-dim)">queryid 7731248819045</span>
            <span style="flex: 1"></span>
            <button type="button" class="btn btn-icon" aria-label="Copiar consulta" title="Copiar consulta" style="width: 24px; height: 24px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></button>
          </div>
          <div style="flex: 1; min-height: 0"><dc-import name="SqlEditor" theme="{{theme}}" sql="{{sql}}" current="0" height="100%" hint-size="100%,100%"></dc-import></div>
        </div>
        <dl style="width: 280px; flex: none; margin: 0; padding: 12px 16px; box-sizing: border-box; display: grid; grid-template-columns: 1fr auto; gap: 8px 12px; align-content: start; font-size: var(--fs-sm)">
          <dt style="color: var(--text-dim)">Ejecuciones</dt><dd class="num" style="margin: 0; text-align: right">1284</dd>
          <dt style="color: var(--text-dim)">Latencia media</dt><dd class="num" style="margin: 0; text-align: right; font-weight: 600">842.60 ms</dd>
          <dt style="color: var(--text-dim)">Latencia máxima</dt><dd class="num" style="margin: 0; text-align: right">3912.00 ms</dd>
          <dt style="color: var(--text-dim)">Tiempo total</dt><dd class="num" style="margin: 0; text-align: right">18 min 01 s</dd>
          <dt style="color: var(--text-dim)">Filas por ejecución</dt><dd class="num" style="margin: 0; text-align: right">212</dd>
          <dt style="grid-column: 1 / -1; color: var(--text-dim); margin-top: 6px">22 % del tiempo total registrado</dt>
          <dd role="meter" aria-valuenow="22" aria-valuemin="0" aria-valuemax="100" aria-label="Porcentaje del tiempo total" style="grid-column: 1 / -1; margin: 0; height: 6px; border-radius: 3px; background: var(--border)"><span style="display: block; width: 22%; height: 100%; border-radius: 3px; background: var(--accent)"></span></dd>
          <dd class="help" style="grid-column: 1 / -1; margin: 6px 0 0; line-height: 1.45">Sugerencia: el filtro por <span class="mono">fecha</span> no usa índice. Revisa el plan de ejecución.</dd>
        </dl>
      </section>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Producción" db="ventas" color="#c4302b" safe="true" info="8 consultas · ordenadas por latencia media" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const c = '#c4302b';
    return {
      theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows',
      tabs: [{ label: 'Monitor de servidor', kind: 'tool', href: 'ServerMonitor.dc.html', color: c, safe: true }, { label: 'Consultas lentas', kind: 'tool', active: true, href: 'SlowQueries.dc.html', color: c, safe: true }],
      columns: [
        { name: 'consulta', type: 'text', kind: 'text', w: '1fr' }, { name: 'ejecuciones', type: 'bigint', kind: 'num', w: '104px' },
        { name: 'media (ms)', type: 'double', kind: 'num', w: '104px', sort: '↓' }, { name: 'total (ms)', type: 'double', kind: 'num', w: '116px' },
        { name: 'máx. (ms)', type: 'double', kind: 'num', w: '104px' }],
      rows: [
        ['SELECT c.ciudad, SUM(p.total) FROM pedidos p JOIN clientes c ON … WHERE p.fecha BETWEEN $1 AND $2 GROUP BY …', '1284', '842.60', '1081898.40', '3912.00'],
        ['UPDATE pedidos SET total = (SELECT SUM(cantidad * precio_unitario) FROM detalle_pedido WHERE …)', '9410', '211.35', '1988803.50', '1204.77'],
        ['SELECT * FROM ventas_por_ciudad ORDER BY importe DESC', '3020', '96.12', '290282.40', '640.10'],
        ['SELECT p.*, d.* FROM pedidos p LEFT JOIN detalle_pedido d ON d.pedido_id = p.id WHERE p.cliente_id = $1', '48112', '31.70', '1525150.40', '402.55'],
        ['COPY detalle_pedido FROM STDIN', '24', '28.05', '673.20', '91.30'],
        ['SELECT id, nombre, email FROM clientes WHERE lower(email) LIKE $1', '6733', '12.44', '83758.52', '88.90'],
        ['INSERT INTO pedidos (cliente_id, fecha, estado, total) VALUES ($1, $2, $3, $4)', '9410', '1.92', '18067.20', '44.10'],
        ['SELECT * FROM productos WHERE sku = $1', '120554', '0.31', '37371.74', '12.06']],
      marked: [0], sel: { r: 0, c: 0 },
      sql: 'SELECT c.ciudad, SUM(p.total)\nFROM pedidos p\nJOIN clientes c ON c.id = p.cliente_id\nWHERE p.fecha BETWEEN $1 AND $2\nGROUP BY c.ciudad;'
    };
  }
}
