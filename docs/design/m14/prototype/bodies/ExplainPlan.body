Plan de ejecución
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Consulta 2 — Producción — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" conn-name="Producción (PostgreSQL)" conn-color="#c4302b" safe="{{yes}}" second="{{no}}" selected="" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Ejecución de la consulta" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <a href="EditorConnectionMenu.dc.html" class="field" role="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Conexión de esta pestaña: Producción, base ventas" title="Conexión y base de datos de esta pestaña" style="flex: none; display: inline-flex; align-items: center; gap: 7px; padding: 0 8px; text-decoration: none; font-size: var(--fs-sm)"><span style="width: 8px; height: 8px; border-radius: 50%; background: #c4302b; box-shadow: 0 0 0 2px color-mix(in srgb, #c4302b 25%, transparent)"></span><span style="font-weight: 600">Producción</span><span style="color: var(--text-dim)">· ventas</span><span class="chip" title="Conexión protegida: las escrituras están bloqueadas" style="height: 20px; margin-left: 2px; background: var(--hover); color: var(--text-dim); font-weight: 500"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>Solo lectura</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m6 9 6 6 6-6"></path></svg></a>
        <span style="flex: none; display: inline-flex"><a href="EditorResult.dc.html" class="btn btn-primary" title="Ejecutar la sentencia actual (Ctrl+Intro)" style="border-radius: var(--r-sm) 0 0 var(--r-sm)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>Ejecutar sentencia</a><a href="EditorRunMenu.dc.html" class="btn btn-primary" aria-label="Qué ejecutar: sentencia actual, selección o script completo" aria-haspopup="menu" aria-expanded="false" style="border-radius: 0 var(--r-sm) var(--r-sm) 0; padding: 0 7px; border-left: 1px solid color-mix(in srgb, var(--accent-fg) 40%, transparent)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a></span><button type="button" class="btn btn-icon" disabled aria-label="Detener (no hay nada en ejecución)" title="Detener (Ctrl+Pausa)" style="opacity: .45"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1"></rect></svg></button>
        <span style="width: 1px; height: 20px; flex: none; background: var(--border); margin: 0 4px"></span>
        <a href="#" class="btn btn-ghost" title="Formatear SQL (Alt+Mayús+F)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"></path><path d="M4 12h10"></path><path d="M4 18h14"></path></svg>Formatear</a>
        <span style="width: 1px; height: 20px; flex: none; background: var(--border); margin: 0 4px"></span>
        <span class="seg" role="radiogroup" aria-label="Modo de transacción" style="flex: none"><a href="EditorResult.dc.html" role="radio" class="on" aria-checked="true" title="Auto: cada sentencia se confirma al ejecutarse">Auto</a><a href="TxManualPending.dc.html" role="radio" class="" aria-checked="false" title="Manual: agrupa las sentencias hasta Commit o Revertir">Manual</a><a href="TxControlsMenu.dc.html" aria-label="Opciones de transacción" aria-haspopup="menu" aria-expanded="false" style="padding: 0 6px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a></span>
        <span style="flex: 1"></span>
        <a href="EditorMoreMenu.dc.html" class="btn btn-ghost" aria-haspopup="menu" aria-expanded="false" aria-label="Más: plan, historial, variables, abrir y guardar .sql, snippet" style="">Más<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
      </div>
      <div style="height: 118px; flex: none; position: relative">
        <dc-import name="SqlEditor" theme="{{theme}}" sql="{{sql}}" current="4" caret-line="4" run-range="1-4" height="118px" hint-size="100%,118px"></dc-import>
      </div>
      <div role="separator" aria-orientation="horizontal" aria-label="Redimensionar editor y resultados" title="Arrastra para redimensionar · doble clic maximiza los resultados" style="height: 7px; flex: none; display: flex; align-items: center; justify-content: center; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--surface); cursor: row-resize"><span style="width: 36px; height: 3px; border-radius: 2px; background: var(--border-strong)"></span></div>
      <div style="height: 36px; flex: none; display: flex; align-items: center; padding: 0 6px 0 14px; border-bottom: 1px solid var(--border)">
        <div role="tablist" aria-label="Panel de resultados" style="display: flex; align-items: center; height: 100%; min-width: 0"><a href="EditorResult.dc.html" role="tab" aria-selected="false" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid transparent; color: var(--text-dim); font-weight: 400">Resultado</a><a href="EditorError.dc.html" role="tab" aria-selected="false" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid transparent; color: var(--text-dim); font-weight: 400">Mensajes</a><a href="ExplainPlan.dc.html" role="tab" aria-selected="true" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid var(--accent); color: var(--text); font-weight: 600">Plan</a></div>
        <span style="flex: 1"></span>
        <div role="toolbar" aria-label="Acciones del resultado" style="display: flex; align-items: center; gap: 2px"><span class="help" style="white-space: nowrap; margin-right: 8px">Sentencia de las líneas 1–4 · 14:30:02</span></div>
      </div>
      <div role="toolbar" aria-label="Opciones del plan" style="height: 36px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 6px 0 10px; border-bottom: 1px solid var(--border)">
        <span class="seg" role="radiogroup" aria-label="Vista del plan"><a href="#" role="radio" class="on" aria-checked="true">Árbol</a><a href="#" role="radio" aria-checked="false">Tabla</a><a href="#" role="radio" aria-checked="false">Texto</a></span>
        <label style="display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-sm); white-space: nowrap"><input type="checkbox" checked style="accent-color: var(--accent); margin: 0">Con ANALYZE <span style="color: var(--text-dim)">(ejecuta la consulta)</span></label>
        <span class="help" style="display: inline-flex; align-items: center; gap: 10px; white-space: nowrap"><span style="display: inline-flex; align-items: center; gap: 5px"><span style="width: 14px; height: 8px; border-radius: 4px; background: var(--accent)"></span>Coste propio</span><span style="display: inline-flex; align-items: center; gap: 5px"><span style="width: 14px; height: 8px; border-radius: 4px; background: var(--warn)"></span>Nodo más costoso</span><span style="display: inline-flex; align-items: center; gap: 5px"><span style="width: 14px; height: 3px; border-radius: 2px; background: var(--type-dot-num)"></span>Filas reales</span></span>
        <span style="flex: 1"></span>
        <span class="num" style="font-size: var(--fs-sm); color: var(--text-dim); white-space: nowrap">Coste total 152.40 · 4.1 ms</span>
        <a href="#" class="btn btn-icon" aria-label="Refrescar el plan (F5)" title="Refrescar el plan (F5)" style="width: 28px; height: 28px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></a>
      </div>
      <div style="flex: 1; min-height: 0; display: flex"><div role="tree" aria-label="Plan de ejecución" style="flex: 1; min-width: 0; overflow: hidden"><div style="display: grid; grid-template-columns: 1fr 120px 150px 70px; height: 30px; align-items: center; border-bottom: 1px solid var(--border); background: var(--surface); font-size: var(--fs-sm); font-weight: 600"><span style="padding: 0 10px; ">Operación</span><span style="padding: 0 10px; text-align: right;">Filas (est. / reales)</span><span style="padding: 0 10px; text-align: right;">Coste propio</span><span style="padding: 0 10px; text-align: right;">Tiempo</span></div><a href="#" role="treeitem" aria-level="1" aria-selected="false" class="" style="display: grid; grid-template-columns: 1fr 120px 150px 70px; align-items: center; height: 36px; text-decoration: none; color: var(--text); border-bottom: 1px solid var(--border); background: transparent"><span style="display: flex; align-items: center; gap: 6px; padding-left: 10px; min-width: 0"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim); flex: none"><path d="m6 9 6 6 6-6"></path></svg><span style="font-weight: 600; white-space: nowrap">Sort</span><span class="mono" style="font-size: var(--fs-sm); color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis">clave: p.fecha</span></span><span style="padding: 0 10px; display: flex; flex-direction: column; align-items: flex-end; gap: 3px"><span class="mono num" style="font-size: var(--fs-sm)">1240 <span style="color: var(--text-dim)">/</span> 1238</span><span style="width: 90px; height: 3px; border-radius: 2px; background: var(--hover)"><span style="display: block; width: 100%; height: 3px; border-radius: 2px; background: var(--type-dot-num)"></span></span></span><span style="padding: 0 10px; display: flex; align-items: center; gap: 8px"><s