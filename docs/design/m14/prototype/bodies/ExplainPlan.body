    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Producción" db="ventas" color="#c4302b" safe="{{yes}}" info="Plan · 5 nodos · 4.1 ms" hint-size="1280px,24px"></dc-import>

</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return Object.assign({ theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows', yes: true, no: false }, {"tabs": [{"label": "Consulta 1", "kind": "query", "dirty": true, "href": "EditorResult.dc.html", "color": "#2f7dd6", "conn": "Ventas"}, {"label": "Consulta 2", "kind": "query", "active": true, "href": "ExplainPlan.dc.html", "color": "#c4302b", "conn": "Producción", "safe": true}], "sql": "SELECT c.nombre, c.ciudad, p.fecha, p.estado, p.total\nFROM clientes c\nJOIN pedidos p ON p.cliente_id = c.id\nORDER BY p.fecha;"});
  }
}
