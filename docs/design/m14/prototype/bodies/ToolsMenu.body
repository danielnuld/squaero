Menú Herramientas
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; position: relative; overflow: hidden; background: var(--chrome)">
  <div style="position: absolute; inset: 0">
    <dc-import name="DataGrid" theme="{{theme}}" os="{{os}}" hint-size="1280px,800px"></dc-import>
  </div>
  <a href="DataGrid.dc.html" aria-label="Cerrar el menú (Esc)" style="position: absolute; inset: 0; z-index: 4"></a>
  <div style="position: absolute; left: 0; top: 0; width: 1280px; z-index: 5">
    <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" notif="1" menu-open="Herramientas" window-title="clientes — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  </div>

  <div class="menu" role="menu" aria-label="Herramientas" style="{{menuPos}}; width: 640px; padding: 4px 4px 0; display: flex; flex-direction: column">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0 8px">
      <sc-for list="{{cols}}" as="col" hint-placeholder-count="2">
        <div style="display: flex; flex-direction: column">
          <sc-for list="{{col}}" as="g" hint-placeholder-count="2">
            <div role="group" aria-label="{{g.name}}" style="display: flex; flex-direction: column; padding-bottom: 4px">
              <div class="lbl" role="presentation" style="padding: 6px 10px 2px">{{g.name}}</div>
              <sc-for list="{{g.items}}" as="t" hint-placeholder-count="3">
                <a href="{{t.href}}" role="menuitem" aria-disabled="{{t.disabled}}" title="{{t.title}}" class="{{t.cls}}" style="{{t.style}}">
                  <span style="display: flex; flex: none">
                    <sc-if value="{{t.i.er}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="6" rx="1"></rect><rect x="14" y="15" width="7" height="6" rx="1"></rect><path d="M6.5 9v3a2 2 0 0 0 2 2h7a2 2 0 0 1 2 2v-1"></path></svg></sc-if><sc-if value="{{t.i.qb}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1"></rect><rect x="14" y="3" width="7" height="5" rx="1"></rect><rect x="14" y="12" width="7" height="9" rx="1"></rect><rect x="3" y="16" width="7" height="5" rx="1"></rect></svg></sc-if><sc-if value="{{t.i.routines}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 20c2 0 2.5-1.5 3-4l2-10c.5-2.5 1-4 3-4"></path><path d="M7 10h9"></path></svg></sc-if><sc-if value="{{t.i.triggers}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"></path></svg></sc-if>
                    <sc-if value="{{t.i.notebook}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="15" height="20" rx="2"></rect><path d="M9 2v20"></path><path d="M2 7h4M2 12h4M2 17h4"></path></svg></sc-if><sc-if value="{{t.i.snippets}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg></sc-if><sc-if value="{{t.i.history}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l3 2"></path></svg></sc-if>
                    <sc-if value="{{t.i.search}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></sc-if><sc-if value="{{t.i.import}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg></sc-if><sc-if value="{{t.i.export}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"></path><path d="m7 8 5-5 5 5"></path><path d="M5 21h14"></path></svg></sc-if><sc-if value="{{t.i.gen}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></sc-if>
                    <sc-if value="{{t.i.transfer}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h14l-4-4"></path><path d="M20 16H6l4 4"></path></svg></sc-if><sc-if value="{{t.i.schema}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v18"></path><path d="M16 3v18"></path><path d="M3 8h5"></path><path d="M16 16h5"></path></svg></sc-if><sc-if value="{{t.i.sync}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3L20 9"></path><path d="M20 4v5h-5"></path><path d="M20 12a8 8 0 0 1-14 5.3L4 15"></path><path d="M4 20v-5h5"></path></svg></sc-if><sc-if value="{{t.i.backup}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="5" rx="1"></rect><path d="M4 9v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9"></path><path d="M10 13h4"></path></svg></sc-if>
                    <sc-if value="{{t.i.monitor}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"></path></svg></sc-if><sc-if value="{{t.i.slow}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2 2"></path><path d="M10 2h4"></path></svg></sc-if><sc-if value="{{t.i.users}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="4"></circle><path d="M2 21v-1a6 6 0 0 1 12 0v1"></path><path d="M16 4a4 4 0 0 1 0 8"></path><path d="M22 21v-1a6 6 0 0 0-4-5.6"></path></svg></sc-if>
                  </span>
                  <span style="flex: 1; min-width: 0; display: flex; flex-direction: column">
                    <span>{{t.label}}</span>
                    <sc-if value="{{t.na}}"><span style="font-size: var(--fs-xs); color: var(--text-dim)">{{t.reason}}</span></sc-if>
                  </span>
                  <span class="k">{{t.key}}</span>
                </a>
              </sc-for>
            </div>
          </sc-for>
        </div>
      </sc-for>
    </div>
    <div style="display: flex; align-items: center; gap: 6px; margin: 0 -4px; padding: 8px 14px; border-top: 1px solid var(--border); background: var(--surface); border-radius: 0 0 var(--r-md) var(--r-md)" class="help">
      <span style="flex: 1">Herramientas de Ventas · SQLite. Las no disponibles se explican al lado.</span>
      <span>También con <span class="kbd">{{palette}}</span></span>
    </div>
  </div>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const os = this.props.os ?? 'windows'; const mac = os === 'macos';
    const K = (s) => { if (!mac) return s; const p = s.split('+'); const key = p.pop(); const sym = { Alt: '⌥', 'Mayús': '⇧', Ctrl: '⌘' }; const km = { Intro: '↩', Supr: '⌫', 'Re Pág': '⇞', 'Av Pág': '⇟' }; return ['Alt', 'Mayús', 'Ctrl'].filter((m) => p.includes(m)).map((m) => sym[m]).join('') + (km[key] ?? key); };
    const k = { filter: K('Ctrl+Mayús+L'), sort: K('Ctrl+Mayús+O'), find: K('Ctrl+F'), row: K('Ctrl+Intro'), run: K('Ctrl+Intro'), script: K('Ctrl+Mayús+Intro'), fmt: K('Alt+Mayús+F'), stop: 'Esc',
      open: K('Intro'), alter: 'F4', del: K('Supr'), copy: K('Ctrl+C'), ddl: K('Ctrl+Mayús+C'), refresh: mac ? '⌘R' : 'F5', newq: K('Ctrl+T'), close: K('Ctrl+W'), closeAll: K('Ctrl+Mayús+W'),
      reopen: K('Ctrl+Mayús+T'), export: K('Ctrl+Mayús+X'), settings: K('Ctrl+,'), save: K('Ctrl+S'), more: K('Alt+M') };
    const act = os === 'windows' ? '' : 'flex-direction: row-reverse';
    const mk = ([key, label, keys, href, reason]) => {
      const i = {}; i[key] = true; const na = !!reason;
      return { i, label, key: keys ? K(keys) : '', href: na ? '#' : href, na, reason: reason ?? '', disabled: na ? 'true' : 'false', title: na ? `${label}: ${reason}` : label,
        cls: `mi${na ? ' dis' : ''}${key === 'er' ? ' on focus-in' : ''}`,
        style: `height: auto; min-height: 30px; padding-top: 3px; padding-bottom: 3px; align-items: center` };
    };
    const G = (name, items) => ({ name, items: items.map(mk) });
    const cols = [
      [G('Esquema', [['er', 'Diagrama ER', 'Ctrl+Mayús+D', 'ErDiagram.dc.html'], ['qb', 'Constructor de consultas', 'Ctrl+Mayús+B', 'QueryBuilder.dc.html'],
        ['routines', 'Procedimientos y funciones', '', 'Routines.dc.html', 'SQLite no tiene rutinas almacenadas'], ['triggers', 'Triggers', '', 'Triggers.dc.html']]),
       G('Consultas', [['notebook', 'Notebook SQL', 'Ctrl+Mayús+N', 'Notebook.dc.html'], ['snippets', 'Snippets', 'Ctrl+Mayús+J', 'SnippetsTool.dc.html'], ['history', 'Historial de consultas', 'Ctrl+Mayús+H', 'HistoryPanel.dc.html']]),
       G('Servidor', [['monitor', 'Monitor de servidor', '', 'ServerMonitor.dc.html', 'SQLite es un archivo: no hay servidor'], ['slow', 'Consultas lentas', '', 'SlowQueries.dc.html', 'SQLite no registra consultas lentas'],
        ['users', 'Usuarios y permisos', '', 'UsersGrants.dc.html', 'SQLite no tiene cuentas de usuario']])],
      [G('Datos', [['search', 'Buscar en los datos…', 'Ctrl+Mayús+F', 'DataSearch.dc.html'], ['import', 'Importar datos…', 'Ctrl+Mayús+I', 'ImportWizard.dc.html'], ['export', 'Exportar…', 'Ctrl+Mayús+X', 'ExportMenu.dc.html'],
        ['gen', 'Generar datos de prueba…', '', 'DataGenerator.dc.html'], ['transfer', 'Transferir a otra conexión…', '', 'TransferWizard.dc.html']]),
       G('Comparar y respaldar', [['schema', 'Comparar estructura…', '', 'SchemaSync.dc.html'], ['sync', 'Comparar datos…', '', 'DataDiff.dc.html'], ['backup', 'Respaldo y restauración…', '', 'BackupRestore.dc.html']])]
    ];
    const menuPos = os === 'linux' ? 'right: 44px; top: 38px' : os === 'macos' ? 'left: 300px; top: 2px' : 'left: 268px; top: 34px';
    return { theme: this.props.theme ?? 'b', os, cols, menuPos, palette: K('Ctrl+K') };
  }
}
