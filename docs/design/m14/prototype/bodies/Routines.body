Procedimientos y funciones
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="total_pedido — Producción — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="" conn-name="Producción (PostgreSQL)" conn-color="#c4302b" safe="true" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>

      <div role="toolbar" aria-label="Acciones de rutinas" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <a href="EditorEmpty.dc.html" class="btn btn-primary" title="Abre la definición en una pestaña de Producción"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>Abrir en el editor</a>
        <button type="button" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>Copiar definición</button>
        <span style="width: 1px; height: 20px; background: var(--border); margin: 0 4px"></span>
        <span class="seg" role="radiogroup" aria-label="Tipo de rutina"><span role="radio" aria-checked="true" tabindex="0" class="on">Todas</span><span role="radio" aria-checked="false" tabindex="-1">Funciones</span><span role="radio" aria-checked="false" tabindex="-1">Procedimientos</span></span>
        <span style="flex: 1"></span>
        <button type="button" class="btn btn-icon" aria-label="Refrescar (F5)" title="Refrescar (F5)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path></svg></button>
        <button type="button" class="btn btn-ghost" aria-haspopup="menu" title="Ejecutar…, copiar como CREATE, eliminar rutina…">Más<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></button>
      </div>

      <div style="flex: 1; min-height: 0; display: flex">
        <nav aria-label="Rutinas" style="width: 300px; flex: none; display: flex; flex-direction: column; border-right: 1px solid var(--border); background: var(--surface)">
          <label style="margin: 10px; position: relative; display: block">
            <span style="position: absolute; left: -9999px">Buscar por nombre</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position: absolute; left: 9px; top: 7px; color: var(--text-dim)"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <input class="field" placeholder="Buscar por nombre" style="width: 100%; padding-left: 28px; font-size: var(--fs-sm)">
          </label>
          <div style="flex: 1; min-height: 0; overflow: hidden; padding: 0 6px">
            <sc-for list="{{items}}" as="it" hint-placeholder-count="6">
              <a href="#" aria-current="{{it.current}}" style="{{it.style}}">
                <span style="{{it.icon}}">
                  <sc-if value="{{it.isFn}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 20c2 0 2.5-1.5 3-4l2-10c.5-2.5 1-4 3-4"></path><path d="M7 10h9"></path></svg></sc-if>
                  <sc-if value="{{it.isProc}}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg></sc-if>
                </span>
                <span style="flex: 1; min-width: 0">
                  <span style="display: block; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">{{it.name}}</span>
                  <span class="mono" style="display: block; font-size: var(--fs-xs); color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap">{{it.sig}}</span>
                </span>
                <span style="font-size: var(--fs-xs); color: var(--text-dim)">{{it.lang}}</span>
              </a>
            </sc-for>
          </div>
          <div style="height: 32px; display: flex; align-items: center; padding: 0 12px; border-top: 1px solid var(--border); font-size: var(--fs-sm); color: var(--text-dim)">6 rutinas · 4 funciones · 2 procedimientos</div>
        </nav>

        <section aria-label="Definición de total_pedido" style="flex: 1; min-width: 0; display: flex; flex-direction: column">
          <header style="padding: 16px 20px 14px; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 12px">
            <div style="display: flex; align-items: center; gap: 10px">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--obj-function)"><path d="M9 20c2 0 2.5-1.5 3-4l2-10c.5-2.5 1-4 3-4"></path><path d="M7 10h9"></path></svg>
              <span style="font-size: var(--fs-xl); font-weight: 600"><span style="color: var(--text-dim); font-weight: 400">public.</span>total_pedido</span>
              <span class="chip" style="background: color-mix(in srgb, var(--obj-function) 14%, transparent); color: var(--obj-function)">Función</span>
            </div>
            <dl style="margin: 0; display: grid; grid-template-columns: repeat(5, auto) 1fr; gap: 2px 28px; font-size: var(--fs-sm)">
              <dt class="lbl">Devuelve</dt><dt class="lbl">Argumentos</dt><dt class="lbl">Lenguaje</dt><dt class="lbl">Volatilidad</dt><dt class="lbl">Propietario</dt><dt></dt>
              <dd class="mono" style="margin: 0">numeric</dd><dd class="mono" style="margin: 0">p_pedido integer</dd><dd style="margin: 0">plpgsql</dd><dd style="margin: 0">Estable</dd><dd style="margin: 0">app_ventas</dd><dd></dd>
            </dl>
          </header>
          <div style="height: 34px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 20px; background: var(--surface); border-bottom: 1px solid var(--border)">
            <span style="font-weight: 600">Definición</span>
            <span class="help">Solo lectura · ábrela en el editor para modificarla con CREATE OR REPLACE</span>
          </div>
          <div style="flex: 1; min-height: 0"><dc-import name="SqlEditor" theme="{{theme}}" sql="{{ddl}}" current="0" height="100%" hint-size="100%,100%"></dc-import></div>
        </section>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Producción" db="ventas" color="#c4302b" safe="true" info="public · 4 funciones · 2 procedimientos" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const R = [
      ['total_pedido', 'fn', '(p_pedido integer) → numeric', 'plpgsql', true],
      ['saldo_cliente', 'fn', '(p_cliente integer) → numeric', 'sql'],
      ['clientes_por_ciudad', 'fn', '(p_ciudad text) → setof clientes', 'sql'],
      ['normalizar_email', 'fn', '(p_email text) → text', 'sql'],
      ['registrar_pedido', 'proc', '(p_cliente integer, p_items jsonb)', 'plpgsql'],
      ['actualizar_existencias', 'proc', '(p_producto integer, p_delta integer)', 'plpgsql']
    ];
    const items = R.map(([name, k, sig, lang, on]) => ({ name, sig, lang, isFn: k === 'fn', isProc: k === 'proc', current: on ? 'true' : 'false',
      icon: `display: flex; color: ${k === 'fn' ? 'var(--obj-function)' : 'var(--obj-procedure)'}`,
      style: `height: 46px; box-sizing: border-box; display: flex; align-items: center; gap: 10px; padding: 0 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); background: ${on ? 'var(--sel)' : 'transparent'}; ${on ? 'box-shadow: inset 2px 0 0 var(--accent);' : ''}` }));
    return {
      theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows',
      tabs: [{ label: 'Consulta 1', kind: 'query', href: 'EditorResult.dc.html', color: '#c4302b', safe: true }, { label: 'Rutinas · public', kind: 'tool', active: true, href: 'Routines.dc.html', color: '#c4302b', safe: true }],
      items,
      ddl: 'CREATE OR REPLACE FUNCTION public.total_pedido(p_pedido integer)\n RETURNS numeric\n LANGUAGE plpgsql\n STABLE\nAS $function$\nBEGIN\n  RETURN (\n    SELECT COALESCE(SUM(cantidad * precio_unitario), 0)\n    FROM detalle_pedido\n    WHERE pedido_id = p_pedido\n  );\nEND;\n$function$;'
    };
  }
}
