Ajustes · Atajos de teclado
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Ajustes — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="settings" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="SettingsNav" theme="{{theme}}" active="shortcuts" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Atajos de teclado" style="height: 44px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 10px 0 32px; border-bottom: 1px solid var(--border)">
        <h1 style="margin: 0; font-size: var(--fs-lg); font-weight: 600">Atajos de teclado</h1>
        <label style="position: relative; display: block; width: 240px; margin-left: 12px">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position: absolute; left: 9px; top: 7px; color: var(--text-dim)"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input class="field" placeholder="Buscar una acción o una tecla" aria-label="Buscar atajos" style="width: 100%; padding-left: 28px">
        </label>
        <span style="flex: 1"></span>
        <a href="ShortcutsHelp.dc.html" class="btn btn-ghost">Ver como lista</a>
        <button class="btn btn-ghost">Restablecer los atajos (1 personalizado)</button>
      </div>

      <div style="flex: 1; min-height: 0; overflow: hidden; padding: 6px 32px 24px">
        <div style="max-width: 780px; display: grid; grid-template-columns: 160px minmax(0, 1fr); column-gap: 24px; padding: 10px 0 4px">
          <span style="padding-top: 5px; font-weight: 500">Perfil de teclado</span>
          <div>
            <span class="seg" role="radiogroup" aria-label="Perfil de teclado"><sc-for list="{{profiles}}" as="m" hint-placeholder-count="2"><button role="radio" aria-checked="{{m.checked}}" tabindex="{{m.tab}}" onClick="{{m.go}}" class="{{m.cls}}" style="{{m.style}}">{{m.label}}</button></sc-for></span>
            <div class="help" style="margin-top: 6px">{{profileHelp}} Al cambiar un atajo avisamos si choca con otra acción o con el sistema.</div>
          </div>
        </div>
        <sc-for list="{{groups}}" as="g" hint-placeholder-count="3">
          <section aria-label="{{g.title}}" style="max-width: 780px">
            <h2 class="lbl" style="margin: 12px 0 0; font-size: var(--fs-sm); color: var(--text); padding-bottom: 6px; border-bottom: 1px solid var(--border)">{{g.title}}</h2>
            <sc-for list="{{g.rows}}" as="r" hint-placeholder-count="4">
              <div style="{{r.style}}">
                <span style="flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">{{r.label}}</span>
                <sc-if value="{{r.idle}}">
                  <span style="display: flex; gap: 3px; width: 190px; justify-content: flex-end"><sc-if value="{{r.hasKey}}"><span class="kbd">{{r.key}}</span></sc-if><sc-if value="{{r.noKey}}"><span class="help" style="font-style: italic">Sin atajo</span></sc-if></span>
                </sc-if>
                <sc-if value="{{r.capturing}}">
                  <span class="field is-focus" role="status" aria-live="polite" style="width: 190px; height: 26px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-sm)"><span class="kbd">{{r.pressed}}</span><span class="help">pulsada</span></span>
                </sc-if>
                <span style="width: 104px; display: flex; justify-content: flex-start">
                  <sc-if value="{{r.custom}}"><span class="chip" style="height: 22px; background: var(--accent-soft); color: var(--accent-text)">Personalizado</span></sc-if>
                  <sc-if value="{{r.fixed}}"><span class="chip" title="Este atajo no se puede cambiar" style="height: 22px; background: var(--hover); color: var(--text-dim)">Fijo</span></sc-if>
                </span>
                <span style="width: 180px; display: flex; gap: 4px; justify-content: flex-end">
                  <sc-if value="{{r.editable}}"><button class="btn" onClick="{{r.go}}" style="height: 26px; font-size: var(--fs-sm)">{{r.action}}</button></sc-if>
                  <sc-if value="{{r.custom}}"><button class="btn btn-ghost" style="height: 26px; font-size: var(--fs-sm)">Restablecer</button></sc-if>
                </span>
              </div>
              <sc-if value="{{r.capturing}}">
                <div role="alert" style="margin: 0 -8px 4px; padding: 10px 12px; display: flex; gap: 10px; align-items: flex-start; border-radius: var(--r-sm); background: var(--warn-soft); border-left: 3px solid var(--warn)">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; color: var(--warn); margin-top: 1px"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
                  <div style="flex: 1; min-width: 0">
                    <div style="font-weight: 600">{{r.pressed}} bloquea la pantalla en algunos escritorios Linux</div>
                    <div class="help" style="margin-top: 2px">Pasa en Cinnamon, XFCE y versiones antiguas de Ubuntu. Además, Ctrl+Alt equivale a AltGr en muchos teclados y escribe caracteres. Mejor algo como {{r.suggest}}.</div>
                  </div>
                  <span class="dlg-actions" style="flex: none; align-self: center">
                    <button class="btn btn-primary" onClick="{{r.go}}" style="height: 26px; font-size: var(--fs-sm)">Probar otra</button>
                    <button class="btn" style="height: 26px; font-size: var(--fs-sm)">Usar de todos modos</button>
                  </span>
                </div>
              </sc-if>
            </sc-for>
          </section>
        </sc-for>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const os = this.props.os ?? 'windows';
    const mac = os === 'macos';
    const MOD = { Control: ['⌃', 0], Alt: ['⌥', 1], 'Mayús': ['⇧', 2], Ctrl: ['⌘', 3] };
    const KEY = { Intro: '↩', Supr: '⌫', Tab: '⇥' };
    const fmt = (k) => { const ks = k.split('+'); return mac ? ks.filter((x) => MOD[x]).sort((a, b) => MOD[a][1] - MOD[b][1]).map((x) => MOD[x][0]).join('') + ks.filter((x) => !MOD[x]).map((x) => KEY[x] ?? x).join('') : ks.join('+'); };
    const profile = this.state.profile ?? 'Squaero';
    const ssms = profile === 'SSMS';
    const cap = this.state.cap ?? 'Cambiar tema claro / oscuro';
    const R = (label, keys, flag = '') => ({ label, keys, flag });
    const G = [
      ['General', [R('Paleta de comandos', 'Ctrl+K'), R('Refrescar (solo vuelve a leer)', ssms ? 'Ctrl+R' : 'F5'), R('Cambiar tema claro / oscuro', '')]],
      ['Editor SQL', [R('Ejecutar la sentencia del cursor o la selección', ssms ? 'F5' : 'Ctrl+Intro'), R('Ejecutar el script completo', 'Ctrl+Mayús+Intro'), R('Abrir el historial local', 'Ctrl+Mayús+Y', 'custom')]],
      ['Transacción manual', [R('Confirmar (commit)', 'Alt+Mayús+C'), R('Revertir (rollback)', 'Alt+Mayús+R')]],
      ['Rejilla', [R('Copiar las celdas seleccionadas', 'Ctrl+C', 'fixed'), R('Guardar los cambios', 'Ctrl+S')]]];
    const groups = G.map(([title, rows]) => ({ title, rows: rows.map((r) => {
      const capturing = r.label === cap;
      return { label: r.label, key: r.keys ? fmt(r.keys) : '', hasKey: !!r.keys, noKey: !r.keys, custom: r.flag === 'custom', fixed: r.flag === 'fixed', editable: r.flag !== 'fixed',
        idle: !capturing, capturing, pressed: mac ? '⌃⌥⌘L' : 'Ctrl+Alt+L', suggest: fmt('Ctrl+K') + ' T o ' + fmt('Alt+Mayús+T'),
        action: capturing ? 'Cancelar' : 'Cambiar', go: () => this.setState({ cap: capturing ? '' : r.label }),
        style: `height: 32px; display: flex; align-items: center; gap: 12px; padding: 0 8px; margin: 0 -8px; border-radius: var(--r-sm); background: ${capturing ? 'var(--sel)' : 'transparent'}; border-bottom: 1px solid color-mix(in srgb, var(--border) 55%, transparent)` };
    }) }));
    const profiles = ['Squaero', 'SSMS'].map((id) => ({ label: id === 'SSMS' ? 'SSMS (F5 ejecuta)' : 'Squaero', checked: id === profile ? 'true' : 'false', tab: id === profile ? '0' : '-1', cls: id === profile ? 'on' : '',
      style: `border-top: 0; border-bottom: 0; border-left: 0; ${id === profile ? '' : 'background: transparent;'}`, go: () => this.setState({ profile: id }) }));
    return {
      os, theme: this.props.theme ?? 'b', groups, profiles,
      profileHelp: ssms ? 'Como SQL Server Management Studio: F5 ejecuta y Ctrl+R refresca.' : 'F5 refresca los datos; para ejecutar, ' + fmt('Ctrl+Intro') + '.',
      tabs: [{ label: 'Consulta 1', kind: 'query', href: 'EditorResult.dc.html', dirty: true, color: '#2f7dd6' }, { label: 'Ajustes', kind: 'settings', active: true, href: 'SettingsShortcuts.dc.html' }]
    };
  }
}
