Categorías de ajustes
<nav class="th th-{{theme}}" aria-label="Categorías de ajustes" style="width: 248px; height: {{height}}; box-sizing: border-box; display: flex; flex-direction: column; background: var(--chrome); overflow: hidden">
  <div style="height: 36px; flex: none; display: flex; align-items: center; padding: 0 12px">
    <span class="lbl" style="flex: 1; font-size: var(--fs-sm); color: var(--text)">Ajustes</span>
  </div>
  <label style="margin: 0 8px 8px; position: relative; display: block">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position: absolute; left: 9px; top: 7px; color: var(--text-dim)"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    <input class="{{fieldClass}}" value="{{query}}" placeholder="Buscar un ajuste…" aria-label="Buscar un ajuste" style="width: 100%; height: 28px; box-sizing: border-box; padding: 0 8px 0 28px; font-size: var(--fs-sm)">
  </label>

  <sc-if value="{{browsing}}" hint-placeholder-val="{{ true }}">
    <div style="padding: 2px 6px; display: flex; flex-direction: column; gap: 1px">
      <sc-for list="{{items}}" as="it" hint-placeholder-count="8">
        <a href="{{it.href}}" aria-current="{{it.current}}" style="{{it.style}}">
          <span style="{{it.iconStyle}}">
            <sc-if value="{{it.i.tools}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg></sc-if>
            <sc-if value="{{it.i.view}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg></sc-if>
            <sc-if value="{{it.i.query}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path><path d="m9 13-2 2 2 2"></path><path d="m13 13 2 2-2 2"></path></svg></sc-if>
            <sc-if value="{{it.i.table}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg></sc-if>
            <sc-if value="{{it.i.clock}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2 2"></path><path d="M10 2h4"></path></svg></sc-if>
            <sc-if value="{{it.i.key}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="4.5"></circle><path d="m10.7 12.3 9.3-9.3"></path><path d="m16 7 3 3"></path></svg></sc-if>
            <sc-if value="{{it.i.builder}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1"></rect><rect x="14" y="3" width="7" height="5" rx="1"></rect><rect x="14" y="12" width="7" height="9" rx="1"></rect><rect x="3" y="16" width="7" height="5" rx="1"></rect></svg></sc-if>
            <sc-if value="{{it.i.info}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></sc-if>
          </span>
          <span style="flex: 1">{{it.label}}</span>
        </a>
      </sc-for>
    </div>
  </sc-if>

  <sc-if value="{{searching}}" hint-placeholder-val="{{ false }}">
    <div class="lbl" style="padding: 6px 14px 4px">{{resultLabel}}</div>
    <div style="padding: 0 6px; display: flex; flex-direction: column; gap: 1px">
      <sc-for list="{{hits}}" as="h" hint-placeholder-count="3">
        <a href="{{h.href}}" style="min-height: 24px; padding: 6px 10px; border-radius: var(--r-sm); text-decoration: none; color: var(--text); display: flex; flex-direction: column; gap: 1px">
          <span>{{h.pre}}<span style="color: var(--accent-text); font-weight: 700">{{h.mid}}</span>{{h.post}}</span>
          <span style="font-size: var(--fs-xs); color: var(--text-dim)">{{h.where}}</span>
        </a>
      </sc-for>
      <sc-if value="{{noHits}}"><span style="padding: 8px 10px; font-size: var(--fs-sm); color: var(--text-dim)">Ningún ajuste coincide con «{{query}}».</span></sc-if>
    </div>
  </sc-if>

  <span style="flex: 1"></span>
  <div class="help" style="padding: 12px 14px">Los cambios se aplican y se guardan al momento.</div>
</nav>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"active":{"editor":"enum","options":["general","appearance","editor","grid","queries","shortcuts","window","about"],"default":"general"},"query":{"editor":"text","default":""},"height":{"editor":"text","default":"738px"},"$preview":{"width":248,"height":738}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const p = this.props;
    const active = p.active ?? 'general';
    const query = p.query ?? '';
    const q = query.trim().toLowerCase();
    const C = [['general', 'General', 'tools', 'SettingsGeneral'], ['appearance', 'Apariencia', 'view', 'SettingsAppearance'], ['editor', 'Editor', 'query', 'SettingsEditor'],
      ['grid', 'Rejilla', 'table', 'SettingsGrid'], ['queries', 'Consultas', 'clock', 'SettingsQueries'], ['shortcuts', 'Atajos de teclado', 'key', 'SettingsShortcuts'],
      ['window', 'Ventana', 'builder', 'SettingsWindow'], ['about', 'Acerca de', 'info', 'SettingsAbout']];
    const items = C.map(([id, label, icon, file]) => {
      const on = id === active; const i = {}; i[icon] = true;
      return { label, i, href: `${file}.dc.html`, current: on ? 'page' : 'false',
        iconStyle: `display: flex; color: ${on ? 'var(--accent-text)' : 'var(--text-dim)'}`,
        style: `height: 32px; display: flex; align-items: center; gap: 10px; padding: 0 10px; border-radius: var(--r-sm); text-decoration: none; font-size: var(--fs-md); color: ${on ? 'var(--text)' : 'var(--text)'}; background: ${on ? 'var(--sel)' : 'transparent'}; font-weight: ${on ? 600 : 400}; ${on ? 'box-shadow: inset 2px 0 0 var(--accent);' : ''}` };
    });
    const IDX = [['Idioma', 'General', 'SettingsGeneral'], ['Buscar actualizaciones al iniciar', 'General', 'SettingsGeneral'], ['Exportar configuración', 'General', 'SettingsGeneral'],
      ['Estilo', 'Apariencia', 'SettingsAppearance'], ['Tema de color', 'Apariencia', 'SettingsAppearance'], ['Modo claro u oscuro', 'Apariencia', 'SettingsAppearance'], ['Densidad', 'Apariencia', 'SettingsAppearance'],
      ['Zoom de la interfaz', 'Apariencia', 'SettingsAppearance'], ['Fuente de la interfaz', 'Apariencia', 'SettingsAppearance'], ['Fuente del editor', 'Editor', 'SettingsEditor'],
      ['Interlineado del editor', 'Editor', 'SettingsEditor'], ['Ligaduras en el editor', 'Editor', 'SettingsEditor'], ['Historial local', 'Editor', 'SettingsEditor'],
      ['Ctrl+Intro ejecuta…', 'Editor', 'SettingsEditor'], ['Resaltar la sentencia que se ejecutará', 'Editor', 'SettingsEditor'],
      ['Formato de números', 'Rejilla', 'SettingsGrid'], ['Texto de NULL', 'Rejilla', 'SettingsGrid'], ['Tipo bajo el nombre de la columna', 'Rejilla', 'SettingsGrid'],
      ['Colores por tipo', 'Rejilla', 'SettingsGrid'], ['Estilo de rejilla', 'Rejilla', 'SettingsGrid'], ['Fuente de la rejilla', 'Rejilla', 'SettingsGrid'],
      ['Umbral de consulta lenta', 'Consultas', 'SettingsQueries'], ['Límite de historial', 'Consultas', 'SettingsQueries'],
      ['Atajos de teclado', 'Atajos de teclado', 'SettingsShortcuts'], ['Perfil de teclado (SSMS)', 'Atajos de teclado', 'SettingsShortcuts'], ['Conflictos de atajos', 'Atajos de teclado', 'SettingsShortcuts'],
      ['Barra del documento', 'Ventana', 'SettingsWindow'], ['Barra de menús', 'Ventana', 'SettingsWindow'], ['Al abrir Squaero', 'General', 'SettingsGeneral']];
    const hits = IDX.filter(([l]) => l.toLowerCase().includes(q)).map(([l, where, file]) => {
      const at = l.toLowerCase().indexOf(q);
      return { pre: l.slice(0, at), mid: l.slice(at, at + q.length), post: l.slice(at + q.length), where, href: `${file}.dc.html` };
    });
    return { theme: p.theme ?? 'b', height: p.height ?? '738px', items, query, fieldClass: q ? 'field is-focus' : 'field',
      browsing: !q, searching: !!q, hits, noHits: !!q && !hits.length, resultLabel: `${hits.length} ajustes` };
  }
}
