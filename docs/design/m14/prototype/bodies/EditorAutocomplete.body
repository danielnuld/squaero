Autocompletado
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" window-title="Consulta 1 — Ventas — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>
      <div role="toolbar" aria-label="Ejecución de la consulta" style="height: 44px; flex: none; display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <a href="EditorConnectionMenu.dc.html" class="field" role="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Conexión de esta pestaña: Ventas, base main" title="Conexión y base de datos de esta pestaña" style="flex: none; display: inline-flex; align-items: center; gap: 7px; padding: 0 8px; text-decoration: none; font-size: var(--fs-sm)"><span style="width: 8px; height: 8px; border-radius: 50%; background: #2f7dd6; box-shadow: 0 0 0 2px color-mix(in srgb, #2f7dd6 25%, transparent)"></span><span style="font-weight: 600">Ventas</span><span style="color: var(--text-dim)">· main</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--text-dim)"><path d="m6 9 6 6 6-6"></path></svg></a>
        <span style="flex: none; display: inline-flex"><a href="EditorResult.dc.html" class="btn btn-primary" title="Ejecutar la sentencia actual (Ctrl+Intro)" style="border-radius: var(--r-sm) 0 0 var(--r-sm)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>Ejecutar sentencia</a><a href="EditorRunMenu.dc.html" class="btn btn-primary" aria-label="Qué ejecutar: sentencia actual, selección o script completo" aria-haspopup="menu" aria-expanded="false" style="border-radius: 0 var(--r-sm) var(--r-sm) 0; padding: 0 7px; border-left: 1px solid color-mix(in srgb, var(--accent-fg) 40%, transparent)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a></span><button type="button" class="btn btn-icon" disabled aria-label="Detener (no hay nada en ejecución)" title="Detener (Ctrl+Pausa)" style="opacity: .45"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1"></rect></svg></button>
        <span style="width: 1px; height: 20px; flex: none; background: var(--border); margin: 0 4px"></span>
        <a href="#" class="btn btn-ghost" title="Formatear SQL (Alt+Mayús+F)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"></path><path d="M4 12h10"></path><path d="M4 18h14"></path></svg>Formatear</a>
        <span style="width: 1px; height: 20px; flex: none; background: var(--border); margin: 0 4px"></span>
        <span class="seg" role="radiogroup" aria-label="Modo de transacción" style="flex: none"><a href="EditorResult.dc.html" role="radio" class="on" aria-checked="true" title="Auto: cada sentencia se confirma al ejecutarse">Auto</a><a href="TxManualPending.dc.html" role="radio" class="" aria-checked="false" title="Manual: agrupa las sentencias hasta Commit o Revertir">Manual</a><a href="TxControlsMenu.dc.html" aria-label="Opciones de transacción" aria-haspopup="menu" aria-expanded="false" style="padding: 0 6px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></a></span>
        <span style="flex: 1"></span>
        <a href="EditorMoreMenu.dc.html" class="btn btn-ghost" aria-haspopup="menu" aria-expanded="false" aria-label="Más: plan, historial, variables, abrir y guardar .sql, snippet" style="">Más<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="19" cy="12" r="1.2"></circle></svg></a>
      </div>
      <div style="height: 200px; flex: none; position: relative">
        <dc-import name="SqlEditor" theme="{{theme}}" sql="{{sql}}" current="1" caret-line="1" run-range="1-1" height="200px" hint-size="100%,200px"></dc-import>
      </div>
      <div role="separator" aria-orientation="horizontal" aria-label="Redimensionar editor y resultados" title="Arrastra para redimensionar · doble clic maximiza los resultados" style="height: 7px; flex: none; display: flex; align-items: center; justify-content: center; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--surface); cursor: row-resize"><span style="width: 36px; height: 3px; border-radius: 2px; background: var(--border-strong)"></span></div>
      <div style="height: 36px; flex: none; display: flex; align-items: center; padding: 0 6px 0 14px; border-bottom: 1px solid var(--border)">
        <div role="tablist" aria-label="Panel de resultados" style="display: flex; align-items: center; height: 100%; min-width: 0"><a href="EditorResult.dc.html" role="tab" aria-selected="true" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid var(--accent); color: var(--text); font-weight: 600">Resultado</a><a href="EditorError.dc.html" role="tab" aria-selected="false" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid transparent; color: var(--text-dim); font-weight: 400">Mensajes</a><a href="ExplainPlan.dc.html" role="tab" aria-selected="false" style="height: 35px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; margin-right: 16px; text-decoration: none; font-size: var(--fs-md); white-space: nowrap; border-bottom: 2px solid transparent; color: var(--text-dim); font-weight: 400">Plan</a></div>
        <span style="flex: 1"></span>
        
      </div>
      <div style="flex: 1; min-height: 0; padding: 24px 32px; overflow: hidden">
        <div style="font-size: var(--fs-lg); font-weight: 600">Ejecuta una consulta para ver resultados</div>
        <div style="margin-top: 4px; color: var(--text-dim)"><span class="kbd">Ctrl+Intro</span> ejecuta la sentencia donde está el cursor (o la selección); <span class="kbd">Ctrl+Mayús+Intro</span> ejecuta el script completo.</div>
        <div style="margin-top: 14px; display: flex; gap: 8px"><a href="SnippetPalette.dc.html" class="btn"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>Insertar un snippet</a><a href="#" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v1"></path><path d="M3 7v10a2 2 0 0 0 2 2h13l3-8H6l-3 8"></path></svg>Abrir .sql…</a></div>
        <div style="margin-top: 26px; display: grid; grid-template-columns: 160px 300px 200px; gap: 32px">
          <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0"><span class="lbl">Tablas recientes</span><a href="DataGrid.dc.html" style="text-decoration: none; font-size: var(--fs-md)">clientes</a><a href="DataGrid.dc.html" style="text-decoration: none; font-size: var(--fs-md)">pedidos</a><a href="DataGrid.dc.html" style="text-decoration: none; font-size: var(--fs-md)">productos</a></div>
          <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0"><span class="lbl">Consultas recientes</span><a href="EditorResult.dc.html" style="text-decoration: none; font-family: var(--font-mono); font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis">SELECT c.nombre, c.ciudad, p.fecha…</a><a href="EditorResult.dc.html" style="text-decoration: none; font-family: var(--font-mono); font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis">SELECT * FROM productos WHERE exis…</a><a href="HistoryPanel.dc.html" style="text-decoration: none; font-size: var(--fs-md)">Ver el historial</a></div>
          <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0"><span class="lbl">Snippets</span><a href="SnippetsTool.dc.html" style="text-decoration: none; font-size: var(--fs-md)">Clientes activos</a><a href="SnippetsTool.dc.html" style="text-decoration: none; font-size: var(--fs-md)">Ventas por estado</a><a href="SnippetsTool.dc.html" style="text-decoration: none; font-size: var(--fs-md)">Productos sin existencias</a></div>
        </div>
        <div style="margin-top: 26px; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: var(--fs-sm); color: var(--text-dim)">
          <span>Sentencia <span class="kbd">Ctrl+Intro</span></span><span>Script <span class="kbd">Ctrl+Mayús+Intro</span></span><span>Formatear <span class="kbd">Alt+Mayús+F</span></span><span>Abrir .sql <span class="kbd">Ctrl+O</span></span><span>Snippets <span class="kbd">Ctrl+J</span></span>
          <a href="ShortcutsHelp.dc.html">Todos los atajos</a>
        </div>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" color="#2f7dd6" info="Sin ejecutar" hint-size="1280px,24px"></dc-import>
  <div class="menu" role="listbox" aria-label="Sugerencias para cli" style="left: 494px; top: 150px; width: 520px; padding: 0; display: flex; flex-direction: column; overflow: hidden">
    <div style="display: flex">
      <div style="width: 250px; flex: none; padding: 4px; border-right: 1px solid var(--border)"><div class="mi on" role="option" aria-selected="true" style="height: 26px; gap: 8px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--obj-table); flex: none"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg><span style="font-family: var(--font-mono); font-size: var(--fs-sm)"><span style="color: var(--accent-text); font-weight: 600">cli</span><span style="">entes</span></span><span class="k">tabla · 12 filas</span></div><div class="mi" role="option" aria-selected="false" style="height: 26px; gap: 8px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--obj-view); flex: none"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg><span style="font-family: var(--font-mono); font-size: var(--fs-sm)"><span style="color: var(--accent-text); font-weight: 600">cli</span><span style="">entes_activos</span></span><span class="k">vista</span></div><div class="mi" role="option" aria-selected="false" style="height: 26px; gap: 8px"><span aria-hidden="true" style="width: 14px; flex: none; display: flex; justify-content: center"><span style="width: 7px; height: 7px; border-radius: 2px; background: var(--type-dot-num)"></span></span><span style="font-family: var(--font-mono); font-size: var(--fs-sm)"><span style="color: var(--accent-text); font-weight: 600">cli</span><span style="">ente_id</span></span><span class="k">pedidos</span></div><div class="mi" role="option" aria-selected="false" style="height: 26px; gap: 8px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--accent-text); flex: none"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg><span style="font-family: var(--font-mono); font-size: var(--fs-sm)"><span style="color: var(--accent-text); font-weight: 600">Cli</span><span style="">entes activos</span></span><span class="k">snippet</span></div><div class="mi" role="option" aria-selected="false" style="height: 26px; gap: 8px"><span aria-hidden="true" style="width: 14px; flex: none; text-align: center; font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--syntax-keyword)">K</span><span style="font-family: var(--font-mono); font-size: var(--fs-sm)"><span style="color: var(--accent-text); font-weight: 600">c</span><span style="">o</span><span style="color: var(--accent-text); font-weight: 600">l</span><span style="">lat</span><span style="color: var(--accent-text); font-weight: 600">i</span><span style="">on</span></span><span class="k">palabra clave</span></div><div class="mi" role="option" aria-selected="false" style="height: 26px; gap: 8px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--obj-function); flex: none"><path d="M9 20c2 0 2.5-1.5 3-4l2-10c.5-2.5 1-4 3-4"></path><path d="M7 10h9"></path></svg><span style="font-family: var(--font-mono); font-size: var(--fs-sm)"><span style="">lo</span><span style="color: var(--accent-text); font-weight: 600">c</span><span style="">a</span><span style="color: var(--accent-text); font-weight: 600">l</span><span style="">t</span><span style="color: var(--accent-text); font-weight: 600">i</span><span style="">me</span></span><span class="k">función</span></div></div>
      <div style="flex: 1; min-width: 0; padding: 10px 12px">
        <div style="display: flex; align-items: center; gap: 6px; font-weight: 600"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--obj-table)"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M9 10v10"></path></svg>clientes<span style="font-weight: 400; font-size: var(--fs-xs); color: var(--text-dim)">tabla · main · 12 filas</span></div>
        <div style="margin-top: 8px"><div style="display: flex; gap: 8px; height: 20px; align-items: center"><span class="mono" style="font-size: var(--fs-sm); flex: 1">id <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--warn); vertical-align: -1px"><circle cx="7.5" cy="15.5" r="4.5"></circle><path d="m10.7 12.3 9.3-9.3"></path><path d="m16 7 3 3"></path></svg></span><span class="mono" style="font-size: var(--fs-xs); color: var(--text-dim)">integer</span></div><div style="display: flex; gap: 8px; height: 20px; align-items: center"><span class="mono" style="font-size: var(--fs-sm); flex: 1">nombre</span><span class="mono" style="font-size: var(--fs-xs); color: var(--text-dim)">text</span></div><div style="display: flex; gap: 8px; height: 20px; align-items: center"><span class="mono" style="font-size: var(--fs-sm); flex: 1">email</span><span class="mono" style="font-size: var(--fs-xs); color: var(--text-dim)">text</span></div><div style="display: flex; gap: 8px; height: 20px; align-items: center"><span class="mono" style="font-size: var(--fs-sm); flex: 1">ciudad</span><span class="mono" style="font-size: var(--fs-xs); color: var(--text-dim)">text</span></div><div style="display: flex; gap: 8px; height: 20px; align-items: center"><span class="mono" style="font-size: var(--fs-sm); flex: 1">saldo</span><span class="mono" style="font-size: var(--fs-xs); color: var(--text-dim)">numeric(10,2)</span></div><div style="display: flex; gap: 8px; height: 20px; align-items: center"><span class="mono" style="font-size: var(--fs-sm); flex: 1">activo</span><span class="mono" style="font-size: var(--fs-xs); color: var(--text-dim)">boolean</span></div><div style="display: flex; gap: 8px; height: 20px; align-items: center"><span class="mono" style="font-size: var(--fs-sm); flex: 1">alta</span><span class="mono" style="font-size: var(--fs-xs); color: var(--text-dim)">date</span></div></div>
      </div>
    </div>
    <div style="height: 30px; display: flex; align-items: center; gap: 12px; padding: 0 10px; border-top: 1px solid var(--border); background: var(--surface); font-size: var(--fs-xs); color: var(--text-dim); white-space: nowrap">
      <span><span class="kbd">↑</span> <span class="kbd">↓</span> moverse</span><span><span class="kbd">Intro</span> insertar</span><span><span class="kbd">Tab</span> completar</span><span><span class="kbd">Esc</span> cerrar</span><span style="flex: 1"></span><span title="El catálogo se carga al conectar, aunque el árbol esté plegado">Catálogo de main</span>
    </div>
  </div>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    return Object.assign({ theme: this.props.theme ?? 'b', os: this.props.os ?? 'windows', yes: true, no: false }, {"tabs": [{"label": "Consulta 1", "kind": "query", "active": true, "dirty": true, "href": "EditorResult.dc.html", "color": "#2f7dd6"}, {"label": "clientes", "kind": "table", "href": "DataGrid.dc.html", "color": "#2f7dd6"}], "sql": "SELECT * FROM cli"});
  }
}
