Atajos de teclado
<div class="th th-{{theme}}" data-os="{{os}}" style="width: 1280px; height: 800px; display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--chrome)">
  <dc-import name="TitleBar" theme="{{theme}}" os="{{os}}" notif="1" window-title="Atajos de teclado — Squaero" hint-size="1280px,38px"></dc-import>
  <div style="flex: 1; min-height: 0; display: flex">
    <dc-import name="Rail" theme="{{theme}}" active="explorer" height="738px" hint-size="56px,738px"></dc-import>
    <dc-import name="Explorer" theme="{{theme}}" state="connected" tree="tables" selected="clientes" height="738px" hint-size="248px,738px"></dc-import>
    <main style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--content); border-radius: var(--content-radius); border-top: var(--content-edge); border-left: var(--content-edge); overflow: hidden">
      <dc-import name="DocTabs" theme="{{theme}}" tabs="{{tabs}}" hint-size="100%,36px"></dc-import>

      <div role="toolbar" aria-label="Atajos de teclado" style="height: 44px; flex: none; display: flex; align-items: center; gap: 8px; padding: 0 10px; border-bottom: 1px solid var(--border)">
        <label style="position: relative; display: block; width: 240px">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position: absolute; left: 9px; top: 7px; color: var(--text-dim)"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input class="field is-focus" placeholder="Buscar una acción o una tecla" aria-label="Buscar atajos" style="width: 100%; padding-left: 28px">
        </label>
        <span class="seg" role="radiogroup" aria-label="Grupo">
          <sc-for list="{{filters}}" as="f" hint-placeholder-count="5"><button role="radio" aria-checked="{{f.checked}}" tabindex="{{f.tab}}" onClick="{{f.go}}" class="{{f.cls}}" style="{{f.style}}">{{f.label}}</button></sc-for>
        </span>
        <span style="flex: 1"></span>
        <span class="seg" role="radiogroup" aria-label="Notación de las teclas">
          <sc-for list="{{plats}}" as="f" hint-placeholder-count="2"><button role="radio" aria-checked="{{f.checked}}" tabindex="{{f.tab}}" onClick="{{f.go}}" class="{{f.cls}}" style="{{f.style}}">{{f.label}}</button></sc-for>
        </span>
        <a href="SettingsShortcuts.dc.html" class="btn btn-ghost"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>Personalizar</a>
      </div>

      <div style="flex: 1; min-height: 0; overflow: hidden; padding: 14px 24px">
        <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 10px">
          <h1 style="margin: 0; font-size: var(--fs-xl); font-weight: 600">Atajos de teclado</h1>
          <span class="help"><span class="kbd">F1</span> abre esta lista. Un punto marca los atajos personalizados.</span>
        </div>
        <div style="display: flex; gap: 32px">
          <div style="flex: 1; min-width: 0">
            <sc-for list="{{left}}" as="g" hint-placeholder-count="2">
              <section aria-label="{{g.title}}" style="margin-bottom: 12px">
                <h2 class="lbl" style="margin: 0; font-size: var(--fs-sm); color: var(--text); padding: 0 0 5px; border-bottom: 1px solid var(--border)">{{g.title}}</h2>
                <sc-for list="{{g.rows}}" as="r" hint-placeholder-count="4">
                  <div style="min-height: 24px; display: flex; align-items: center; gap: 4px; border-bottom: 1px solid color-mix(in srgb, var(--border) 55%, transparent); font-size: var(--fs-md)">
                    <span style="flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">{{r.label}}</span>
                    <sc-if value="{{r.custom}}"><span role="img" title="Personalizado" aria-label="Personalizado" style="width: 6px; height: 6px; margin-right: 6px; border-radius: 50%; background: var(--accent)"></span></sc-if>
                    <sc-for list="{{r.keys}}" as="k" hint-placeholder-count="1"><span class="kbd" style="flex: none">{{k}}</span></sc-for>
                    <sc-if value="{{r.none}}"><span class="help" style="flex: none; font-style: italic">{{r.note}}</span></sc-if>
                  </div>
                </sc-for>
              </section>
            </sc-for>
          </div>
          <div style="flex: 1; min-width: 0">
            <sc-for list="{{right}}" as="g" hint-placeholder-count="2">
              <section aria-label="{{g.title}}" style="margin-bottom: 12px">
                <h2 class="lbl" style="margin: 0; font-size: var(--fs-sm); color: var(--text); padding: 0 0 5px; border-bottom: 1px solid var(--border)">{{g.title}}</h2>
                <sc-for list="{{g.rows}}" as="r" hint-placeholder-count="4">
                  <div style="min-height: 24px; display: flex; align-items: center; gap: 4px; border-bottom: 1px solid color-mix(in srgb, var(--border) 55%, transparent); font-size: var(--fs-md)">
                    <span style="flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">{{r.label}}</span>
                    <sc-if value="{{r.custom}}"><span role="img" title="Personalizado" aria-label="Personalizado" style="width: 6px; height: 6px; margin-right: 6px; border-radius: 50%; background: var(--accent)"></span></sc-if>
                    <sc-for list="{{r.keys}}" as="k" hint-placeholder-count="1"><span class="kbd" style="flex: none">{{k}}</span></sc-for>
                    <sc-if value="{{r.none}}"><span class="help" style="flex: none; font-style: italic">{{r.note}}</span></sc-if>
                  </div>
                </sc-for>
              </section>
            </sc-for>
          </div>
        </div>
      </div>
    </main>
  </div>
  <dc-import name="StatusBar" theme="{{theme}}" conn="Ventas" db="main" info="" hint-size="1280px,24px"></dc-import>
</div>
---PROPS---
{"theme":{"editor":"enum","options":["b","a","c","rosa"],"default":"b"},"os":{"editor":"enum","options":["windows","macos","linux"],"default":"windows"},"$preview":{"width":1280,"height":800}}
---JS---
class Component extends DCLogic {
  renderVals() {
    const os = this.props.os ?? 'windows';
    const plat = this.state.plat ?? (os === 'macos' ? 'mac' : 'win');
    const mac = plat === 'mac';
    const MOD = { Control: ['⌃', 0], Alt: ['⌥', 1], 'Mayús': ['⇧', 2], Ctrl: ['⌘', 3] };
    const KEY = { Intro: '↩', Supr: '⌫', Tab: '⇥' };
    const fmt = (s) => {
      const ks = s.endsWith('++') ? [...s.slice(0, -2).split('+'), '+'] : s.split('+');
      if (!mac) return ks.join('+');
      return ks.filter((k) => MOD[k]).sort((a, b) => MOD[a][1] - MOD[b][1]).map((k) => MOD[k][0]).join('') + ks.filter((k) => !MOD[k]).map((k) => KEY[k] ?? k).join('');
    };
    // R(label, windows/linux combo, macOS override, custom, note when there is no shortcut)
    const R = (label, win, macK = '', custom = false, note = '') => {
      const keys = win ? (mac && macK ? macK : win).split(' · ').map((x) => (mac && macK ? x : fmt(x))) : [];
      return { label, keys, none: !keys.length, note, custom };
    };
    const G = [
      ['General', [R('Paleta de comandos', 'Ctrl+K'), R('Buscar objetos (tablas, vistas…)', 'Ctrl+P'), R('Buscar snippets', 'Ctrl+J'),
        R('Refrescar: vuelve a leer, nunca repite escrituras', 'F5'), R('Ajustes', 'Ctrl+,'), R('Esta lista de atajos', 'F1'),
        R('Mostrar u ocultar el panel lateral', 'Ctrl+B'), R('Cambiar tema claro / oscuro', '', '', false, 'Sin atajo · desde ' + fmt('Ctrl+K')),
        R('Acercar · alejar', 'Ctrl++ · Ctrl+−'), R('Restablecer el zoom', 'Ctrl+0')]],
      ['Pestañas', [R('Nueva consulta', 'Ctrl+T'), R('Cerrar la pestaña', 'Ctrl+W'), R('Pestaña siguiente', 'Ctrl+Av Pág', '⇧⌘]'), R('Pestaña anterior', 'Ctrl+Re Pág', '⇧⌘[')]],
      ['Editor SQL', [R('Ejecutar la sentencia del cursor o la selección', 'Ctrl+Intro'), R('Ejecutar el script completo', 'Ctrl+Mayús+Intro'),
        R('Formatear', 'Alt+Mayús+F', '', true), R('Abrir un archivo .sql', 'Ctrl+O'), R('Guardar el archivo .sql', 'Ctrl+S'),
        R('Buscar · reemplazar', 'Ctrl+F · Ctrl+H', '⌘F · ⌥⌘F'), R('Seleccionar la siguiente coincidencia', 'Ctrl+D'), R('Seleccionar todas las coincidencias', 'Ctrl+F2'),
        R('Añadir cursor arriba / abajo', 'Alt+Mayús+↑ / ↓'), R('Ir a la definición', 'F12'), R('Expandir una plantilla (sel, ins, upd…)', 'Tab')]],
      ['Transacción manual', [R('Confirmar (commit)', 'Alt+Mayús+C'), R('Revertir (rollback)', 'Alt+Mayús+R')]],
      ['Rejilla', [R('Editar la celda', 'F2', '↩'), R('Copiar las celdas seleccionadas', 'Ctrl+C'), R('Pegar como filas nuevas', 'Ctrl+V'),
        R('Duplicar las filas', 'Ctrl+Mayús+D'), R('Marcar las filas para borrar', 'Supr'), R('Guardar los cambios', 'Ctrl+S'),
        R('Buscar en la página', 'Ctrl+F'), R('Filtrar la tabla', 'Ctrl+Mayús+L'), R('Menú contextual', 'Mayús+F10', '⌃↩')]]];
    const pick = this.state.group ?? 'Todos';
    const seg = (label, on, go) => ({ label, checked: on ? 'true' : 'false', tab: on ? '0' : '-1', cls: on ? 'on' : '', go,
      style: `border-top: 0; border-bottom: 0; border-left: 0; ${on ? '' : 'background: transparent;'}` });
    const filters = ['Todos', 'General', 'Pestañas', 'Editor', 'Rejilla'].map((label) => seg(label, label === pick, () => this.setState({ group: label })));
    const plats = [['win', 'Windows / Linux'], ['mac', 'macOS']].map(([id, label]) => seg(label, id === plat, () => this.setState({ plat: id })));
    const groups = G.filter(([t]) => pick === 'Todos' || t === pick || (pick === 'Editor' && /Editor|Transacción/.test(t))).map(([title, rows]) => ({ title, rows }));
    const L = ['General', 'Rejilla'];
    const left = pick === 'Todos' ? groups.filter((g) => L.includes(g.title)) : groups;
    const right = pick === 'Todos' ? groups.filter((g) => !L.includes(g.title)) : [];
    return {
      theme: this.props.theme ?? 'b', os, filters, plats, left, right,
      tabs: [{ label: 'Consulta 1', kind: 'query', href: 'EditorResult.dc.html', dirty: true, color: '#2f7dd6' }, { label: 'clientes', kind: 'table', href: 'DataGrid.dc.html', color: '#2f7dd6' }, { label: 'Atajos de teclado', kind: 'settings', active: true, href: 'ShortcutsHelp.dc.html' }]
    };
  }
}
