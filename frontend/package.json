{
  "name": "quaero-frontend",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "Quaero web UI (rendered in the OS webview)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "media": "playwright test --config=playwright.media.config.ts screenshots.spec.ts",
    "video": "playwright test --config=playwright.media.config.ts video.spec.ts && node e2e/media/build-video.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.3",
    "fflate": "^0.8.3",
    "solid-js": "^1.8.22",
    "sql-formatter": "^15.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.0.2",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^2.1.2"
  }
}
