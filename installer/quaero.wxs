<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer definition for Quaero (issue #40, WiX v4+ schema).
  Built with the WiX CLI + the UI extension; see installer/build-msi.sh.
  Files are staged in build-x86/app/ (the app plus its runtime DLLs and
  drivers). The release is x86 (32-bit): the IBM Informix ODBC driver is
  32-bit only, and Quaero loads drivers in-process, so the whole app is x86.
  Version is passed on the command line: -d Version=<x.y.z>.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Quaero"
           Manufacturer="Daniel Nunez Lopez"
           Version="$(Version)"
           UpgradeCode="A1B2C3D4-1E2F-4A5B-8C6D-0E1F2A3B4C5D"
           Language="1033"
           Scope="perMachine">

    <!-- Schedule is NOT the default here, and the default is what cost the user
         their taskbar pin on every update (issue #404). WiX defaults to
         `afterInstallValidate`, which puts RemoveExistingProducts at sequence
         1401 — the old version is uninstalled ENTIRELY before InstallFiles (4000)
         lays the new one down. In that gap quaero.exe does not exist, and
         Explorer drops pinned items whose target has gone: the pin was never
         broken by a changing path, it was collected as dead.
         `afterInstallExecute` runs the removal after the new files are in place,
         so the executable is never absent; component reference counting keeps it
         from taking away what the new version also owns. Faster too, since
         unchanged files are not deleted and re-copied. -->
    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="Ya hay una version mas reciente de Quaero instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="QuaeroIcon" SourceFile="assets/icons/quaero.ico" />
    <Property Id="ARPPRODUCTICON" Value="QuaeroIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/danielnuld/quaero" />

    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="Quaero">
        <Directory Id="DriversDir" Name="drivers" />
<?ifdef CsdkStage ?>
        <Directory Id="CsdkDir" Name="csdk" />
<?endif?>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuDir" Name="Quaero" />
    </StandardDirectory>

    <!-- App + its runtime DLLs. WebView2 is linked statically (no loader DLL);
         the 32-bit MariaDB Connector/C is linked statically into mysql.dll (so
         no libmariadb.dll here). The MinGW runtime uses the i686 dw2 libgcc. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <File Id="quaero.exe" Source="build-x86/app/quaero.exe" />
      <File Source="build-x86/app/libgcc_s_dw2-1.dll" />
      <File Source="build-x86/app/libstdc++-6.dll" />
      <File Source="build-x86/app/libwinpthread-1.dll" />
    </ComponentGroup>

    <!-- Driver plugins discovered at runtime from <installdir>/drivers.
         postgres.dll links libpq statically (no 32-bit libpq ships; built from
         the PostgreSQL source), so like mysql.dll it needs no separate client. -->
    <ComponentGroup Id="DriverFiles" Directory="DriversDir">
      <File Source="build-x86/app/drivers/sqlite.dll" />
      <File Source="build-x86/app/drivers/mysql.dll" />
      <File Source="build-x86/app/drivers/postgres.dll" />
      <File Source="build-x86/app/drivers/informix.dll" />
      <File Source="build-x86/app/drivers/mongodb.dll" />
    </ComponentGroup>

    <!-- Start Menu shortcut with the app icon. -->
    <Component Id="AppShortcut" Directory="AppMenuDir"
               Guid="B2C3D4E5-2F3A-4B5C-9D6E-1F2A3B4C5D6E">
      <Shortcut Id="StartMenuQuaero" Name="Quaero"
                Target="[INSTALLFOLDER]quaero.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="QuaeroIcon" />
      <RemoveFolder Id="RemoveAppMenuDir" Directory="AppMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Quaero" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

<?ifdef CsdkStage ?>
    <!-- The 32-bit IBM Informix Client SDK, cloned from the build machine by
         installer/build-msi.sh (which defines CsdkStage only when a CSDK is
         installed there; without it this whole block is preprocessed away and
         the MSI is the plain app, which is what CI builds).

         Quaero's Informix driver connects through the ODBC Driver Manager with
         DRIVER={IBM INFORMIX ODBC DRIVER}; if no such driver is registered in
         the 32-bit ODBC hive, connecting fails with IM002. Shipping the client
         here spares every machine in the group a separate IBM install.

         The CSDK is relocatable: it finds its locale (gls/) and message (msg/)
         files through INFORMIXDIR, a registry value, so the tree under
         <installdir>/csdk plus the values below is a complete install. -->
    <ComponentGroup Id="CsdkFiles" Directory="CsdkDir">
      <Files Include="$(CsdkStage)\**" />
    </ComponentGroup>

    <!-- Registered by writing ODBCINST directly rather than with WiX's
         <ODBCDriver>: that one calls into the driver's own setup entry points
         at install time, and these seven values are all the Driver Manager
         reads. CsdkOwned marks the registration as ours (see the feature
         condition below). -->
    <Component Id="CsdkRegistry" Directory="CsdkDir"
               Guid="D8F2BAC5-4E63-4F28-A019-3C7B6D5E9F42">
      <RegistryValue Root="HKLM" Key="SOFTWARE\Quaero" Name="CsdkOwned"
                     Type="integer" Value="1" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Informix\Environment"
                     Name="INFORMIXDIR" Type="string" Value="[CsdkDir]" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\ODBC\ODBCINST.INI\ODBC Drivers"
                     Name="IBM INFORMIX ODBC DRIVER" Type="string" Value="Installed" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\ODBC\ODBCINST.INI\IBM INFORMIX ODBC DRIVER"
                     Name="Driver" Type="string" Value="[CsdkDir]bin\iclit09b.dll" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\ODBC\ODBCINST.INI\IBM INFORMIX ODBC DRIVER"
                     Name="Setup" Type="string" Value="[CsdkDir]bin\iclit09b.dll" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\ODBC\ODBCINST.INI\IBM INFORMIX ODBC DRIVER"
                     Name="APILevel" Type="string" Value="1" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\ODBC\ODBCINST.INI\IBM INFORMIX ODBC DRIVER"
                     Name="ConnectFunctions" Type="string" Value="YYY" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\ODBC\ODBCINST.INI\IBM INFORMIX ODBC DRIVER"
                     Name="DriverODBCVer" Type="string" Value="03.51" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\ODBC\ODBCINST.INI\IBM INFORMIX ODBC DRIVER"
                     Name="FileUsage" Type="string" Value="0" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\ODBC\ODBCINST.INI\IBM INFORMIX ODBC DRIVER"
                     Name="SQLLEVEL" Type="string" Value="1" />
      <!-- setnet32.exe, dbaccess.exe and finderr.exe expect bin/ on PATH. -->
      <Environment Id="CsdkPath" Name="PATH" Value="[CsdkDir]bin"
                   Part="last" Action="set" System="yes" Permanent="no" />
    </Component>

    <!-- Machines where IBM's own installer already put a CSDK keep it: taking
         over ODBCINST there would point every other Informix client at this
         copy, and uninstalling Quaero would then leave them with IM002.
         CsdkOwned distinguishes a registration this package made from a
         foreign one, so upgrading Quaero does not read its own registration as
         "someone else's" and drop the feature (which RemoveExistingProducts
         would then delete). -->
    <Property Id="INFORMIXODBC">
      <RegistrySearch Id="IfxOdbcDriver" Root="HKLM" Bitness="always32"
                      Key="SOFTWARE\ODBC\ODBCINST.INI\IBM INFORMIX ODBC DRIVER"
                      Name="Driver" Type="raw" />
    </Property>
    <Property Id="QUAEROCSDK">
      <RegistrySearch Id="QuaeroOwnsCsdk" Root="HKLM" Bitness="always32"
                      Key="SOFTWARE\Quaero" Name="CsdkOwned" Type="raw" />
    </Property>
<?endif?>

    <Feature Id="Main" Title="Quaero" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="DriverFiles" />
      <ComponentRef Id="AppShortcut" />
    </Feature>
<?ifdef CsdkStage ?>
    <Feature Id="InformixCsdk" Title="IBM Informix Client SDK" Level="1" AllowAbsent="yes">
      <Level Value="0" Condition="INFORMIXODBC AND NOT QUAEROCSDK" />
      <ComponentGroupRef Id="CsdkFiles" />
      <ComponentRef Id="CsdkRegistry" />
    </Feature>
<?endif?>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="installer/license.rtf" />
  </Package>
</Wix>
