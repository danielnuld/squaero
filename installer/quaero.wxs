<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer definition for Squaero (issue #40, WiX v4+ schema).
  Built with the WiX CLI + the UI extension; see installer/build-msi.sh.
  Files are staged in build-<arch>/app/ (the app plus its runtime DLLs and
  drivers). The release is x64 since issue #560; x86 had been forced by IBM's
  32-bit Informix client until #557, and still builds with -arch x86.
  Version is passed on the command line: -d Version=<x.y.z>.
-->
<?define Stage = "build-$(sys.BUILDARCH)/app" ?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Squaero"
           Manufacturer="Daniel Nunez Lopez"
           Version="$(Version)"
           UpgradeCode="A1B2C3D4-1E2F-4A5B-8C6D-0E1F2A3B4C5D"
           Language="1033"
           Scope="perMachine">

    <!-- Schedule is NOT the default here, and the default is what cost the user
         their taskbar pin on every update (issue #404). WiX defaults to
         `afterInstallValidate`, which puts RemoveExistingProducts at sequence
         1401 — the old version is uninstalled ENTIRELY before InstallFiles (4000)
         lays the new one down. In that gap squaero.exe does not exist, and
         Explorer drops pinned items whose target has gone: the pin was never
         broken by a changing path, it was collected as dead.
         `afterInstallExecute` runs the removal after the new files are in place,
         so the executable is never absent; component reference counting keeps it
         from taking away what the new version also owns. Faster too, since
         unchanged files are not deleted and re-copied. -->
    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="Ya hay una version mas reciente de Squaero instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="QuaeroIcon" SourceFile="assets/icons/quaero.ico" />
    <Property Id="ARPPRODUCTICON" Value="QuaeroIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/danielnuld/squaero" />

    <!-- Program Files for x64, Program Files (x86) for x86. Moving from x86
         changes the folder (the MajorUpgrade removes the old product from the
         x86 one), so a taskbar pin to the old path is lost once (issue #560). -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Squaero">
        <Directory Id="DriversDir" Name="drivers" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuDir" Name="Squaero" />
    </StandardDirectory>

    <!-- App + its runtime DLLs. WebView2 is linked statically (no loader DLL);
         MariaDB Connector/C is linked statically into mysql.dll (so no
         libmariadb.dll here). libgcc is SEH on x64, dw2 on i686. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <File Id="squaero.exe" Source="$(Stage)/squaero.exe" />
<?if $(sys.BUILDARCH) = x64 ?>
      <File Source="$(Stage)/libgcc_s_seh-1.dll" />
<?else?>
      <File Source="$(Stage)/libgcc_s_dw2-1.dll" />
<?endif?>
      <File Source="$(Stage)/libstdc++-6.dll" />
      <File Source="$(Stage)/libwinpthread-1.dll" />
    </ComponentGroup>

    <!-- Driver plugins discovered at runtime from <installdir>/drivers.
         postgres.dll links libpq statically (built from the PostgreSQL source), so like mysql.dll it needs no separate client;
         mssql.dll links FreeTDS's db-lib statically the same way. -->
    <ComponentGroup Id="DriverFiles" Directory="DriversDir">
      <File Source="$(Stage)/drivers/sqlite.dll" />
      <File Source="$(Stage)/drivers/mysql.dll" />
      <File Source="$(Stage)/drivers/postgres.dll" />
      <File Source="$(Stage)/drivers/informix.dll" />
      <File Source="$(Stage)/drivers/mongodb.dll" />
      <File Source="$(Stage)/drivers/mssql.dll" />
    </ComponentGroup>

    <!-- Start Menu shortcut with the app icon. -->
    <!-- always32: every earlier release installed this GUID as a 32-bit
         component, and a component must not change bitness under one GUID.
         It holds only a shortcut and an HKCU value, neither redirected. -->
    <Component Id="AppShortcut" Directory="AppMenuDir"
               Guid="B2C3D4E5-2F3A-4B5C-9D6E-1F2A3B4C5D6E" Bitness="always32">
      <Shortcut Id="StartMenuQuaero" Name="Squaero"
                Target="[INSTALLFOLDER]squaero.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="QuaeroIcon" />
      <RemoveFolder Id="RemoveAppMenuDir" Directory="AppMenuDir" On="uninstall" />
      <!-- Registry key keeps the old name (issue #466): it is this component's
           keypath, and renaming a keypath on an upgrade orphans the component. -->
      <RegistryValue Root="HKCU" Key="Software\Quaero" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>


    <Feature Id="Main" Title="Squaero" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="DriverFiles" />
      <ComponentRef Id="AppShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="installer/license.rtf" />
  </Package>
</Wix>
